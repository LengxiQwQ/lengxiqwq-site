+  const userKey = ws.user.userKey;
+  const result = { requestId, userKey };
+  if (expectedUserKey !== userKey || typeof packet.status !== 'string') {
+    replyToStatusRequest(ws, result, 'save_failed');
+    return;
+  }
+
+  const key = JSON.stringify([userKey, requestId]);
+  const existing = statusRequests.get(key);
+  if (existing) {
+    replyToStatusRequest(ws, result, 'saved');
+    existing.then(stage => replyToStatusRequest(ws, result, stage));
+    return;
+  }
+
+  if (packet.resumeOnly === true) {
+    replyToStatusRequest(ws, result, 'sync_unknown');
+    return;
+  }
+
+  console.info('[MatrixStatus] Request received', result);
+  const member = membersStore.find(m => m.userKey === userKey);
+  if (!member) {
+    console.warn('[MatrixStatus] Website save failed', result);
+    replyToStatusRequest(ws, result, 'save_failed');
+    return;
+  }
+  const status = packet.status.trim().slice(0, 16);
+  const previousStatus = member.status;
+  member.status = status;
+  if (!writeJsonAtomic(join(DATA_DIR, 'members.json'), membersStore)) {
+    member.status = previousStatus;
+    console.warn('[MatrixStatus] Website save failed', result);
+    replyToStatusRequest(ws, result, 'save_failed');
+    return;
+  }
+
+  ws.user.status = status;
+  for (const client of clients) {
+    if (client.readyState === WebSocket.OPEN && client.user?.userKey === userKey) {
+      client.user.status = status;
+      client.send(JSON.stringify({ type: 'auth:result', user: client.user }));
+    }
+  }
