+  'm.poll.start', 'org.matrix.msc3381.poll.start'
+]);
+
+function roomActivityRecord(ev, history = false) {
+  if (!ev?.sender || !ev.event_id || !Number.isFinite(ev.origin_server_ts) ||
+      Math.abs(ev.origin_server_ts) > 8.64e15) return null;
+  let actorId = ev.sender;
+  let eventId = ev.event_id;
+  let activity = matrixRoomActivity(ev, matrixActivityName);
+  let mentionKeys = [];
+  const redaction = ev.unsigned?.redacted_because;
+  if (!activity && history && REDACTABLE_TIMELINE_TYPES.has(ev.type) &&
+      redaction?.sender && redaction.event_id &&
+      !messagesStore.interconnect.some((item) =>
+        item.recalledMsgUid === ev.event_id || matchMessageById(item, ev.event_id)
+      )) {
+    actorId = redaction.sender;
+    eventId = redaction.event_id;
+    const actor = matrixActivityName(actorId);
+    if (actorId === ev.sender) {
+      activity = { actor, text: actor + ' 撤回了一条消息' };
+    } else {
+      mentionKeys = [resolveLocalUserKey(ev.sender) || 'matrix:' + ev.sender];
+      activity = { actor, text: actor + ' 撤回了 ' + matrixActivityName(ev.sender) + ' 的一条消息' };
+    }
+  }
+  if (!activity) return null;
+  return {
+    id: ev.origin_server_ts,
+    msgUid: eventId,
+    matrixEventId: eventId,
+    kind: 'system',
+    source: 'matrix',
+    userKey: resolveLocalUserKey(actorId) || 'matrix:' + actorId,
+    name: activity.actor,
+    avatar: '',
+    url: '',
+    badge: '',
+    badgeType: 'tag',
+    isAdmin: false,
+    content: activity.text,
+    attachments: [],
+    mentions: [],
+    mentionKeys,
+    createdAt: ev.origin_server_ts
+  };
+}
+
+function insertMatrixActivity(message) {
+  const records = messagesStore.interconnect;
+  if (records.some((item) => matchMessageById(item, message.msgUid))) return false;
+  const later = records.findIndex((item) => item.createdAt > message.createdAt);
+  if (later < 0) records.push(message);
+  else records.splice(later, 0, message);
+  return true;
+}
+
+function publishMatrixActivity(message) {
+  broadcastToRoom('interconnect', { type: 'chat:message', roomId: 'interconnect', message });
+}
+
+async function fetchMatrixHistoryPage(from, limit, direction = 'b', to = '') {
+  const url = new URL(MATRIX_INTERNAL_URL + '/_matrix/client/v3/rooms/' + encodeURIComponent(MATRIX_ROOM_ID) + '/messages');
+  url.searchParams.set('dir', direction);
+  url.searchParams.set('limit', String(limit));
+  if (from) url.searchParams.set('from', from);
+  if (to) url.searchParams.set('to', to);
+  const res = await fetch(url, {
+    headers: { Authorization: 'Bearer ' + MATRIX_ADMIN_TOKEN },
+    signal: AbortSignal.timeout(8000)
+  });
+  return res.ok ? res.json() : null;
+}
+
+// Recover recent events skipped by older gateways without rewinding live sync.
+async function recoverRecentMatrixActivity() {
+  const visibleFloor = messagesStore.interconnect.at(-80)?.createdAt ?? 0;
+  let from = '';
+  for (let page = 0; page < 3; page++) {
+    const data = await fetchMatrixHistoryPage(from, 100);
+    if (!data) return;
+    for (const ev of (data.chunk || []).slice().reverse()) {
+      const notice = roomActivityRecord(ev, true);
+      if (!notice || !insertMatrixActivity(notice)) continue;
+      saveStoreDebounced();
+      if (notice.createdAt >= visibleFloor) publishMatrixActivity(notice);
+    }
+    if (!data.end || data.end === from) return;
+    from = data.end;
+  }
+}
+
+async function fillMatrixSyncGap(since, to) {
+  const events = [];
+  const visited = new Set();
+  let from = since;
+  while (from && from !== to) {
+    if (visited.has(from)) throw new Error('Matrix history cursor repeated');
+    visited.add(from);
+    const page = await fetchMatrixHistoryPage(from, 100, 'f', to);
+    if (!page || !Array.isArray(page.chunk)) throw new Error('Matrix timeline gap fetch failed');
+    for (const event of page.chunk) events.push(event);
+    from = page.end;
+  }
+  return events;
+}
