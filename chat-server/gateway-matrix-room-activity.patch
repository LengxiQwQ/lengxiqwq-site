+function isMatrixActivityRecord(message) {
+  return message?.kind === 'system' && message.source === 'matrix';
+}
+
+function matrixActivityName(matrixId) {
+  const localKey = resolveLocalUserKey(matrixId);
+  const localName = localKey && membersStore.find((member) => member.userKey === localKey)?.name;
+  return localName || matrixProfileCache.get(matrixId)?.displayname || matrixId;
+}
