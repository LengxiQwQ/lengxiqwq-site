+const externalMemberStatusCache = new Map();
+
+async function readExternalMemberStatus(memberKey) {
+  const userId = memberKey.replace(/^matrix:/, '');
+  // A synthetic relay identity has no independent Matrix profile.
+  if (!/^@[^:#\s]+:[^#\s]+$/.test(userId) || userId.endsWith(':matrix.lengxiqwq.com')) return;
+
+  const now = Date.now();
+  const cached = externalMemberStatusCache.get(userId);
+  if (cached && (cached.pending || cached.expiresAt > now)) return cached.result;
+  if (externalMemberStatusCache.size >= 512) {
+    const expiredKey = [...externalMemberStatusCache].find(([, entry]) => !entry.pending && entry.expiresAt <= now)?.[0];
+    if (!expiredKey) return cached?.result;
+    externalMemberStatusCache.delete(expiredKey);
+  }
+
+  const entry = { pending: true, expiresAt: 0, hadProfileStatus: cached?.hadProfileStatus };
+  entry.result = (async () => {
+    let ttl = 10_000;
+    try {
+      const encodedUser = encodeURIComponent(userId);
+      const url = `${MATRIX_INTERNAL_URL}/_matrix/client/v3/profile/${encodedUser}/${MATRIX_STATUS_PROFILE_KEY}`;
+      const response = await fetch(url, {
+        headers: { Authorization: `Bearer ${MATRIX_ADMIN_TOKEN}` },
+        redirect: 'error',
+        signal: AbortSignal.timeout(2500)
+      });
+      if (response.status === 404) {
+        ttl = 30_000;
+        return entry.hadProfileStatus ? '' : undefined;
+      }
+      if (!response.ok) return;
+      const data = await response.json();
+      const text = data?.[MATRIX_STATUS_PROFILE_KEY]?.text;
+      if (typeof text === 'string' && Buffer.byteLength(text) <= 256) {
+        entry.hadProfileStatus = true;
+        ttl = 30_000;
+        return text.trim();
+      }
+    } catch {
+      // The existing presence message remains available as a fallback.
+    } finally {
+      entry.pending = false;
+      entry.expiresAt = Date.now() + ttl;
+    }
+  })();
+  externalMemberStatusCache.set(userId, entry);
+  return entry.result;
+}
