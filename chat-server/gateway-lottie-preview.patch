+let lottieSpriteTask = null;
+async function ensureLottieSpriteFile() {
+  try {
+    if (existsSync(LOTTIE_SPRITE_FILE) && statSync(LOTTIE_SPRITE_FILE).size > 50000) return LOTTIE_SPRITE_FILE;
+  } catch {}
+  if (!lottieSpriteTask) {
+    lottieSpriteTask = (async () => {
+      const { buffer } = await fetchRemoteBuffer(LOTTIE_SPRITE_URL, 20000);
+      if (!buffer || buffer.length < 50000) throw new Error('Lottie sprite download failed');
+      const tmp = `${LOTTIE_SPRITE_FILE}.${process.pid}.tmp`;
+      writeFileSync(tmp, buffer);
+      renameSync(tmp, LOTTIE_SPRITE_FILE);
+      return LOTTIE_SPRITE_FILE;
+    })().finally(() => { lottieSpriteTask = null; });
+  }
+  return lottieSpriteTask;
+}
+
+const lottiePreviewTasks = new Map();
+async function ensureLottiePreviewFile(name) {
+  const index = LOTTIE_SPRITE_KEYS.indexOf(name);
+  if (index < 0) return '';
+  const target = join(LOTTIE_PREVIEW_DIR, `${name}.webp`);
+  try {
+    if (existsSync(target) && statSync(target).size > 0) return target;
+  } catch {}
+  const running = lottiePreviewTasks.get(name);
+  if (running) return running;
+  const task = (async () => {
+    const spriteFile = await ensureLottieSpriteFile();
+    const col = index % LOTTIE_SPRITE_COLUMNS;
+    const row = Math.floor(index / LOTTIE_SPRITE_COLUMNS);
+    const tmp = `${target}.${process.pid}.tmp.webp`;
+    await execFileAsync(FFMPEG_BIN, [
+      '-v', 'error', '-y',
+      '-i', spriteFile,
+      '-vf', `crop=${LOTTIE_SPRITE_CELL}:${LOTTIE_SPRITE_CELL}:${col * LOTTIE_SPRITE_CELL}:${row * LOTTIE_SPRITE_CELL},scale=${LOTTIE_PREVIEW_SIZE}:${LOTTIE_PREVIEW_SIZE}:flags=lanczos`,
+      '-frames:v', '1',
+      '-c:v', 'libwebp',
+      '-quality', '92',
+      tmp
+    ], { timeout: 15000, windowsHide: true });
+    renameSync(tmp, target);
+    return target;
+  })().finally(() => { lottiePreviewTasks.delete(name); });
+  lottiePreviewTasks.set(name, task);
+  return task;
+}
