diff --git a/src/matrix/chat-mention-protocol.mjs b/src/matrix/chat-mention-protocol.mjs
new file mode 100644
--- /dev/null
+++ b/src/matrix/chat-mention-protocol.mjs
@@ -0,0 +1,309 @@
+import { parseFragment } from "parse5";
+
+const MAX_ENTITIES = 100;
+const SKIPPED_TAGS = new Set(["script", "style", "template", "mx-reply"]);
+const BLOCK_TAGS = new Set([
+	"p",
+	"div",
+	"pre",
+	"li",
+	"blockquote",
+	"tr",
+	"h1",
+	"h2",
+	"h3",
+	"h4",
+	"h5",
+	"h6",
+]);
+const LITERAL_TAGS = new Set(["code", "pre", "blockquote"]);
+const WRAPPERS = new Map([
+	["b", "**"],
+	["strong", "**"],
+	["em", "*"],
+	["i", "*"],
+	["s", "~~"],
+	["del", "~~"],
+	["code", "`"],
+	["pre", "```\n"],
+]);
+
+function splitsSurrogate(content, index) {
+	const before = content.charCodeAt(index - 1);
+	const after = content.charCodeAt(index);
+	return (
+		before >= 0xd800 && before <= 0xdbff && after >= 0xdc00 && after <= 0xdfff
+	);
+}
+
+export function validateMentions(
+	content,
+	input,
+	allowedKeys,
+	isAdmin,
+	trimOffset = 0,
+) {
+	if (!Array.isArray(input) || !input.length) return [];
+	const literals = Array.from(
+		content.matchAll(
+			/(```[\s\S]*?```|~~~[\s\S]*?~~~|`[^`\n]+`|https?:\/\/[^\s<>()]+)/g,
+		),
+	);
+	const entities = [];
+	let end = 0;
+	const ranges = input
+		.slice(0, MAX_ENTITIES)
+		.filter(
+			(item) =>
+				item &&
+				Number.isSafeInteger(item.offset) &&
+				Number.isSafeInteger(item.length),
+		)
+		.sort((a, b) => a.offset - b.offset);
+	for (const { offset: start, length, userKey } of ranges) {
+		const offset = start - trimOffset;
+		const nextEnd = offset + length;
+		if (offset < end || length < 2 || nextEnd > content.length) continue;
+		if (splitsSurrogate(content, offset) || splitsSurrogate(content, nextEnd))
+			continue;
+		const label = content.slice(offset, nextEnd);
+		if (!label.startsWith("@") || /[\r\n]/.test(label)) continue;
+		if (
+			literals.some(
+				(span) => offset < span.index + span[0].length && nextEnd > span.index,
+			)
+		)
+			continue;
+		if (userKey === "room" ? !isAdmin : !allowedKeys.has(userKey)) continue;
+		entities.push({ offset, length, userKey });
+		end = nextEnd;
+	}
+	return entities;
+}
+
+export function isMatrixUserId(value) {
+	if (typeof value !== "string" || !value.startsWith("@") || value.length > 255)
+		return false;
+	const sep = value.indexOf(":");
+	if (sep < 2 || /[^\x21-\x7e]/.test(value)) return false;
+	const server = value.slice(sep + 1);
+	if (!server || /[\s/@?#\\%]/.test(server)) return false;
+	try {
+		return Boolean(new URL("https://" + server).hostname);
+	} catch {
+		return false;
+	}
+}
+
+export function matrixUserIdFromLink(href) {
+	try {
+		const url = new URL(href);
+		let id = "";
+		if (url.protocol === "matrix:" && /^(?:u|userid)\//.test(url.pathname)) {
+			id =
+				"@" +
+				decodeURIComponent(url.pathname.slice(url.pathname.indexOf("/") + 1));
+		} else if (
+			url.origin === "https://matrix.to" &&
+			url.pathname === "/" &&
+			url.hash.startsWith("#/")
+		) {
+			id = decodeURIComponent(url.hash.slice(2).split("?")[0]);
+		}
+		return isMatrixUserId(id) ? id : null;
+	} catch {
+		return null;
+	}
+}
+
+function attr(node, name) {
+	return node.attrs.find((item) => item.name === name)?.value ?? "";
+}
+
+function linkLabel(node) {
+	if (SKIPPED_TAGS.has(node.tagName)) return "";
+	if (node.nodeName === "#text") return node.value;
+	if (node.tagName === "br") return "\n";
+	if (node.tagName === "img") return attr(node, "alt");
+	return (node.childNodes ?? []).map(linkLabel).join("");
+}
+
+function markdownLink(label, url, image = false) {
+	const text = label.replace(/[\\[\]]/g, "\\$&");
+	const href = url
+		.replaceAll("<", "%3C")
+		.replaceAll(">", "%3E")
+		.replace(/\s/g, "%20");
+	return (image ? "!" : "") + "[" + text + "](<" + href + ">)";
+}
+
+function escapeMatrixText(text) {
+	return text.replace(/[\\`*_~[\]<>]/g, "\\$&");
+}
+
+export function readMatrixMentionLayout(
+	body,
+	formatted,
+	resolveUserKey,
+	inlineImages,
+	relayHeader,
+) {
+	let content = "";
+	const mentionEntities = [];
+	const inlineClosers = new Map();
+	if (!formatted || formatted.length > 256_000)
+		return { content: body, mentionEntities };
+
+	function lineBreak() {
+		if (content && !content.endsWith("\n")) content += "\n";
+	}
+
+	function visit(node, inLiteral = false) {
+		const tag = node.tagName;
+		if (SKIPPED_TAGS.has(tag)) return;
+		if (node.nodeName === "#text") {
+			content += inLiteral ? node.value : escapeMatrixText(node.value);
+			return;
+		}
+		if (tag === "br") {
+			content += "\n";
+			return;
+		}
+		if (tag === "img") {
+			const alt = attr(node, "alt");
+			const url = inlineImages.get(attr(node, "src"));
+			content += url ? markdownLink(alt, url, true) : alt;
+			return;
+		}
+		const literal = inLiteral || LITERAL_TAGS.has(tag);
+		if (BLOCK_TAGS.has(tag)) lineBreak();
+		if (tag === "a" && !literal) {
+			const href = attr(node, "href");
+			const id = matrixUserIdFromLink(href);
+			const label = linkLabel(node);
+			if (
+				id &&
+				label.trim() &&
+				!label.includes("\n") &&
+				mentionEntities.length < MAX_ENTITIES
+			) {
+				mentionEntities.push({
+					offset: content.length,
+					length: label.length,
+					userKey: resolveUserKey(id),
+				});
+				content += label;
+				return;
+			}
+			if (/^https?:\/\//i.test(href)) {
+				content += markdownLink(label, href);
+				return;
+			}
+		}
+		const wrapper = inLiteral ? "" : WRAPPERS.get(tag);
+		if (wrapper) content += wrapper;
+		for (const child of node.childNodes ?? []) visit(child, literal);
+		if (wrapper) {
+			if (!literal) inlineClosers.set(content.length, wrapper.length);
+			content += tag === "pre" ? "\n```" : wrapper;
+		}
+		if (BLOCK_TAGS.has(tag)) lineBreak();
+	}
+
+	const nodes = parseFragment(formatted).childNodes.filter(
+		(node) => node.tagName !== "mx-reply",
+	);
+	if (relayHeader && nodes[0]) {
+		const firstLine = linkLabel(nodes[0]).trimEnd();
+		const shortHeader = relayHeader.split(";[URL:")[0];
+		if (
+			firstLine === relayHeader ||
+			(nodes[0].tagName === "div" && firstLine === shortHeader)
+		) {
+			nodes.shift();
+			if (nodes[0]?.tagName === "br") nodes.shift();
+		}
+	}
+	for (const node of nodes) visit(node);
+	return {
+		content: mentionEntities.length ? content : body,
+		mentionEntities,
+		inlineClosers,
+	};
+}
+
+const SITE_DIVIDER = /^[^\S\r\n]*[·•・][^\S\r\n]*/u;
+
+export function completeMentionLabels(
+	{ content, mentionEntities, inlineClosers },
+	targetKeys,
+	siteForKey,
+) {
+	if (!mentionEntities.length) return { content, mentionEntities };
+	let body = "";
+	let cursor = 0;
+	const entities = [];
+	for (const [index, entity] of mentionEntities.entries()) {
+		let start = entity.offset;
+		let end = start + entity.length;
+		if (start > cursor && content[start] !== "@" && content[start - 1] === "@")
+			start--;
+		let label = content.slice(start, end);
+		const explicit = label.startsWith("@") || targetKeys.has(entity.userKey);
+		const site = siteForKey(entity.userKey);
+		const next = mentionEntities[index + 1]?.offset ?? content.length;
+		let suffixStart = end;
+		while (inlineClosers?.has(suffixStart))
+			suffixStart += inlineClosers.get(suffixStart);
+		const following = content.slice(suffixStart, next);
+		const divider = SITE_DIVIDER.exec(following)?.[0];
+		const alreadyQualified =
+			site &&
+			label.endsWith(site) &&
+			/[·•・]$/u.test(label.slice(0, -site.length).trimEnd());
+
+		// The account is already resolved. The comparison only decides where its
+		// display label ends, with the next occurrence as a hard upper bound.
+		const matchedSite =
+			site && !alreadyQualified && divider
+				? [site, escapeMatrixText(site)].find((value) =>
+						following.startsWith(value, divider.length),
+					)
+				: undefined;
+		let closingMarkup = "";
+		if (matchedSite) {
+			label += divider + site;
+			closingMarkup = content.slice(end, suffixStart);
+			end = suffixStart + divider.length + matchedSite.length;
+		} else if (explicit && site && !divider && !/[·•・]/u.test(label)) {
+			label += " · " + site;
+		}
+		if ((explicit || matchedSite) && !label.startsWith("@"))
+			label = "@" + label;
+
+		body += content.slice(cursor, start);
+		entities.push({
+			offset: body.length,
+			length: label.length,
+			userKey: entity.userKey,
+		});
+		body += label + closingMarkup;
+		cursor = end;
+	}
+	return { content: body + content.slice(cursor), mentionEntities: entities };
+}
+
+export function readMatrixMentionUserIds(mentions) {
+	if (!Array.isArray(mentions?.user_ids)) return [];
+	return [...new Set(mentions.user_ids.filter(isMatrixUserId))].slice(
+		0,
+		MAX_ENTITIES,
+	);
+}
+
+export function matrixMentions(ids, room) {
+	return {
+		...(ids.length ? { user_ids: ids } : {}),
+		...(room ? { room: true } : {}),
+	};
+}
