---
import { Icon } from "astro-icon/components";
import type { DeviceItem } from "@/types/devicesConfig";

interface Props extends DeviceItem {}

const {
	name,
	alias,
	description,
	image,
	icon = "material-symbols:devices-rounded",
	tags = [],
} = Astro.props;
---

<div class="device-card card-base flex flex-row items-center gap-4 p-4 rounded-(--radius-large) relative group transition-all duration-300 hover:shadow-lg">
	<!-- 左侧小图标/图片框 -->
	<div class="w-16 h-16 md:w-20 md:h-20 shrink-0 rounded-2xl bg-neutral-100 dark:bg-neutral-800/80 flex items-center justify-center overflow-hidden transition-colors">
		{image ? (
			<img
				src={image}
				alt={name}
				class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
				loading="lazy"
				decoding="async"
			/>
		) : (
			<Icon
				name={icon}
				class="text-neutral-400 dark:text-neutral-500 text-3xl md:text-4xl transition-transform duration-300 group-hover:scale-110"
			/>
		)}
	</div>

	<!-- 右侧内容区域 -->
	<div class="flex flex-col flex-1 min-w-0">
		<div class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
			<h4 class="font-bold text-base md:text-lg leading-snug text-black/90 dark:text-white/90" title={name}>
				{name}
			</h4>
			{alias && (
				<span class="text-xs text-neutral-500 dark:text-neutral-400 font-medium" title={alias}>
					({alias})
				</span>
			)}
		</div>

		{description && (
			<p class="text-xs md:text-sm text-neutral-600 dark:text-neutral-400 line-clamp-2 leading-relaxed mt-1" title={description}>
				{description}
			</p>
		)}

		{tags && tags.length > 0 && (
			<div class="mt-2.5 flex flex-wrap items-center gap-1.5">
				{tags.slice(0, 3).map((tag) => (
					<span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400 border border-black/5 dark:border-white/5">
						{tag}
					</span>
				))}
			</div>
		)}
	</div>
</div>
