---
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config";
import type { DeviceItem } from "@/types/devicesConfig";
import { getLqipProps } from "@/utils/lqip-utils";
import { url } from "@/utils/url-utils";

interface Props extends DeviceItem {}

const {
	name,
	brand,
	alias,
	description,
	image,
	icon = "material-symbols:devices-rounded",
	tags = [],
	url: linkUrl,
	status,
	imageFit = "cover",
} = Astro.props;

// 解析图片地址（支持本地 public 与远程绝对 URL）
const resolvedImage = image
	? image.startsWith("/")
		? url(image)
		: image
	: undefined;

// LQIP 渐变平滑占位
const lqipProps = resolvedImage
	? getLqipProps(image as string, undefined, true)
	: { style: "" };

// 跟随主题全局封面贴边设置（默认为内嵌圆角框）
const gridCoverFullWidth =
	siteConfig.postListLayout.grid.coverFullWidth ?? false;

const coverClass = gridCoverFullWidth
	? "device-card-image group/cover relative block aspect-4/3 w-full overflow-hidden bg-neutral-100 dark:bg-neutral-800"
	: "device-card-image group/cover relative block aspect-4/3 overflow-hidden mx-3.5 mt-3.5 rounded-xl bg-neutral-100 dark:bg-neutral-800";
---

<div class="device-card card-base flex flex-col w-full rounded-(--radius-large) overflow-hidden relative group transition-all duration-300 hover:shadow-lg">
	<!-- 顶部封面区域（4:3 比例） -->
	{resolvedImage ? (
		<a
			href={resolvedImage}
			data-fancybox="devices"
			data-caption={`${name}${alias ? ` (${alias})` : ""}${brand ? ` · ${brand}` : ""}`}
			class={`${coverClass} cursor-zoom-in`}
			aria-label={`查看 ${name} 高清大图`}
		>
			<div
				class="lqip-placeholder absolute inset-0 pointer-events-none"
				style={lqipProps.style}
				aria-hidden="true"
			/>
			<img
				src={resolvedImage}
				alt={name}
				class:list={[
					"w-full h-full opacity-0 pointer-events-none transition-transform duration-500 ease-out group-hover:scale-105",
					imageFit === "contain"
						? "object-contain p-4 bg-neutral-100/70 dark:bg-neutral-800/70"
						: "object-cover",
				]}
				loading="lazy"
				decoding="async"
			/>
			<!-- 悬浮变暗与放大图标 -->
			<div class="absolute inset-0 pointer-events-none z-10 transition-colors duration-300 group-hover:bg-black/20" />
			<div class="absolute inset-0 pointer-events-none z-20 flex items-center justify-center">
				<Icon
					name="material-symbols:zoom-in-rounded"
					class="transition-all duration-300 opacity-0 scale-50 group-hover:opacity-100 group-hover:scale-100 text-white text-4xl drop-shadow-md"
				/>
			</div>

			<!-- 品牌角标（左上角） -->
			{brand && (
				<span class="absolute top-2.5 left-2.5 z-30 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium text-white bg-black/50 backdrop-blur-md border border-white/10 shadow-xs">
					{brand}
				</span>
			)}

			<!-- 状态角标（右上角） -->
			{status && (
				<span class="absolute top-2.5 right-2.5 z-30 inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold text-(--primary) bg-(--card-bg)/90 backdrop-blur-md border border-(--primary)/20 shadow-xs">
					<span class="w-1.5 h-1.5 rounded-full bg-(--primary) animate-pulse" />
					{status}
				</span>
			)}
		</a>
	) : (
		<div class={`${coverClass} flex items-center justify-center bg-linear-to-br from-neutral-100 to-neutral-200/80 dark:from-neutral-800/80 dark:to-neutral-900`}>
			<Icon
				name={icon}
				class="text-neutral-400/80 dark:text-neutral-500/80 text-6xl transition-transform duration-300 group-hover:scale-110 group-hover:text-(--primary)"
			/>

			<!-- 品牌角标（左上角） -->
			{brand && (
				<span class="absolute top-2.5 left-2.5 z-30 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium text-neutral-700 dark:text-neutral-300 bg-black/5 dark:bg-white/10 backdrop-blur-md border border-black/5 dark:border-white/10 shadow-xs">
					{brand}
				</span>
			)}

			<!-- 状态角标（右上角） -->
			{status && (
				<span class="absolute top-2.5 right-2.5 z-30 inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold text-(--primary) bg-(--card-bg)/90 backdrop-blur-md border border-(--primary)/20 shadow-xs">
					<span class="w-1.5 h-1.5 rounded-full bg-(--primary) animate-pulse" />
					{status}
				</span>
			)}
		</div>
	)}

	<!-- 下方内容区域 -->
	<div class="flex flex-col flex-1 p-4 md:p-5 min-h-0">
		<!-- 标题与别名 -->
		<div class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
			<h4
				class="font-bold text-base md:text-lg leading-snug text-90 group-hover:text-(--primary) transition-colors"
				title={name}
			>
				{name}
			</h4>
			{alias && (
				<span
					class="text-xs text-neutral-500 dark:text-neutral-400 font-medium"
					title={alias}
				>
					({alias})
				</span>
			)}
		</div>

		<!-- 规格参数标签 -->
		{tags && tags.length > 0 && (
			<div class="mt-2.5 flex flex-wrap items-center gap-1.5">
				{tags.map((tag) => (
					<span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-300 border border-black/5 dark:border-white/5 transition-colors">
						{tag}
					</span>
				))}
			</div>
		)}

		<!-- 使用心得评价描述 -->
		{description && (
			<p
				class="text-xs md:text-sm text-neutral-600 dark:text-neutral-400 line-clamp-3 md:line-clamp-4 leading-relaxed mt-2.5"
				title={description}
			>
				{description}
			</p>
		)}

		<!-- 底部外链（若有） -->
		{linkUrl && (
			<div class="mt-auto pt-3 flex items-center justify-end">
				<a
					href={linkUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-1 text-xs font-medium text-neutral-500 dark:text-neutral-400 hover:text-(--primary) transition-colors group/link"
				>
					<span>了解更多</span>
					<Icon
						name="material-symbols:arrow-outward-rounded"
						class="text-sm transition-transform duration-200 group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5"
					/>
				</a>
			</div>
		)}
	</div>
</div>
