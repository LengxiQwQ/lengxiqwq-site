---
import { Icon } from "astro-icon/components";
import type {
	ChangelogChangeType,
	ChangelogDailyEntry,
} from "@/types/changelogConfig";

interface Props {
	entry: ChangelogDailyEntry;
	isFirst?: boolean;
	isLast?: boolean;
}

const { entry, isFirst = false, isLast = false } = Astro.props;

// 类型徽章配置字典
const typeBadgeMap: Record<
	ChangelogChangeType,
	{ label: string; icon: string; classes: string }
> = {
	feat: {
		label: "新增",
		icon: "material-symbols:add-circle-outline-rounded",
		classes:
			"bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 border-emerald-500/25",
	},
	fix: {
		label: "修复",
		icon: "material-symbols:build-circle-outline-rounded",
		classes:
			"bg-rose-500/15 text-rose-600 dark:text-rose-400 border-rose-500/25",
	},
	perf: {
		label: "优化",
		icon: "material-symbols:speed-outline-rounded",
		classes:
			"bg-amber-500/15 text-amber-600 dark:text-amber-400 border-amber-500/25",
	},
	style: {
		label: "界面",
		icon: "material-symbols:palette-outline-rounded",
		classes: "bg-sky-500/15 text-sky-600 dark:text-sky-400 border-sky-500/25",
	},
	refactor: {
		label: "重构",
		icon: "material-symbols:tune-rounded",
		classes:
			"bg-purple-500/15 text-purple-600 dark:text-purple-400 border-purple-500/25",
	},
	chore: {
		label: "工程",
		icon: "material-symbols:settings-outline-rounded",
		classes:
			"bg-indigo-500/15 text-indigo-600 dark:text-indigo-400 border-indigo-500/25",
	},
	docs: {
		label: "文档",
		icon: "material-symbols:description-outline-rounded",
		classes:
			"bg-teal-500/15 text-teal-600 dark:text-teal-400 border-teal-500/25",
	},
};

// 节点轨道图标选择
const markerIcon = entry.featured
	? "material-symbols:auto-awesome-rounded"
	: "material-symbols:calendar-today-rounded";
---

<article
	class:list={[
		"changelog-daily-card group flex gap-3 sm:gap-5 items-stretch min-w-0",
		entry.featured && "changelog-daily-card--featured",
		isFirst && "changelog-daily-card--first",
		isLast && "changelog-daily-card--last",
	]}
>
	<!-- 左侧垂直轨道与圆球节点 -->
	<div class="relative flex flex-col items-center shrink-0 w-8 sm:w-11" aria-hidden="true">
		<!-- 轨道连接线：精确裁剪起止点，防止两端突出溢出 -->
		{!(isFirst && isLast) && (
			<div
				class:list={[
					"absolute left-1/2 -translate-x-1/2 w-0.5 bg-(--line-divider) transition-colors duration-300",
					isFirst
						? "top-5 sm:top-[26px] bottom-0"
						: isLast
							? "top-0 h-5 sm:h-[26px]"
							: "top-0 bottom-0",
				]}
			></div>
		)}

		<!-- 节点圆形标记：强制实心背景覆盖，彻底杜绝轨道线透过 -->
		<div
			class:list={[
				"relative z-10 flex items-center justify-center w-8 h-8 sm:w-11 sm:h-11 rounded-full border-2 bg-(--card-bg) transition-all duration-300 mt-1 overflow-hidden shrink-0",
				entry.featured
					? "border-amber-500/60 text-amber-500 group-hover:scale-110"
					: "border-(--line-divider) text-neutral-500 dark:text-neutral-400 group-hover:border-(--primary) group-hover:text-(--primary) group-hover:scale-105",
			]}
		>
			<!-- 里程碑节点的内部实体微光层，保持底色不透明的同时呈现柔和质感 -->
			{entry.featured && (
				<div class="absolute inset-0 bg-amber-500/15 pointer-events-none"></div>
			)}
			<Icon name={markerIcon} class="relative z-1 text-sm sm:text-lg" />
		</div>
	</div>

	<!-- 右侧单日大卡片主体：严格遵循系统 .card-base 规范，不自作主张硬编码阴影 -->
	<div
		class:list={[
			"card-base flex-1 flex flex-col min-w-0 mb-6 p-4.5 sm:p-6 transition-all duration-300",
			entry.featured
				? "border-amber-500/40 hover:border-amber-500/60"
				: "hover:border-(--primary)/40",
		]}
	>
		<!-- 头部元数据：具体日期、当天提交次数、重点里程碑 -->
		<div class="flex flex-wrap items-center justify-between gap-2.5 pb-3 border-b border-(--line-divider)/60">
			<div class="flex flex-wrap items-center gap-2">
				<!-- 精确日期 -->
				<time
					datetime={entry.date}
					class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs sm:text-sm font-bold tabular-nums bg-(--btn-regular-bg) text-neutral-800 dark:text-neutral-200"
				>
					<Icon name="material-symbols:edit-calendar-rounded" class="text-sm text-(--primary)" />
					<span>{entry.date}</span>
				</time>

				<!-- 里程碑徽标（可选） -->
				{entry.featured && (
					<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md text-xs font-semibold bg-amber-500/15 text-amber-600 dark:text-amber-400 border border-amber-500/25">
						<Icon name="material-symbols:auto-awesome-rounded" class="text-xs" />
						<span>里程碑</span>
					</span>
				)}
			</div>

			<!-- 当天总提交次数徽章 -->
			{typeof entry.commitsCount === "number" && (
				<div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-(--primary)/10 text-(--primary) border border-(--primary)/20">
					<Icon name="material-symbols:commit-rounded" class="text-sm" />
					<span>共 {entry.commitsCount} 次提交</span>
				</div>
			)}
		</div>

		<!-- 当天主题概览（可选） -->
		{entry.title && (
			<h3 class="text-base sm:text-lg font-bold text-neutral-900 dark:text-neutral-100 mt-3 mb-1 break-words">
				{entry.title}
			</h3>
		)}

		<!-- 当天细分功能变更项列表 -->
		<div class="mt-3.5 space-y-3.5">
			{entry.items.map((item) => {
				const badge = item.type ? typeBadgeMap[item.type] : undefined;
				return (
					<div class="flex flex-col gap-1 p-3 rounded-xl bg-black/1.5 dark:bg-white/2 border border-(--line-divider)/40 hover:border-(--line-divider) transition-colors">
						<div class="flex flex-wrap items-center gap-2">
							{badge && (
								<span
									class:list={[
										"inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[11px] font-semibold border",
										badge.classes,
									]}
								>
									<Icon name={badge.icon} class="text-xs" />
									<span>{badge.label}</span>
								</span>
							)}
							<h4 class="text-sm font-semibold text-neutral-800 dark:text-neutral-200 break-words flex-1 min-w-0">
								{item.title}
							</h4>
							{item.link && (
								<a
									href={item.link.url}
									target="_blank"
									rel="noopener noreferrer"
									class="inline-flex items-center gap-1 text-xs text-(--primary) hover:underline shrink-0"
								>
									<span>{item.link.label || "查看关联"}</span>
									<Icon name="material-symbols:arrow-outward-rounded" class="text-xs" />
								</a>
							)}
						</div>

						{item.description && (
							<p class="text-xs sm:text-sm text-(--content-meta) leading-relaxed mt-0.5 pl-0.5">
								{item.description}
							</p>
						)}

						{item.details && item.details.length > 0 && (
							<ul class="mt-1.5 space-y-1 pl-4 list-disc marker:text-(--primary)/60 text-xs text-neutral-600 dark:text-neutral-400">
								{item.details.map((detail) => (
									<li class="leading-relaxed">{detail}</li>
								))}
							</ul>
						)}
					</div>
				);
			})}
		</div>
	</div>
</article>
