---
import { Icon } from "astro-icon/components";
import type { FcircleStats } from "@/utils/fcircle-utils";

interface Props {
	stats: FcircleStats;
}

const { stats } = Astro.props;
---

<div class="grid grid-cols-2 sm:grid-cols-4 gap-3 my-4">
	<!-- 今日更新 -->
	<div
		class:list={[
			"p-3 rounded-xl border flex items-center gap-3 transition-all duration-300 relative overflow-hidden group bg-(--card-bg)",
			stats.todayCount > 0
				? "border-(--primary)/30 bg-(--primary)/5 md:hover:border-(--primary)"
				: "border-(--line-divider) md:hover:border-(--primary)/40",
		]}
	>
		<div
			class:list={[
				"w-9 h-9 rounded-lg flex items-center justify-center shrink-0 transition-transform duration-300 group-md:hover:scale-105",
				stats.todayCount > 0
					? "bg-(--primary) text-white shadow-xs"
					: "bg-(--primary)/10 text-(--primary)",
			]}
			aria-hidden="true"
		>
			<Icon name="mingcute:flash-line" class="text-lg" />
		</div>
		<div class="flex flex-col min-w-0">
			<span class="text-xs text-neutral-500 dark:text-neutral-400 font-medium">今日更新</span>
			<div class="flex items-baseline gap-1 mt-0.5">
				<span
					class:list={[
						"text-lg font-bold tabular-nums leading-tight",
						stats.todayCount > 0
							? "text-(--primary)"
							: "text-neutral-800 dark:text-neutral-200",
					]}
				>
					{stats.todayCount}
				</span>
				<span class="text-xs text-neutral-400">篇</span>
			</div>
		</div>
	</div>

	<!-- 近 7 天更新 -->
	<div
		class="p-3 rounded-xl border border-(--line-divider) flex items-center gap-3 transition-all duration-300 relative overflow-hidden group bg-(--card-bg) md:hover:border-(--primary)/40"
	>
		<div
			class="w-9 h-9 rounded-lg flex items-center justify-center shrink-0 bg-(--primary)/10 text-(--primary) transition-transform duration-300 group-md:hover:scale-105"
			aria-hidden="true"
		>
			<Icon name="mingcute:calendar-line" class="text-lg" />
		</div>
		<div class="flex flex-col min-w-0">
			<span class="text-xs text-neutral-500 dark:text-neutral-400 font-medium">近 7 天</span>
			<div class="flex items-baseline gap-1 mt-0.5">
				<span class="text-lg font-bold tabular-nums leading-tight text-neutral-800 dark:text-neutral-200">
					{stats.weekCount}
				</span>
				<span class="text-xs text-neutral-400">篇</span>
			</div>
		</div>
	</div>

	<!-- 收录动态 -->
	<div
		class="p-3 rounded-xl border border-(--line-divider) flex items-center gap-3 transition-all duration-300 relative overflow-hidden group bg-(--card-bg) md:hover:border-(--primary)/40"
	>
		<div
			class="w-9 h-9 rounded-lg flex items-center justify-center shrink-0 bg-(--primary)/10 text-(--primary) transition-transform duration-300 group-md:hover:scale-105"
			aria-hidden="true"
		>
			<Icon name="mingcute:document-2-line" class="text-lg" />
		</div>
		<div class="flex flex-col min-w-0">
			<span class="text-xs text-neutral-500 dark:text-neutral-400 font-medium">收录动态</span>
			<div class="flex items-baseline gap-1 mt-0.5">
				<span class="text-lg font-bold tabular-nums leading-tight text-neutral-800 dark:text-neutral-200">
					{stats.totalCount}
				</span>
				<span class="text-xs text-neutral-400">篇</span>
			</div>
		</div>
	</div>

	<!-- 订阅/友链站点 -->
	<div
		class="p-3 rounded-xl border border-(--line-divider) flex items-center gap-3 transition-all duration-300 relative overflow-hidden group bg-(--card-bg) md:hover:border-(--primary)/40"
	>
		<div
			class="w-9 h-9 rounded-lg flex items-center justify-center shrink-0 bg-(--primary)/10 text-(--primary) transition-transform duration-300 group-md:hover:scale-105"
			aria-hidden="true"
		>
			<Icon name="mingcute:earth-2-line" class="text-lg" />
		</div>
		<div class="flex flex-col min-w-0">
			<span class="text-xs text-neutral-500 dark:text-neutral-400 font-medium">聚合站点</span>
			<div class="flex items-baseline gap-1 mt-0.5">
				<span class="text-lg font-bold tabular-nums leading-tight text-neutral-800 dark:text-neutral-200">
					{stats.siteCount}
				</span>
				<span class="text-xs text-neutral-400">个</span>
			</div>
		</div>
	</div>
</div>
