---
interface Props {
	websiteId: string;
	scriptUrl?: string;
	replaysScriptUrl?: string;
	trackOutboundLinks?: boolean;
	collectWebVitals?: boolean;
	replays?: {
		enabled?: boolean;
		sampleRate?: number;
		maskLevel?: "moderate" | "strict";
		maxDuration?: number;
		blockSelector?: string;
	};
}

const {
	websiteId,
	scriptUrl,
	replaysScriptUrl,
	trackOutboundLinks = true,
	collectWebVitals = false,
	replays,
} = Astro.props;

const replaysEnabled = replays?.enabled ?? false;
const replaysSampleRate = replays?.sampleRate ?? 0.15;
const replaysMaskLevel = replays?.maskLevel ?? "moderate";
const replaysMaxDuration = replays?.maxDuration ?? 300000;
const replaysBlockSelector = replays?.blockSelector?.trim();
---

<script
	is:inline
	data-swup-ignore-script
	define:vars={{
		websiteId,
		scriptUrl,
		replaysScriptUrl,
		collectWebVitals,
		replaysEnabled,
		replaysSampleRate,
		replaysMaskLevel,
		replaysMaxDuration,
		replaysBlockSelector,
	}}
>
	;(() => {
		if (!websiteId || !scriptUrl || window.__umamiScriptsScheduled) return;
		window.__umamiScriptsScheduled = true;

		let injected = false;
		const injectUmamiScripts = () => {
			if (injected) return;
			injected = true;

			// 异步非阻塞加载 Umami 主脚本，避免弱网/跨境超时时卡死 DOMContentLoaded、ES Module 队列与页面加载条
			const mainScript = document.createElement("script");
			mainScript.async = true;
			mainScript.src = scriptUrl;
			mainScript.setAttribute("data-website-id", websiteId);
			mainScript.setAttribute("data-swup-ignore-script", "");
			if (collectWebVitals) {
				mainScript.setAttribute("data-performance", "true");
			}
			document.head.appendChild(mainScript);

			if (replaysEnabled && replaysScriptUrl) {
				const replayScript = document.createElement("script");
				replayScript.async = true;
				replayScript.src = replaysScriptUrl;
				replayScript.setAttribute("data-website-id", websiteId);
				replayScript.setAttribute("data-sample-rate", String(replaysSampleRate));
				replayScript.setAttribute("data-mask-level", replaysMaskLevel);
				replayScript.setAttribute("data-max-duration", String(replaysMaxDuration));
				replayScript.setAttribute("data-swup-ignore-script", "");
				if (replaysBlockSelector) {
					replayScript.setAttribute("data-block-selector", replaysBlockSelector);
				}
				document.head.appendChild(replayScript);
			}
		};

		// 在页面 load 完成后立即异步注入（不拉长浏览器加载条）；同时设 2.5s 兜底防止慢图耽误统计上报
		if (document.readyState === "complete") {
			injectUmamiScripts();
		} else {
			window.addEventListener("load", injectUmamiScripts, { once: true });
			window.setTimeout(injectUmamiScripts, 2500);
		}
	})();
</script>

{
	trackOutboundLinks && (
		<script is:inline data-swup-ignore-script>
			;(() => {
				if (window.__umamiOutboundTrackingInitialized) return;
				window.__umamiOutboundTrackingInitialized = true;

				const name = "outbound-link-click";

				const applyOutboundTracking = () => {
					document.querySelectorAll("a").forEach((a) => {
						if (
							(a.protocol === "http:" || a.protocol === "https:") &&
							a.host !== window.location.host &&
							!a.getAttribute("data-umami-event")
						) {
							a.setAttribute("data-umami-event", name);
							a.setAttribute("data-umami-event-url", a.href);
						}
					});
				};

				if (document.readyState === "loading") {
					document.addEventListener("DOMContentLoaded", applyOutboundTracking, {
						once: true,
					});
				} else {
					applyOutboundTracking();
				}

				function setupSwupTracking() {
					let registered = false;

					function register() {
						if (registered || !window.swup?.hooks) return;
						registered = true;
						window.swup.hooks.on("content:replace", applyOutboundTracking);
					}

					if (window.swup?.hooks) {
						register();
					} else {
						document.addEventListener("swup:enable", register, {
							once: true,
						});
					}
				}

				setupSwupTracking();
				document.addEventListener("astro:page-load", applyOutboundTracking);
			})();
		</script>
	)
}
