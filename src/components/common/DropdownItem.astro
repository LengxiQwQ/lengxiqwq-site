---
/**
 * 公共下拉面板选项组件
 * 用于下拉面板中的选项项
 */
interface Props {
	href?: string;
	target?: string;
	isActive?: boolean;
	isLast?: boolean;
	disabled?: boolean;
	class?: string;
	onclick?: string;
	[key: string]: unknown;
}

const {
	href,
	target,
	isActive = false,
	isLast = false,
	disabled = false,
	class: className,
	onclick,
	...rest
} = Astro.props;

const baseClasses =
	"flex transition whitespace-nowrap items-center justify-start! w-full rounded-lg h-9 px-3 font-medium";
const interactiveClasses = disabled
	? "btn-disabled"
	: "btn-plain scale-animation active:scale-95";
const spacingClass = isLast ? "" : "mb-0.5";
const activeClass = isActive ? "current-theme-btn" : "";
const allClasses =
	`${baseClasses} ${interactiveClasses} ${spacingClass} ${activeClass} ${className || ""}`.trim();

const Tag = href && !disabled ? "a" : "button";
---

<Tag 
	href={disabled ? undefined : href}
	target={disabled ? undefined : target}
	disabled={disabled ? true : undefined}
	aria-disabled={disabled ? "true" : undefined}
	class={allClasses}
	onclick={disabled ? undefined : onclick}
	{...rest}
>
	<slot />
</Tag>
