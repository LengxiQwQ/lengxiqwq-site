---
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import CommentsSidebar from "@/components/widget/CommentsSidebar.svelte";
import { commentConfig, profileConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";
import { url } from "@/utils/url-utils";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}

const { class: className, style, widgetConfig } = Astro.props;
const showTitle = widgetConfig?.showTitle !== false;
const configuredLimit = widgetConfig?.specificConfig?.comments?.limit ?? 5;
const limit = Math.max(1, Math.floor(configuredLimit));

const isCommentEnabled = commentConfig?.type && commentConfig.type !== "none";
const authorName = profileConfig.name;
---

{
	isCommentEnabled && (
		<WidgetLayout
			name={i18n(I18nKey.latestComments)}
			showTitle={showTitle}
			id="latest-comments"
			class={className}
			style={style}
		>
			<CommentsSidebar
				client:visible
				commentConfig={commentConfig}
				limit={limit}
				authorName={authorName}
			/>
			{siteConfig.pages.guestbook && (
				<a
					class="btn-plain mt-2 flex items-center justify-center gap-1 rounded-lg p-1.5
						text-sm text-(--primary)"
					href={url("/guestbook/")}
				>
					<Icon
						name="material-symbols:chat-outline-rounded"
						class="size-4.5"
						aria-hidden="true"
					/>
					<span>{i18n(I18nKey.guestbook)}</span>
				</a>
			)}
		</WidgetLayout>
	)
}
