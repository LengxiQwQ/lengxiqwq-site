---
import { Icon } from "astro-icon/components";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import { profileConfig } from "@/config/profileConfig";
import { encodeMailto, MAILTO_ONCLICK_SCRIPT } from "@/utils/email-utils";
import { url } from "@/utils/url-utils";

interface Props {
	class?: string;
	style?: string;
}
const { style } = Astro.props;
const className = Astro.props.class;
const contact = profileConfig.contact;
// 保留备用：原下方联系方式文本行开关，日后若需启用改为 true 即可
const showContactRows: boolean = false;
---

<div class:list={["card-base", "p-3", className]} style={style}>
  <a
    aria-label="Go to About Page"
    href={url("/about/")}
    class="group block relative mx-auto mt-1 lg:mx-0 lg:mt-0 mb-3
       max-w-48 lg:max-w-none overflow-hidden rounded-xl active:scale-95"
  >
    <div
      class="absolute transition pointer-events-none group-hover:bg-black/30 group-active:bg-black/50
        w-full h-full z-50 flex items-center justify-center"
    >
      <Icon
        name="fa7-regular:address-card"
        class="transition opacity-0 scale-90 group-hover:scale-100 group-hover:opacity-100 text-white text-5xl"
      />
    </div>
    <ImageWrapper
      src={profileConfig.avatar || ""}
      alt="Profile Image of the Author"
      class="profile-avatar-image mx-auto lg:w-full h-full lg:mt-0"
      loading="eager"
      fetchpriority="high"
      widths={[350]}
      sizes="350px"
    />
  </a>
  <div class="px-2">
    <div
      class="font-bold text-xl text-center mb-1 dark:text-neutral-50 transition"
    >
      {profileConfig.name}
    </div>
    <div
      class="h-1 w-5 bg-(--primary) mx-auto rounded-full mb-2 transition"
    >
    </div>
    <div class="text-center text-neutral-400 mb-2.5 transition">
      {profileConfig.bio}
    </div>
        <div class="flex flex-wrap gap-2 justify-center mb-1">
        {profileConfig.links.map((item, index) => {
            const showName = item.showName;
            const className = showName 
                ? "btn-regular rounded-lg h-10 gap-2 px-3 font-bold active:scale-95" 
                : "btn-regular rounded-lg h-10 w-10 active:scale-90 flex items-center justify-center";

            const isMailto = item.url.startsWith("mailto:");
            const encodedEmail = isMailto ? encodeMailto(item.url) : null;
            const isQQ = item.name.toLowerCase() === "qq" || item.url.startsWith("tencent:") || item.url.startsWith("mqqapi:") || item.url.includes("qm.qq.com");
            const isQmUrl = item.url.includes("qm.qq.com");
            const qqNumber = isQQ ? (item.copyText || item.url.match(/uin=(\d+)/)?.[1] || (item.url.match(/^\d+$/) ? item.url : "")) : "";
            const hasPopover = Boolean(item.copyText);

            // 根据按钮在列表中的相对位置，调整气泡弹出对齐与小箭头指示点
            const total = profileConfig.links.length;
            const isFirst = index === 0;
            const isLast = index === total - 1;
            const popoverAlign = isFirst ? "left-0" : isLast ? "right-0" : "left-1/2 -translate-x-1/2";
            const arrowAlign = isFirst ? "left-5 -translate-x-1/2" : isLast ? "right-5 translate-x-1/2" : "left-1/2 -translate-x-1/2";

            return (
                <div class:list={["relative", hasPopover && "profile-popover-wrapper group/popover"]}>
                    {isMailto ? (
                        <a
                            rel="me"
                            aria-label={item.name}
                            href="#"
                            data-encoded-email={encodedEmail}
                            onclick={MAILTO_ONCLICK_SCRIPT}
                            class={className}
                            title={hasPopover ? undefined : item.name}
                        >
                            <Icon name={item.icon} class="text-[1.5rem]" />
                            {showName && item.name}
                        </a>
                    ) : isQQ && !isQmUrl && qqNumber ? (
                        <a
                            rel="me"
                            aria-label={item.name}
                            href={`mqqapi://card/show_pslcard?src_type=internal&version=1&uin=${qqNumber}&card_type=person&source=sharecard`}
                            class:list={[className, "profile-qq-btn"]}
                            data-qq={qqNumber}
                            title={hasPopover ? undefined : item.name}
                        >
                            <Icon name={item.icon} class="text-[1.5rem]" />
                            {showName && item.name}
                        </a>
                    ) : (
                        <a
                            rel="me"
                            aria-label={item.name}
                            href={item.url}
                            target={item.url.startsWith("tencent:") || item.url.startsWith("mqqapi:") ? undefined : "_blank"}
                            class={className}
                            title={hasPopover ? undefined : item.name}
                        >
                            <Icon name={item.icon} class="text-[1.5rem]" />
                            {showName && item.name}
                        </a>
                    )}

                    {hasPopover && (
                        <div class:list={[
                            "profile-popover absolute bottom-full mb-2.5 z-50",
                            popoverAlign
                        ]}>
                            <div
                                class="profile-popover-card card-base shadow-xl border border-(--line-divider) px-2.5 py-1.5 rounded-xl flex items-center gap-1.5 whitespace-nowrap select-text"
                            >
                                <div class="flex items-center justify-center shrink-0 pointer-events-none select-none text-(--primary)">
                                    <Icon name={item.icon} class="text-[1.1rem]" />
                                </div>
                                <span class="font-mono text-xs font-medium text-75 select-text cursor-text tracking-wide px-0.5">
                                    {item.copyText}
                                </span>
                                <button
                                    type="button"
                                    data-copy={item.copyText}
                                    class="popover-copy-btn relative w-6 h-6 flex items-center justify-center shrink-0 text-50 md:hover:text-(--primary) hover:bg-black/5 dark:hover:bg-white/10 rounded-md -mr-0.5 cursor-pointer transition-colors overflow-hidden"
                                    title="点击复制"
                                    aria-label={`复制 ${item.name}：${item.copyText}`}
                                >
                                    <Icon name="material-symbols:content-copy-outline" class="icon-copy text-[0.95rem] absolute inset-0 m-auto pointer-events-none transition-all duration-200" />
                                    <Icon name="material-symbols:check-rounded" class="icon-check text-[1.05rem] text-(--primary) absolute inset-0 m-auto pointer-events-none transition-all duration-200" />
                                </button>
                                <!-- 底部指示小三角箭头 -->
                                <div class:list={[
                                    "popover-arrow absolute -bottom-1 w-2 h-2 rotate-45 bg-(--card-bg) border-r border-b border-(--line-divider) pointer-events-none",
                                    arrowAlign
                                ]}></div>
                            </div>
                        </div>
                    )}
                </div>
            );
        })}
    </div>

    {/* 保留备用：原下方联系方式文本行，先隐藏备用，日后若需启用将顶部 showContactRows 改为 true 即可 */}
    {showContactRows && contact && (contact.email || contact.qq) && (
    <div class="mt-2.5 flex flex-col items-center">
        <div class="flex flex-col items-start w-fit max-w-full space-y-0.5">
            {contact.email && (
            <div class="copy-contact-row relative flex items-center w-full">
                <div
                    role="button"
                    tabindex="0"
                    data-copy={contact.email}
                    class="copy-contact-btn w-full inline-flex items-center justify-start gap-1.5 text-xs text-neutral-500 md:hover:text-(--primary) dark:text-neutral-400 dark:md:hover:text-(--primary) transition-colors py-1 px-2.5 rounded-lg hover:bg-black/5 dark:hover:bg-white/10 cursor-pointer select-text group"
                    title="点击复制"
                    aria-label={`邮箱：${contact.email}`}
                >
                    <div class="w-4.5 flex items-center justify-center shrink-0 select-none pointer-events-none">
                        <Icon name="material-symbols:mail-outline-rounded" class="text-[1.1rem]" />
                    </div>
                    <span class="font-medium tracking-wide select-text">{contact.email}</span>
                </div>

                <!-- 打勾效果：放在小框外面，绝对定位零位移，上下垂直对齐 -->
                <div class="copy-check-badge absolute left-full ml-1.5 flex items-center justify-center pointer-events-none select-none text-(--primary)" aria-hidden="true">
                    <Icon name="material-symbols:check-rounded" class="text-[1.15rem]" />
                </div>
            </div>
            )}

            {contact.qq && (
            <div class="copy-contact-row relative flex items-center w-full">
                <div
                    role="button"
                    tabindex="0"
                    data-copy={contact.qq}
                    class="copy-contact-btn w-full inline-flex items-center justify-start gap-1.5 text-xs text-neutral-500 md:hover:text-(--primary) dark:text-neutral-400 dark:md:hover:text-(--primary) transition-colors py-1 px-2.5 rounded-lg hover:bg-black/5 dark:hover:bg-white/10 cursor-pointer select-text group"
                    title="点击复制"
                    aria-label={`QQ：${contact.qq}`}
                >
                    <div class="w-4.5 flex items-center justify-center shrink-0 select-none pointer-events-none">
                        <Icon name="mingcute:qq-line" class="text-[1.1rem]" />
                    </div>
                    <span class="font-medium tracking-wide select-text">{contact.qq}</span>
                </div>

                <!-- 打勾效果：放在小框外面，绝对定位零位移，上下垂直对齐 -->
                <div class="copy-check-badge absolute left-full ml-1.5 flex items-center justify-center pointer-events-none select-none text-(--primary)" aria-hidden="true">
                    <Icon name="material-symbols:check-rounded" class="text-[1.15rem]" />
                </div>
            </div>
            )}
        </div>
    </div>
    )}
  </div>
</div>

<style>
    .copy-contact-btn,
    .profile-popover-card {
        user-select: text !important;
        -webkit-user-select: text !important;
    }

    .copy-contact-btn *::selection,
    .profile-popover-card *::selection {
        background-color: color-mix(in oklch, var(--primary) 30%, transparent);
        color: inherit;
    }

    /* 气泡平滑过渡：默认隐藏，具备微位移与缩放的自然高级入场/退场质感 */
    .profile-popover {
        opacity: 0;
        pointer-events: none;
        transform: translateY(6px) scale(0.96);
        transform-origin: bottom center;
        transition: opacity 0.18s cubic-bezier(0.16, 1, 0.3, 1), transform 0.18s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: opacity, transform;
    }

    /* 激活状态：通过 JS is-open 类或键盘 focus-within 激活，确保精准 0.2s 宽限期不受 CSS 伪类撕裂 */
    .profile-popover-wrapper.is-open .profile-popover,
    .profile-popover-wrapper:focus-within .profile-popover {
        opacity: 1;
        pointer-events: auto;
        transform: translateY(0) scale(1);
    }

    /* 气泡底部隐形安全桥梁，覆盖弹窗与按钮之间 10px 空隙，防止鼠标跨越时指针失焦 */
    .profile-popover::after {
        content: "";
        position: absolute;
        top: 100%;
        left: -12px;
        width: calc(100% + 24px);
        height: 14px;
        display: block;
    }

    /* 复制按钮及打勾动效：严格锁定 24x24 盒模型，零位移、零跳动 */
    .popover-copy-btn {
        box-sizing: border-box;
    }

    .popover-copy-btn .icon-copy {
        opacity: 1;
        transform: scale(1);
        transition: opacity 0.18s cubic-bezier(0.16, 1, 0.3, 1), transform 0.18s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .popover-copy-btn .icon-check {
        opacity: 0;
        transform: scale(0.4);
        pointer-events: none;
        transition: opacity 0.18s cubic-bezier(0.16, 1, 0.3, 1), transform 0.18s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .popover-copy-btn.is-copied .icon-copy {
        opacity: 0;
        transform: scale(0.4);
        pointer-events: none;
    }

    .popover-copy-btn.is-copied .icon-check {
        opacity: 1;
        transform: scale(1);
        pointer-events: none;
        animation: checkBounce 0.28s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    }

    @keyframes checkBounce {
        0% { transform: scale(0.4); opacity: 0; }
        60% { transform: scale(1.15); opacity: 1; }
        100% { transform: scale(1); opacity: 1; }
    }

    /* 打勾效果放在小框外面：绝对定位 + 零位移平滑微动效 */
    .copy-contact-row .copy-check-badge {
        opacity: 0;
        transform: scale(0.6) translateX(-4px);
        transition: opacity 0.2s ease, transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .copy-contact-row.is-copied .copy-check-badge {
        opacity: 1;
        transform: scale(1) translateX(0);
    }
</style>

<script>
    // 社交图标弹窗 0.2s 离开容错缓冲（Grace Period）与无缝续接状态管理
    let activePopoverWrapper: HTMLElement | null = null;
    let popoverHideTimer: ReturnType<typeof setTimeout> | null = null;

    function clearPopoverTimer() {
        if (popoverHideTimer) {
            clearTimeout(popoverHideTimer);
            popoverHideTimer = null;
        }
    }

    // 鼠标移入监听（委托）：涵盖按钮、弹窗本体、安全桥等任何内部区域
    document.addEventListener("mouseover", (e) => {
        const target = e.target as HTMLElement | null;
        const wrapper = target?.closest(".profile-popover-wrapper") as HTMLElement | null;
        if (wrapper) {
            // 只要鼠标在按钮或弹窗上，立即清除关闭倒计时
            clearPopoverTimer();

            // 若之前激活的是另一个 popover（如从 Email 快速直接划到 QQ），立即收起旧的避免重叠
            if (activePopoverWrapper && activePopoverWrapper !== wrapper) {
                activePopoverWrapper.classList.remove("is-open");
            }

            activePopoverWrapper = wrapper;
            wrapper.classList.add("is-open");
        }
    });

    // 鼠标移出监听（委托）
    document.addEventListener("mouseout", (e) => {
        const target = e.target as HTMLElement | null;
        const wrapper = target?.closest(".profile-popover-wrapper") as HTMLElement | null;
        if (wrapper) {
            // 检查鼠标移向的目标：如果仍然在当前 wrapper 内部（如从按钮移向弹窗，或在弹窗卡片内各子元素间移动），绝不触发离开
            const related = e.relatedTarget as HTMLElement | null;
            if (related && wrapper.contains(related)) {
                return;
            }

            // 鼠标真正离开当前整体区域（无论是离开了弹窗还是离开了按钮），启动精准 0.2 秒（200ms）宽限期
            clearPopoverTimer();
            popoverHideTimer = setTimeout(() => {
                wrapper.classList.remove("is-open");
                if (activePopoverWrapper === wrapper) {
                    activePopoverWrapper = null;
                }
            }, 200);
        }
    });

    // 页面不可见或切后台时，自动清理遗留弹窗与定时器
    document.addEventListener("visibilitychange", () => {
        if (document.hidden) {
            clearPopoverTimer();
            if (activePopoverWrapper) {
                activePopoverWrapper.classList.remove("is-open");
                activePopoverWrapper = null;
            }
        }
    });

    function copyText(text: string): Promise<void> {
        if (navigator.clipboard && window.isSecureContext) {
            return navigator.clipboard.writeText(text);
        }
        const textArea = document.createElement("textarea");
        textArea.value = text;
        textArea.style.position = "fixed";
        textArea.style.left = "-9999px";
        textArea.style.top = "-9999px";
        document.body.appendChild(textArea);
        textArea.focus();
        textArea.select();
        return new Promise((resolve, reject) => {
            try {
                const successful = document.execCommand("copy");
                document.body.removeChild(textArea);
                successful ? resolve() : reject(new Error("Copy command failed"));
            } catch (err) {
                document.body.removeChild(textArea);
                reject(err);
            }
        });
    }

    function showPopoverCopiedFeedback(btn: HTMLElement) {
        const btnObj = btn as unknown as { _copyTimeout?: ReturnType<typeof setTimeout> };
        if (btnObj._copyTimeout) {
            clearTimeout(btnObj._copyTimeout);
        }

        btn.classList.add("is-copied");
        btn.setAttribute("title", "已复制！");

        btnObj._copyTimeout = setTimeout(() => {
            btn.classList.remove("is-copied");
            btn.setAttribute("title", "点击复制");
            btnObj._copyTimeout = undefined;
        }, 2000);
    }

    function showProfileToast(message: string) {
        let toast = document.getElementById("profile-toast");
        if (!toast) {
            toast = document.createElement("div");
            toast.id = "profile-toast";
            toast.className = "fixed bottom-8 left-1/2 -translate-x-1/2 z-[1080] px-4 py-2.5 rounded-xl bg-black/85 dark:bg-neutral-800/90 text-white text-xs sm:text-sm font-medium shadow-2xl backdrop-blur-md opacity-0 pointer-events-none transition-all duration-300 max-w-[90vw] text-center border border-white/10";
            document.body.appendChild(toast);
        }
        toast.textContent = message;
        toast.classList.remove("opacity-0", "translate-y-2");
        toast.classList.add("opacity-100", "translate-y-0");

        const toastObj = toast as unknown as { _timer?: ReturnType<typeof setTimeout> };
        if (toastObj._timer) clearTimeout(toastObj._timer);
        toastObj._timer = setTimeout(() => {
            toast.classList.remove("opacity-100", "translate-y-0");
            toast.classList.add("opacity-0", "translate-y-2");
            toastObj._timer = undefined;
        }, 3500);
    }

    function showCopiedFeedback(row: HTMLElement) {
        const rowObj = row as unknown as { _copyTimeout?: ReturnType<typeof setTimeout> };
        if (rowObj._copyTimeout) {
            clearTimeout(rowObj._copyTimeout);
        }

        row.classList.add("is-copied");
        const btn = row.querySelector(".copy-contact-btn") as HTMLElement | null;
        if (btn) {
            btn.setAttribute("title", "已复制！");

            rowObj._copyTimeout = setTimeout(() => {
                row.classList.remove("is-copied");
                btn.setAttribute("title", "点击复制");
                rowObj._copyTimeout = undefined;
            }, 2000);
        }
    }

    let isDragging = false;
    let startX = 0;
    let startY = 0;

    document.addEventListener("mousedown", (e) => {
        const target = e.target as HTMLElement | null;
        const row = target?.closest(".copy-contact-row");
        if (row) {
            isDragging = false;
            startX = e.clientX;
            startY = e.clientY;
        }
    });

    document.addEventListener("mousemove", (e) => {
        if (!isDragging) {
            const dist = Math.hypot(e.clientX - startX, e.clientY - startY);
            if (dist > 5) {
                isDragging = true;
            }
        }
    });

    // 1. 点击直接复制对应内容（独立复制按钮或备用联系行触发）
    document.addEventListener("click", (e) => {
        const target = e.target as HTMLElement | null;

        // 悬停气泡中的独立复制按钮（文字区域不触发复制，仅供选择）
        const copyBtn = target?.closest(".popover-copy-btn") as HTMLElement | null;
        if (copyBtn) {
            e.preventDefault();
            e.stopPropagation();

            const textToCopy = copyBtn.getAttribute("data-copy") || "";
            if (!textToCopy) return;

            copyText(textToCopy).then(() => {
                showPopoverCopiedFeedback(copyBtn);
            }).catch((err) => {
                console.error("Failed to copy text:", err);
            });
            return;
        }

        // QQ 按钮跨端智能响应
        const qqBtn = target?.closest(".profile-qq-btn") as HTMLElement | null;
        if (qqBtn) {
            const qq = qqBtn.getAttribute("data-qq") || "";
            const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
            if (!isMobile) {
                // PC 端：现代电脑 QQ NT 不支持网页外部拉起加好友对话框，自动复制 + 唤起客户端 + 给出明确提示
                e.preventDefault();
                e.stopPropagation();

                if (qq) {
                    copyText(qq).then(() => {
                        const popoverBtn = qqBtn.closest(".profile-popover-wrapper, .group\\/popover")?.querySelector(".popover-copy-btn") as HTMLElement | null;
                        if (popoverBtn) showPopoverCopiedFeedback(popoverBtn);
                    }).catch(() => {});

                    // 尝试唤起桌面 QQ 到前台
                    window.location.href = `tencent://message/?uin=${qq}&Site=在线客服&Menu=yes`;

                    showProfileToast(`已复制 QQ 号 (${qq})，由于电脑版 QQ 限制，请在 QQ 搜索栏粘贴添加好友`);
                }
            } else {
                // 移动端：静默复制备用，并允许浏览器执行 mqqapi:// 协议呼起手机 QQ 个人资料卡
                if (qq) {
                    copyText(qq).catch(() => {});
                }
            }
            return;
        }

        // 备用联系行
        const row = target?.closest(".copy-contact-row") as HTMLElement | null;
        if (!row) return;

        const selection = window.getSelection();
        const selectedText = selection ? selection.toString().trim() : "";
        if (isDragging || selectedText.length > 0) {
            return;
        }

        const btn = row.querySelector(".copy-contact-btn") as HTMLElement | null;
        const textToCopy = btn?.getAttribute("data-copy") || "";
        if (!textToCopy) return;

        copyText(textToCopy).then(() => {
            showCopiedFeedback(row);
        }).catch((err) => {
            console.error("Failed to copy text:", err);
        });
    });

    // 2. 支持键盘 Enter / Space 激活复制
    document.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
            const activeEl = document.activeElement as HTMLElement | null;
            if (activeEl?.classList.contains("popover-copy-btn")) {
                e.preventDefault();
                e.stopPropagation();
                const textToCopy = activeEl.getAttribute("data-copy") || "";
                if (textToCopy) {
                    copyText(textToCopy).then(() => {
                        showPopoverCopiedFeedback(activeEl);
                    });
                }
                return;
            }

            if (activeEl?.classList.contains("copy-contact-btn")) {
                const row = activeEl.closest(".copy-contact-row") as HTMLElement | null;
                if (!row) return;
                e.preventDefault();
                const textToCopy = activeEl.getAttribute("data-copy") || "";
                if (textToCopy) {
                    copyText(textToCopy).then(() => {
                        showCopiedFeedback(row);
                    });
                }
            }
        }
    });

    // 3. 用户框选文本并复制（Ctrl+C 或右键复制）时，触发对勾反馈
    document.addEventListener("copy", () => {
        const selection = window.getSelection();
        if (selection && selection.rangeCount > 0) {
            const anchorNode = selection.anchorNode;
            const popoverCard = anchorNode instanceof Element
                ? anchorNode.closest(".profile-popover-card")
                : anchorNode?.parentElement?.closest(".profile-popover-card");
            if (popoverCard) {
                const copyBtn = popoverCard.querySelector(".popover-copy-btn") as HTMLElement | null;
                if (copyBtn) {
                    showPopoverCopiedFeedback(copyBtn);
                }
                return;
            }

            const row = anchorNode instanceof Element
                ? anchorNode.closest(".copy-contact-row")
                : anchorNode?.parentElement?.closest(".copy-contact-row");
            if (row) {
                showCopiedFeedback(row as HTMLElement);
            }
        }
    });
</script>
