<!-- 仅同步浏览器主题信息，不在网页内部绘制状态栏或渐变覆盖层。 -->
<script>
    // theme-color 接受的是单一颜色；渐变由上面的网页边缘层负责。
    // 取实际 page-bg 并转换成 sRGB，避免旧浏览器不识别 meta 内的 OKLCH。
    const canvas = document.createElement("canvas");
    canvas.width = canvas.height = 1;
    const context = canvas.getContext("2d", { willReadFrequently: true });
    let updatePending = false;
    let themeProbe: HTMLSpanElement | null = null;
    let lastDarkState = document.documentElement.classList.contains("dark");
    let lastHueValue = document.documentElement.style.getPropertyValue("--hue");

    function getThemeProbe(): HTMLSpanElement | null {
        if (!document.body) return null;
        if (!themeProbe || !themeProbe.isConnected) {
            themeProbe = document.createElement("span");
            themeProbe.setAttribute("aria-hidden", "true");
            themeProbe.style.cssText = "position:fixed;width:0;height:0;pointer-events:none;visibility:hidden;contain:strict;background-color:var(--page-bg)";
            document.body.append(themeProbe);
        }
        return themeProbe;
    }

    function syncBrowserTheme(): void {
        updatePending = false;
        const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
        if (!meta || !context) return;
        const probe = getThemeProbe();
        if (!probe) return;
        const color = getComputedStyle(probe).backgroundColor;
        context.clearRect(0, 0, 1, 1);
        context.fillStyle = color;
        context.fillRect(0, 0, 1, 1);
        const [red, green, blue] = context.getImageData(0, 0, 1, 1).data;
        const hex = `#${[red, green, blue].map((value) => value.toString(16).padStart(2, "0")).join("")}`;
        if (meta.content !== hex) meta.content = hex;
        const scheme = document.documentElement.classList.contains("dark") ? "dark" : "light";
        if (document.documentElement.style.colorScheme !== scheme) document.documentElement.style.colorScheme = scheme;
    }

    function scheduleBrowserTheme(): void {
        if (updatePending) return;
        updatePending = true;
        requestAnimationFrame(syncBrowserTheme);
    }

    const observer = new MutationObserver(() => {
        const darkState = document.documentElement.classList.contains("dark");
        const hueValue = document.documentElement.style.getPropertyValue("--hue");
        if (darkState === lastDarkState && hueValue === lastHueValue) return;
        lastDarkState = darkState;
        lastHueValue = hueValue;
        scheduleBrowserTheme();
    });
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ["class", "style"] });
    document.addEventListener("astro:page-load", scheduleBrowserTheme);
    document.addEventListener("swup:contentReplaced", scheduleBrowserTheme);
    syncBrowserTheme();
</script>
