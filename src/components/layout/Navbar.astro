---
import { Picture } from "astro:assets";
import * as path from "node:path";
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";
import DropdownItem from "@/components/common/DropdownItem.astro";
import DisplaySettings from "@/components/controls/DisplaySettingsIntegrated.svelte";
import LightDarkSwitch from "@/components/controls/LightDarkSwitch.svelte";
import Search from "@/components/controls/Search.svelte";
import MusicPlayer from "@/components/features/MusicPlayer.astro";
import {
	backgroundWallpaper,
	displaySettingsConfig,
	navBarConfig,
	siteConfig,
} from "@/config";
import { musicPlayerConfig } from "@/config/musicConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { NavBarLink } from "@/types/config";
import { getFallbackFormat, getImageFormats } from "@/utils/image-utils";
import { isHomePage } from "@/utils/layout-utils";
import { resolveNavMenuLinks } from "@/utils/nav-menu-utils";
import { url } from "@/utils/url-utils";
import DropdownMenu from "./DropdownMenu.astro";

const className = Astro.props.class;

// 妫€鏌ユ槸鍚︿负棣栭〉
const isHomePageCheck = isHomePage(Astro.url.pathname);

// 瀵艰埅鏍忛€忔槑妯″紡锛歜anner 鐢?banner.navbar锛宖ullscreen 鐢?fullscreen.navbar锛坰emifull 浠呴椤靛姩鎬侊級
const navbarTransparentMode =
	backgroundWallpaper.mode === "banner"
		? (() => {
				const t = backgroundWallpaper.banner?.navbar?.transparentMode || "semi";
				return t === "semifull" && !isHomePageCheck ? "semi" : t;
			})()
		: backgroundWallpaper.mode === "fullscreen"
			? (() => {
					const fs =
						backgroundWallpaper.fullscreen?.navbar?.transparentMode ||
						"semifull";
					return fs === "semifull" && isHomePageCheck ? "semifull" : "semi";
				})()
			: "semi";

// 鑾峰彇瀵艰埅鏍忔ā绯婂害锛? 鍗冲叧闂鑸爮姣涚幓鐠冿級
const navbarBlur =
	backgroundWallpaper.mode === "banner"
		? (backgroundWallpaper.banner?.navbar?.blur ?? 20)
		: backgroundWallpaper.mode === "fullscreen"
			? (backgroundWallpaper.fullscreen?.navbar?.blur ?? 20)
			: 0;

// 鑾峰彇瀵艰埅鏍忔爣棰橈紝濡傛灉娌℃湁璁剧疆鍒欎娇鐢?siteConfig.title
const navbarTitle = siteConfig.navbar.title || siteConfig.title;

// 鑾峰彇瀵艰埅鏍忓搴﹂厤缃?
const navbarWidthFull = siteConfig.navbar.widthFull ?? false;
const navbarMenuAlign = siteConfig.navbar.menuAlign ?? "center";
const isNavbarMenuCentered = navbarMenuAlign === "center";

// 妫€鏌ユ槸鍚︽湁浠讳綍鏄剧ず璁剧疆鍙敤锛堟€诲紑鍏冲叧闂椂涓嬫柟鍚勯」鍧囦负 false锛?
const isDisplaySettingsEnabled = displaySettingsConfig.enable;
const showThemeColor = displaySettingsConfig.themeColorSwitchable;
const isWallpaperSwitchable = displaySettingsConfig.wallpaperModeSwitchable;
const allowLayoutSwitch = displaySettingsConfig.layoutSwitchable;
const hasDisplaySettings =
	showThemeColor || isWallpaperSwitchable || allowLayoutSwitch;

// 瑙ｆ瀽瀵艰埅鏍忛摼鎺ワ紙鎸?siteConfig.pages 杩囨护 + i18n 鍚嶇О锛夛紝妗岄潰涓嬫媺涓庣Щ鍔ㄦ娊灞夊叡鐢?
const links: NavBarLink[] = resolveNavMenuLinks();

// 澶勭悊瀵艰埅鏍?Logo 鍥剧墖锛宨mage / url 绫诲瀷鏀寔浜殫鑹插垎鍒缃?
const logoConfig = siteConfig.navbar.logo;
const logoAlt = logoConfig?.alt || siteConfig.title;
const logoIsImage = logoConfig?.type === "image" || logoConfig?.type === "url";
const logoBaseClass = "navbar-logo h-7 w-7 mb-1 mr-2 rounded-full object-cover";

const logoFiles = import.meta.glob<ImageMetadata>(
	"../../**/*.{png,jpg,jpeg,webp,avif,gif,svg}",
	{ import: "default" },
);

// 浠?src 鐩綍涓嬬殑鏈湴鍥剧墖浜ょ粰 Astro 浼樺寲锛宲ublic 鐩綍鍜岀綉缁滃浘鐗囩洿鎺ョ敤鍘熷湴鍧€
async function resolveLocalLogo(value: string): Promise<ImageMetadata | null> {
	if (
		logoConfig?.type !== "image" ||
		!value ||
		value.startsWith("/") ||
		value.startsWith("http")
	) {
		return null;
	}
	const normalizedPath = path
		.normalize(path.join("../../", value))
		.replace(/\\/g, "/");
	const file = logoFiles[normalizedPath];
	return file ? await file() : null;
}

const logoLightValue = logoConfig?.value || "";
const logoDarkValue = logoConfig?.valueDark || "";
const hasDarkLogo = !!logoDarkValue && logoDarkValue !== logoLightValue;

const logoVariants = await Promise.all(
	(hasDarkLogo
		? [
				{ value: logoLightValue, theme: "light", themeClass: "dark:hidden" },
				{
					value: logoDarkValue,
					theme: "dark",
					themeClass: "hidden dark:block",
				},
			]
		: [{ value: logoLightValue, theme: "light", themeClass: "" }]
	)
		.filter((variant) => !!variant.value)
		.map(async (variant) => ({
			theme: variant.theme,
			class: variant.themeClass
				? `${logoBaseClass} ${variant.themeClass}`
				: logoBaseClass,
			image: await resolveLocalLogo(variant.value),
			src: logoConfig?.type === "url" ? variant.value : url(variant.value),
		})),
);

const siteSwitcher = navBarConfig.siteSwitcher;
const hasSiteSwitcher =
	siteSwitcher?.enable && siteSwitcher.items && siteSwitcher.items.length > 0;
---
<div id="navbar" class="z-50" style={`--navbar-glass-blur: ${navbarBlur}px; --navbar-scroll-progress: 0;`} data-transparent-mode={navbarTransparentMode} data-is-home={isHomePageCheck} data-full-width={navbarWidthFull}>
    <script is:inline define:vars={{
      bannerTMode: backgroundWallpaper.banner?.navbar?.transparentMode || "semi",
      bannerBlur: backgroundWallpaper.banner?.navbar?.blur ?? 20,
      fsTMode: backgroundWallpaper.fullscreen?.navbar?.transparentMode || "semifull",
      fsBlur: backgroundWallpaper.fullscreen?.navbar?.blur ?? 20,
    }}>
      // 棣栧抚鍓嶆寜杩愯鏃跺绾告ā寮忎慨姝ｅ鑸爮閫忔槑妯″紡锛歋SR 鐨?data-transparent-mode 鎸?config 璁剧疆锛?
      // 涓庤繍琛屾椂妯″紡涓嶄竴鑷存椂锛堝 config fullscreen + 瀛樺偍 banner锛変細鍏堟寜閿欒妯″紡娓叉煋闂儊锛?
      // 杩欓噷鍦ㄨВ鏋愭湡鍚屾鎸?data-wallpaper-mode 淇锛堟棭浜?rAF/DOMContentLoaded锛?
      (function () {
        const wm = document.documentElement.getAttribute("data-wallpaper-mode");
        const navbar = document.getElementById("navbar");
        if (!wm || !navbar) return;
        const isHome = navbar.getAttribute("data-is-home") === "true";
        let mode;
        let blur;
        if (wm === "fullscreen") {
          mode = fsTMode === "semifull" && isHome ? "semifull" : "semi";
          blur = fsBlur;
        } else if (wm === "banner") {
          mode = bannerTMode === "semifull" && !isHome ? "semi" : bannerTMode;
          blur = mode === "none" ? 0 : bannerBlur;
        } else {
          // overlay / none
          mode = "none";
          blur = 0;
        }
        navbar.setAttribute("data-transparent-mode", mode);
        navbar.style.setProperty("--navbar-glass-blur", `${blur}px`);
        if (mode === "semifull") {
          const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
          const progress = Math.min(1, Math.max(0, scrollTop / 80));
          navbar.style.setProperty("--navbar-scroll-progress", progress.toFixed(3));
          navbar.style.setProperty("--navbar-dynamic-blur", `${(progress * blur).toFixed(1)}px`);
          if (progress >= 0.85) navbar.classList.add("scrolled");
        }
      })();
    </script>
    <div class:list={[
        className,
        "overflow-visible! h-18 px-4"
    ]}>
        <div class="mx-auto h-full w-full max-w-(--page-width) grid grid-cols-[auto_minmax(0,1fr)_auto] items-center">
            <!-- 绔欑偣 Logo銆佹爣棰樹笌绔欑偣鍒囨崲涓嬫媺鑿滃崟 -->
            <div class="relative site-switcher-container" id="site-switcher-container">
                {hasSiteSwitcher ? (
                <button
                    type="button"
                    id="site-switcher-trigger"
                    aria-expanded="false"
                    aria-haspopup="true"
                    aria-label="鍒囨崲绔欑偣"
                    class="btn-plain scale-animation rounded-lg h-13 px-3 md:px-5 font-bold md:active:scale-95 flex items-center gap-1 cursor-pointer select-none"
                >
                    <div class:list={[
                        "flex flex-row items-center text-md text-[16px]",
                        siteConfig.navbar.followTheme ? "text-(--primary)" : "dark:text-white text-black"
                    ]} style="font-family: var(--font-navbar-title, inherit)">
                        {logoConfig?.type === "icon" ? (
                            <Icon is:inline name={logoConfig.value || "material-symbols:home-pin-outline"} class="navbar-logo text-[1.75rem] mb-1 mr-2" />
                        ) : logoIsImage && logoVariants.length > 0 ? (
                            logoVariants.map((variant) => variant.image ? (
                                <Picture
                                    src={variant.image}
                                    alt={logoAlt}
                                    class={variant.class}
                                    data-logo-theme={variant.theme}
                                    formats={getImageFormats()}
                                    fallbackFormat={getFallbackFormat()}
                                    widths={[28, 56]}
                                    loading="eager"
                                    fetchpriority="high"
                                />
                            ) : (
                                <img src={variant.src} alt={logoAlt} class={variant.class} data-logo-theme={variant.theme} fetchpriority="high" width="28" height="28" />
                            ))
                        ) : (
                            <Icon is:inline name="material-symbols:home-pin-outline" class="navbar-logo text-[1.75rem] mb-1 mr-2" />
                        )}
                        <span class="tracking-tight">{navbarTitle}</span>
                    </div>
                    <Icon is:inline name="material-symbols:keyboard-arrow-down-rounded" class="site-switcher-arrow text-[1.25rem] transition-transform duration-200 text-50 ml-1" />
                </button>

                <!-- 涓嬫媺鑿滃崟锛氬叏鏂逛綅瀵规爣 header 鍏朵粬涓嬫媺鑿滃崟瑙勬牸 -->
                <div class="dropdown-menu" id="site-switcher-menu" data-dropdown-menu>
                    <div class="float-panel p-2 dropdown-content min-w-48" role="none">
                        {siteSwitcher.items?.map((item, idx) => (
                            <DropdownItem
                                href={item.url.startsWith("http") ? item.url : url(item.url)}
                                target={item.external ? "_blank" : undefined}
                                rel={item.external ? "noopener noreferrer" : undefined}
                                isLast={idx === (siteSwitcher.items?.length || 0) - 1}
                                class="dropdown-item focus-ring-inset h-10 site-option-item"
                                data-site={item.key || item.url}
                            >
                                <span>{item.title}</span>
                                <Icon is:inline name="material-symbols:check-rounded" class="site-check-icon text-[1.1rem] text-(--primary) ml-auto shrink-0 hidden" />
                                {item.external && (
                                    <Icon is:inline name="fa7-solid:arrow-up-right-from-square" class="site-external-icon text-[0.75rem] text-25 ml-auto shrink-0" />
                                )}
                            </DropdownItem>
                        ))}
                    </div>
                </div>
                ) : (
                <a
                    href={url('/')}
                    aria-label={i18n(I18nKey.home)}
                    class="btn-plain scale-animation rounded-lg h-13 px-3 md:px-5 font-bold md:active:scale-95 flex items-center gap-1 cursor-pointer select-none"
                >
                    <div class:list={[
                        "flex flex-row items-center text-md text-[16px]",
                        siteConfig.navbar.followTheme ? "text-(--primary)" : "dark:text-white text-black"
                    ]} style="font-family: var(--font-navbar-title, inherit)">
                        {logoConfig?.type === "icon" ? (
                            <Icon is:inline name={logoConfig.value || "material-symbols:home-pin-outline"} class="navbar-logo text-[1.75rem] mb-1 mr-2" />
                        ) : logoIsImage && logoVariants.length > 0 ? (
                            logoVariants.map((variant) => variant.image ? (
                                <Picture
                                    src={variant.image}
                                    alt={logoAlt}
                                    class={variant.class}
                                    data-logo-theme={variant.theme}
                                    formats={getImageFormats()}
                                    fallbackFormat={getFallbackFormat()}
                                    widths={[28, 56]}
                                    loading="eager"
                                    fetchpriority="high"
                                />
                            ) : (
                                <img src={variant.src} alt={logoAlt} class={variant.class} data-logo-theme={variant.theme} fetchpriority="high" width="28" height="28" />
                            ))
                        ) : (
                            <Icon is:inline name="material-symbols:home-pin-outline" class="navbar-logo text-[1.75rem] mb-1 mr-2" />
                        )}
                        <span class="tracking-tight">{navbarTitle}</span>
                    </div>
                </a>
                )}
            </div>
            <div class:list={[
                "hidden lg:flex items-center space-x-1 col-start-2",
                isNavbarMenuCentered
                    ? "justify-center"
                    : "justify-start pl-2"
            ]}>
                {links.map((l) => {
                    return <DropdownMenu link={l} />;
                })}
            </div>
            <div class="flex col-start-3 justify-self-end">
                <!--<SearchPanel client:load>-->
                <Search
                    client:load
                />
                {musicPlayerConfig.showInNavbar && (
                    <button aria-label={i18n(I18nKey.music)} aria-controls="music-nav-panel" aria-expanded="false" class="btn-plain scale-animation rounded-lg h-11 w-11 md:active:scale-90" id="music-player-switch">
                        <Icon is:inline name="material-symbols:music-note-rounded" class="text-[1.25rem]"></Icon>
                    </button>
                )}
                {backgroundWallpaper.playerEnable && backgroundWallpaper.mode !== "none" && (
                    <button
                        aria-label={i18n(I18nKey.videoPlay)}
						class="btn-plain scale-animation rounded-lg h-11 w-11 md:active:scale-90 hidden md:flex"
                        id="bg-player-toggle"
                        data-i18n-play={i18n(I18nKey.videoPlay)}
                        data-i18n-pause={i18n(I18nKey.videoPause)}
                    >
                        <span class="bg-player-icon-play"><Icon is:inline name="material-symbols:play-arrow-rounded" class="text-[1.5rem]" /></span>
                        <span class="bg-player-icon-pause hidden"><Icon is:inline name="material-symbols:pause-rounded" class="text-[1.5rem]" /></span>
                    </button>
                )}
                {hasDisplaySettings && (
                        <button aria-label="Display Settings" aria-controls="display-setting" aria-expanded="false" class="btn-plain scale-animation rounded-lg h-11 w-11 md:active:scale-90" id="display-settings-switch">
                            <Icon is:inline name="material-symbols:palette-outline" class="text-[1.25rem]"></Icon>
                        </button>
                )}
                {/* @ts-ignore */}
                <LightDarkSwitch client:load></LightDarkSwitch>
                <button aria-label="Menu" aria-controls="nav-menu-panel" aria-expanded="false" name="Nav Menu" class="btn-plain scale-animation rounded-lg w-11 h-11 md:active:scale-90 lg:hidden!" id="nav-menu-switch">
                    <Icon is:inline name="material-symbols:menu-rounded" class="text-[1.25rem]"></Icon>
                </button>
            </div>
        </div>
        {musicPlayerConfig.showInNavbar && (
            <div id="music-nav-panel" class="float-panel float-panel-closed absolute transition-all right-16 p-2 pt-4.5 w-80 z-50" data-floating-panel data-floating-panel-trigger="music-player-switch" inert aria-hidden="true">
                <MusicPlayer />
            </div>
        )}
        {isDisplaySettingsEnabled && <DisplaySettings client:load></DisplaySettings>}
    </div>
</div>

<script>
function loadButtonScript() {
    let settingBtn = document.getElementById("display-settings-switch");
    if (settingBtn) {
        settingBtn.onclick = function () {
            let settingPanel = document.getElementById("display-setting");
            if (settingPanel) {
                settingPanel.classList.toggle("float-panel-closed");
            }
        };
    }

    let menuBtn = document.getElementById("nav-menu-switch");
    if (menuBtn) {
        menuBtn.onclick = function () {
            let menuPanel = document.getElementById("nav-menu-panel");
            if (menuPanel) {
                menuPanel.classList.toggle("float-panel-closed");
            }
        };
    }

    let musicBtn = document.getElementById("music-player-switch");
    if (musicBtn) {
        musicBtn.onclick = function () {
            let musicPanel = document.getElementById("music-nav-panel");
            if (musicPanel) {
                musicPanel.classList.toggle("float-panel-closed");
            }
        };
    }

    // 鑳屾櫙瑙嗛鎾斁鍣ㄦ帶鍒舵寜閽?
    let bgPlayerBtn = document.getElementById("bg-player-toggle");
    if (bgPlayerBtn) {
        bgPlayerBtn.onclick = function () {
            window.dispatchEvent(new CustomEvent("bg-player-toggle"));
        };
        function toggleBgPlayerIcon(playing: boolean) {
            var playIcon = bgPlayerBtn!.querySelector(".bg-player-icon-play");
            var pauseIcon = bgPlayerBtn!.querySelector(".bg-player-icon-pause");
            if (playIcon && pauseIcon) {
                playIcon.classList.toggle("hidden", playing);
                pauseIcon.classList.toggle("hidden", !playing);
            }
            var i18nPlay = bgPlayerBtn!.getAttribute("data-i18n-play") ?? "";
            var i18nPause = bgPlayerBtn!.getAttribute("data-i18n-pause") ?? "";
            var label = playing ? i18nPause : i18nPlay;
            bgPlayerBtn!.setAttribute("title", label);
            bgPlayerBtn!.setAttribute("aria-label", label);
        }
        window.addEventListener("bg-player-state-change", function (e) {
            var ce = e as CustomEvent;
            var playing = ce.detail && ce.detail.playing;
            toggleBgPlayerIcon(playing);
        });
        // 鍒囨崲澹佺焊妯″紡鏃堕殣钘?鏄剧ず鎾斁鎸夐挳
        window.addEventListener("wallpaperModeChange", function (e) {
            var ce = e as CustomEvent;
            var mode = ce.detail && ce.detail.mode;
            bgPlayerBtn!.style.display = mode === "none" ? "none" : "";
        });
        // Swup 瀵艰埅鏃跺悓姝ユ挱鏀炬寜閽姸鎬侊紙BackgroundPlayer 鍙兘琚噸寤猴紝涔熷彲鑳芥寔涔呭瓨鍦級
        function syncBgPlayerBtn() {
            var playing = document.documentElement.hasAttribute("data-bg-video-playing");
            toggleBgPlayerIcon(playing);
        }
        if (window.swup && window.swup.hooks) {
            window.swup.hooks.on("content:replace", syncBgPlayerBtn);
        } else {
            document.addEventListener("swup:enable", function () {
                window.swup.hooks.on("content:replace", syncBgPlayerBtn);
            });
        }
    }

    let themeSwitchBtn = document.getElementById("scheme-switch");
    if (themeSwitchBtn) {
        themeSwitchBtn.onclick = function () {
            let themePanel = document.getElementById("theme-mode-panel");
            if (themePanel) {
                themePanel.classList.toggle("float-panel-closed");
            }
        };
    }

    // 绔欑偣鍒囨崲涓嬫媺鑿滃崟浜や簰
    const siteSwitcherContainer = document.getElementById("site-switcher-container");
    const siteSwitcherBtn = document.getElementById("site-switcher-trigger");

    if (siteSwitcherContainer && siteSwitcherBtn) {
        // 浠呯偣鍑绘寜閽睍寮€/鏀惰捣涓嬫媺鑿滃崟锛岄紶鏍囨斁涓婂幓涓嶄細瑙﹀彂
        siteSwitcherBtn.onclick = function (e) {
            e.preventDefault();
            e.stopPropagation();
            const isOpen = siteSwitcherContainer.classList.toggle("is-open");
            siteSwitcherBtn.setAttribute("aria-expanded", String(isOpen));
            if (isOpen) {
                ["display-setting", "music-nav-panel", "theme-mode-panel"].forEach((id) => {
                    document.getElementById(id)?.classList.add("float-panel-closed");
                });
            }
        };

        const siteOptions = siteSwitcherContainer.querySelectorAll(".site-option-item");
        siteOptions.forEach((opt) => {
            opt.addEventListener("click", (e) => {
                siteSwitcherContainer.classList.remove("is-open");
                siteSwitcherBtn.setAttribute("aria-expanded", "false");

                // 鐐瑰嚮褰撳墠婵€娲荤殑绔欑偣閫夐」鏃讹紝鐩存帴閲嶆柊璁块棶/鍒锋柊缃戦〉
                const checkIcon = opt.querySelector(".site-check-icon");
                if (checkIcon && !checkIcon.classList.contains("hidden")) {
                    e.preventDefault();
                    window.location.reload();
                }
            });
        });
    }

    // 鏍规嵁褰撳墠璁块棶鐨勪富鏈哄悕鑷姩鏍囨敞瀵瑰嬀锛堥粯璁や笉棰勮楂樹寒鑳屾櫙锛屼粎淇濈暀瀵瑰嬀鍙婇紶鏍囨偓鍋滄牱寮忥級
    function updateSiteSwitcherActive() {
        const hostname = window.location.hostname;
        const options = document.querySelectorAll("#site-switcher-container .site-option-item");
        let matchedOpt: Element | null = null;

        options.forEach((opt) => {
            const href = opt.getAttribute("href");
            if (href) {
                try {
                    const u = new URL(href, window.location.origin);
                    if (u.hostname === hostname) {
                        matchedOpt = opt;
                    }
                } catch {}
            }
        });

        // 榛樿鑻ユ湭绮惧噯鍖归厤鍒板叾浠栧煙鍚嶏紝鍒欏尮閰嶇涓€涓€夐」
        if (!matchedOpt && options.length > 0) {
            matchedOpt = options[0];
        }

        options.forEach((opt) => {
            const isCurrent = opt === matchedOpt;
            const checkIcon = opt.querySelector(".site-check-icon");
            const extIcon = opt.querySelector(".site-external-icon");

            if (isCurrent) {
                checkIcon?.classList.remove("hidden");
                extIcon?.classList.add("hidden");
            } else {
                checkIcon?.classList.add("hidden");
                extIcon?.classList.remove("hidden");
            }
        });
    }
    updateSiteSwitcherActive();

    document.addEventListener("click", function(event) {
        if (siteSwitcherContainer && siteSwitcherContainer.classList.contains("is-open")) {
            if (event.target instanceof Node && !siteSwitcherContainer.contains(event.target)) {
                siteSwitcherContainer.classList.remove("is-open");
                siteSwitcherBtn?.setAttribute("aria-expanded", "false");
            }
        }

        // nav-menu-panel 涓嶅啀璧扮偣鍑诲閮ㄥ叧闂細闈㈡澘鐜板湪瑕嗙洊鍏ㄥ睆锛坕nset-0锛夛紝浠绘剰鐐瑰嚮閮藉湪闈㈡澘鍐咃紝
        // 璇ョ洃鍚案涓嶈Е鍙戯紱鍏抽棴鐢辨娊灞夎嚜宸辩殑閬僵鐐瑰嚮/Document 濮旀墭璐熻矗銆?
        const panels = ["display-setting", "music-nav-panel", "theme-mode-panel"];
        const buttons = ["display-settings-switch", "music-player-switch", "scheme-switch"];

        panels.forEach((id, index) => {
            const panel = document.getElementById(id);
            const button = document.getElementById(buttons[index]);
            if (panel && button && !panel.classList.contains("float-panel-closed")) {
                if (event.target instanceof Node && !panel.contains(event.target) && !button.contains(event.target)) {
                    panel.classList.add("float-panel-closed");
                }
            }
        });
    });
}

loadButtonScript();

// 涓簊emifull妯″紡娣诲姞婊氬姩妫€娴嬮€昏緫
function initSemifullScrollDetection() {
    const navbar = document.getElementById('navbar');
    if (!navbar) return;

    const transparentMode = navbar.getAttribute('data-transparent-mode');
    if (transparentMode !== 'semifull') {
        navbar.style.removeProperty('--navbar-scroll-progress');
        navbar.style.removeProperty('--navbar-dynamic-blur');
        return;
    }

    // 鏃犺棣栭〉/闈為椤碉紝semifull 閮界敱婊氬姩浣嶇疆鍐冲畾鏄惁杩涘叆 scrolled 鐘舵€?
    // 鍏堢Щ闄や箣鍓嶇殑婊氬姩鐩戝惉鍣紝閬垮厤閲嶅缁戝畾
    if (window.semifullScrollHandler) {
        window.removeEventListener('scroll', window.semifullScrollHandler as () => void);
        window.semifullScrollHandler = undefined;
    }

    let ticking = false;
    let lastProgress = -1;

    // 鑾峰彇鐩爣妯＄硦鍊硷紙榛樿涓?20px锛?
    function getTargetBlur() {
        const raw = navbar!.style.getPropertyValue('--navbar-glass-blur');
        if (raw) return parseFloat(raw) || 20;
        const comp = getComputedStyle(navbar!).getPropertyValue('--navbar-glass-blur');
        return parseFloat(comp) || 20;
    }

    function updateNavbarState() {
        if (document.documentElement.classList.contains('is-page-transitioning')) {
            // 鍏ㄥ睆澹佺焊妯″紡锛氬垏鎹㈡湡闂翠繚鎸佸綋鍓?scrolled 鐘舵€侊紝閬垮厤鐐瑰嚮鐬棿瀵艰埅鏍忚儗鏅獊鐒舵秷澶?
            // 锛堝惁鍒欏鑸爮浼氶棯涓€涓嬮€忔槑銆佸垏瀹屽張鎭㈠鎴愬崱鐗囧簳鑹诧級锛涘叾浠栨ā寮忔部鐢ㄦ棫鐨勫己鍒堕€忔槑閫昏緫
            if (
                document.documentElement.getAttribute('data-wallpaper-mode') !==
                'fullscreen'
            ) {
                navbar!.classList.remove('scrolled');
                navbar!.style.setProperty('--navbar-scroll-progress', '0');
                navbar!.style.setProperty('--navbar-dynamic-blur', '0px');
                lastProgress = 0;
            }
            ticking = false;
            return;
        }

        const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        const maxScroll = 80; // 婊氬姩杩囨浮璺濈锛?px 鍒?80px 骞虫粦杩囨浮
        const rawProgress = Math.min(1, Math.max(0, scrollTop / maxScroll));
        const progress = Math.round(rawProgress * 1000) / 1000;

        // 浠呭湪杩涘害鍙戠敓寰皬鍙樺寲浠ヤ笂锛屾垨鍒拌揪杈圭晫 0 / 1 鏃舵洿鏂?DOM 灞炴€?
        if (
            Math.abs(progress - lastProgress) >= 0.005 ||
            (progress === 0 && lastProgress !== 0) ||
            (progress === 1 && lastProgress !== 1)
        ) {
            const targetBlur = getTargetBlur();
            const currentBlur = (progress * targetBlur).toFixed(1);
            navbar!.style.setProperty('--navbar-scroll-progress', progress.toString());
            navbar!.style.setProperty('--navbar-dynamic-blur', `${currentBlur}px`);
            lastProgress = progress;
        }

        // 淇濇寔 .scrolled 鐘舵€佸悓姝ワ紙甯︽粸鍚庨槻鎶栵級
        if (progress >= 0.95) {
            navbar!.classList.add('scrolled');
        } else if (progress <= 0.05) {
            navbar!.classList.remove('scrolled');
        }

        ticking = false;
    }

    function requestTick() {
        if (!ticking) {
            requestAnimationFrame(updateNavbarState);
            ticking = true;
        }
    }

    // 淇濆瓨鏂扮殑浜嬩欢澶勭悊鍣ㄥ紩鐢?
    window.semifullScrollHandler = requestTick as unknown as (() => void);

    // 鐩戝惉婊氬姩浜嬩欢
    window.addEventListener('scroll', requestTick, { passive: true });

    // 鍒濆鍖栫姸鎬?
    updateNavbarState();
}

// 灏嗗嚱鏁版毚闇插埌鍏ㄥ眬瀵硅薄锛屼緵椤甸潰鍒囨崲鏃惰皟鐢?
window.initSemifullScrollDetection = initSemifullScrollDetection;

// 椤甸潰鍔犺浇瀹屾垚鍚庡垵濮嬪寲婊氬姩妫€娴?
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSemifullScrollDetection);
} else {
    initSemifullScrollDetection();
}
</script>

{
    import.meta.env.PROD && (
        <script is:inline data-swup-ignore-script define:vars={{ scriptUrl: url('/pagefind/pagefind.js') }}>
            {/* 浣犵殑 loadPagefind 鍑芥暟鐨勫畬鏁村唴瀹规斁鍦ㄨ繖閲?*/}
            async function loadPagefind() {
                try {
                    const response = await fetch(scriptUrl, { method: 'HEAD' });
                    if (!response.ok) {
                        throw new Error(`Pagefind script not found: ${response.status}`);
                    }
                    const pagefind = await import(scriptUrl);
                    await pagefind.options({
                        excerptLength: 20
                    });
                    window.pagefind = pagefind;
                    document.dispatchEvent(new CustomEvent('pagefindready'));
                    console.log('Pagefind loaded and initialized successfully, event dispatched.');
                } catch (error) {
                    console.error('Failed to load Pagefind:', error);
                    window.pagefind = {
                        search: () => Promise.resolve({ results: [] }),
                        options: () => Promise.resolve(),
                    };
                    document.dispatchEvent(new CustomEvent('pagefindloaderror'));
                    console.log('Pagefind load error, event dispatched.');
                }
            }

            window.__loadPagefind = function () {
                if (!window.__pagefindLoading) window.__pagefindLoading = loadPagefind();
                return window.__pagefindLoading;
            };
        </script>
    )
}

