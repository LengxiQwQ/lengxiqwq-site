---
import { commentConfig } from "@/config";
import { KAOMOJI_LIST } from "@/constants/kaomoji";

interface Props {
	path: string;
}

const config = {
	...commentConfig.waline,
	el: "#waline",
	path: Astro.props.path,
	dark: "html.dark",
	...(commentConfig.waline?.visitorCount ? { pageview: true } : {}),
};
---
<!-- Waline -->
<div class="relative w-full">
  <div id="waline" data-path={Astro.props.path}></div>
  <link rel="stylesheet" href="https://unpkg.com/@waline/client@v3/dist/waline.css" />
  <script is:inline src="https://unpkg.com/@waline/client@v3/dist/waline.umd.js" defer></script>
  <script is:inline define:vars={{ config, KAOMOJI_LIST }}>
    function getCurrentPath() {
      const requestedPath = new URLSearchParams(window.location.search).get("path");
      let path = requestedPath;
      if (!path) {
        const el = document.getElementById("waline");
        if (el && el.getAttribute("data-path")) {
          path = el.getAttribute("data-path");
        }
      }
      if (!path) {
        path = decodeURIComponent(window.location.pathname);
      }
      return path && path.endsWith("/") && path.length > 1
        ? path.slice(0, -1)
        : path || "/";
    }

    function resetExifOrientation(app1Seg) {
      const tiffOffset = 10;
      if (app1Seg.length < tiffOffset + 8) return;
      const isLittle =
        app1Seg[tiffOffset] === 0x49 && app1Seg[tiffOffset + 1] === 0x49;
      const isBig =
        app1Seg[tiffOffset] === 0x4d && app1Seg[tiffOffset + 1] === 0x4d;
      if (!isLittle && !isBig) return;

      const view = new DataView(
        app1Seg.buffer,
        app1Seg.byteOffset,
        app1Seg.byteLength
      );
      const ifd0Offset = tiffOffset + view.getUint32(tiffOffset + 4, isLittle);
      if (ifd0Offset + 2 > app1Seg.length) return;

      const entryCount = view.getUint16(ifd0Offset, isLittle);
      for (let i = 0; i < entryCount; i++) {
        const entryOffset = ifd0Offset + 2 + i * 12;
        if (entryOffset + 12 > app1Seg.length) break;
        const tag = view.getUint16(entryOffset, isLittle);
        if (tag === 0x0112) {
          // Tag 0x0112 为 Orientation，将其数值重置为 1（正常正向），避免 Canvas 绘制后产生二次旋转歪斜
          view.setUint16(entryOffset + 8, 1, isLittle);
          break;
        }
      }
    }

    function extractExifSegments(arrayBuffer, isPng) {
      if (!arrayBuffer || arrayBuffer.byteLength < 16) return null;
      const view = new DataView(arrayBuffer);
      const segments = [];

      if (!isPng) {
        // JPEG 格式解析并提取 APP1 (EXIF: 0xFFE1) 与 APP2 (ICC 色彩空间: 0xFFE2)
        if (view.getUint16(0) !== 0xffd8) return null;
        let offset = 2;
        while (offset + 4 <= view.byteLength) {
          if (view.getUint8(offset) !== 0xff) break;
          const marker = view.getUint8(offset + 1);
          if (marker === 0xda || marker === 0xd9) break; // 遇到扫描起始 (SOS) 或图像结束 (EOI) 终止
          const length = view.getUint16(offset + 2);
          if (offset + 2 + length > view.byteLength) break;

          if (marker === 0xe1 || marker === 0xe2) {
            const seg = new Uint8Array(arrayBuffer, offset, 2 + length);
            segments.push(new Uint8Array(seg));
          }
          offset += 2 + length;
        }
      } else {
        // PNG 格式解析并提取 eXIf 块，封装为标准 JPEG APP1 标记
        if (view.getUint32(0) !== 0x89504e47) return null;
        let offset = 8;
        while (offset + 12 <= view.byteLength) {
          const length = view.getUint32(offset);
          const type = String.fromCharCode(
            view.getUint8(offset + 4),
            view.getUint8(offset + 5),
            view.getUint8(offset + 6),
            view.getUint8(offset + 7)
          );
          if (type === "eXIf" && offset + 8 + length <= view.byteLength) {
            const app1Len = length + 6 + 2;
            const app1 = new Uint8Array(app1Len + 2);
            app1[0] = 0xff;
            app1[1] = 0xe1;
            app1[2] = (app1Len >> 8) & 0xff;
            app1[3] = app1Len & 0xff;
            app1.set([0x45, 0x78, 0x69, 0x66, 0x00, 0x00], 4); // "Exif\0\0"
            app1.set(new Uint8Array(arrayBuffer, offset + 8, length), 10);
            segments.push(app1);
            break;
          }
          offset += 8 + length + 4;
        }
      }

      if (segments.length === 0) return null;

      // 校正 EXIF 中的 Orientation，防止双重旋转
      for (const seg of segments) {
        if (seg[0] === 0xff && seg[1] === 0xe1 && seg.length >= 18) {
          resetExifOrientation(seg);
        }
      }

      // 合并所有提取到的元数据标记
      const totalLen = segments.reduce((sum, s) => sum + s.length, 0);
      const merged = new Uint8Array(totalLen);
      let cur = 0;
      for (const s of segments) {
        merged.set(s, cur);
        cur += s.length;
      }
      return merged;
    }

    async function compressImageIfNeeded(file) {
      if (!file || typeof file !== "object") return file;

      // GIF 动图严格保持原样，绝不转码，以完整保留动图帧
      if (
        file.type === "image/gif" ||
        (file.name && file.name.toLowerCase().endsWith(".gif"))
      ) {
        return file;
      }

      const isPng =
        file.type === "image/png" ||
        (file.name && file.name.toLowerCase().endsWith(".png"));

      const isJpg =
        file.type === "image/jpeg" ||
        (file.name && /\.(jpe?g)$/i.test(file.name));

      // 仅处理 PNG 与 JPG，其他格式直接放行
      if (!isPng && !isJpg) {
        return file;
      }

      // 小于等于 300KB 的 PNG 直接保持原样（保留透明小图标、表情贴纸原貌）
      if (isPng && file.size <= 300 * 1024) {
        return file;
      }

      // 提取原图的 EXIF / ICC 拍摄参数元数据（相机型号、镜头、光圈快门、ISO、GPS等）
      let exifSegments = null;
      try {
        const arrayBuf = await file.arrayBuffer();
        exifSegments = extractExifSegments(arrayBuf, isPng);
      } catch (_) {}

      return new Promise((resolve) => {
        const objectUrl = URL.createObjectURL(file);
        const img = new Image();

        img.onload = () => {
          URL.revokeObjectURL(objectUrl);
          const width = img.naturalWidth || img.width;
          const height = img.naturalHeight || img.height;

          // 仅对超过 2K（2560×1440 框）的超大画幅进行等比缩减至 2K，较小画幅绝不缩放
          const isLandscape = width >= height;
          const maxW = isLandscape ? 2560 : 1440;
          const maxH = isLandscape ? 1440 : 2560;

          let targetWidth = width;
          let targetHeight = height;
          let needResize = false;

          if (width > maxW || height > maxH) {
            needResize = true;
            const scale = Math.min(maxW / width, maxH / height);
            targetWidth = Math.round(width * scale);
            targetHeight = Math.round(height * scale);
          }

          // 如果已是 JPG，且分辨率未超 2K 且体积在 1MB 内，直接放行原图无需二次重编码
          if (isJpg && !needResize && file.size <= 1024 * 1024) {
            file.__dimensions = { width, height };
            resolve(file);
            return;
          }

          const canvas = document.createElement("canvas");
          canvas.width = targetWidth;
          canvas.height = targetHeight;
          const ctx = canvas.getContext("2d");
          if (!ctx) {
            resolve(file);
            return;
          }

          // 关键细节：透明底 PNG 转 JPG 时，必须预先填充纯白背景，避免透明通道变黑
          ctx.fillStyle = "#ffffff";
          ctx.fillRect(0, 0, targetWidth, targetHeight);
          ctx.drawImage(img, 0, 0, targetWidth, targetHeight);

          // 输出高质量 JPG（质量 80%），并完整注入原图 EXIF/GPS 拍摄参数
          canvas.toBlob(
            async (blob) => {
              if (blob) {
                const baseName = (file.name || "image").replace(/\.[^/.]+$/, "");
                let finalBlob = blob;
                // 若原图含有 EXIF 拍摄元数据，规范回填到转码压缩后的 JPG 数据头部
                if (exifSegments && blob.size >= 6) {
                  try {
                    const headBuf = await blob.slice(0, 8).arrayBuffer();
                    const headView = new DataView(headBuf);
                    let insertOffset = 2; // 默认紧跟在 SOI (0xFFD8) 之后
                    // 若存在 APP0 (JFIF: 0xFFE0)，置于 APP0 之后，达成标准最佳兼容性
                    if (
                      headView.byteLength >= 6 &&
                      headView.getUint16(2) === 0xffe0
                    ) {
                      insertOffset = 4 + headView.getUint16(4);
                    }
                    if (insertOffset <= blob.size) {
                      finalBlob = new Blob(
                        [
                          blob.slice(0, insertOffset),
                          exifSegments,
                          blob.slice(insertOffset),
                        ],
                        { type: "image/jpeg" }
                      );
                    }
                  } catch (_) {}
                }
                const newFile = new File([finalBlob], `${baseName}.jpg`, {
                  type: "image/jpeg",
                  lastModified: Date.now(),
                });
                newFile.__dimensions = { width: targetWidth, height: targetHeight };
                resolve(newFile);
              } else {
                resolve(file);
              }
            },
            "image/jpeg",
            0.80
          );
        };

        img.onerror = () => {
          URL.revokeObjectURL(objectUrl);
          resolve(file);
        };

        img.src = objectUrl;
      });
    }

    async function uploadCommentImage(file) {
      const serverURL = (config && config.serverURL ? config.serverURL : "").replace(/\/+$/, "");
      if (!serverURL) {
        throw new Error("Waline serverURL 未配置");
      }

      // 获取待上传图片的初始像素宽高
      let dimensions = null;
      if (file && typeof file === "object") {
        try {
          dimensions = await new Promise((resolve) => {
            const objectUrl = URL.createObjectURL(file);
            const img = new Image();
            img.onload = () => {
              URL.revokeObjectURL(objectUrl);
              resolve({
                width: img.naturalWidth || img.width,
                height: img.naturalHeight || img.height,
              });
            };
            img.onerror = () => {
              URL.revokeObjectURL(objectUrl);
              resolve(null);
            };
            img.src = objectUrl;
          });
        } catch (_) {}
      }

      const processedFile = await compressImageIfNeeded(file);
      if (processedFile && processedFile.__dimensions) {
        dimensions = processedFile.__dimensions;
      }

      const formData = new FormData();
      formData.append("file", processedFile);

      const resp = await fetch(`${serverURL}/api/upload`, {
        method: "POST",
        body: formData,
      });

      if (!resp.ok) {
        let errMsg = "";
        try {
          const errJson = await resp.json();
          if (errJson && errJson.errmsg) {
            errMsg = errJson.errmsg;
          }
        } catch (_) {}
        if (!errMsg) {
          errMsg = await resp.text().catch(() => "");
        }
        throw new Error(errMsg || `图片上传失败 (${resp.status})`);
      }

      const res = await resp.json();
      if (res && res.errno === 0 && res.data && res.data.url) {
        let finalUrl = res.data.url;
        // 自动在图片链接后附加尺寸元数据哈希（#vw=W&vh=H），供渲染端无损预留宽高
        if (dimensions && dimensions.width && dimensions.height) {
          finalUrl = `${finalUrl}#vw=${dimensions.width}&vh=${dimensions.height}`;
        }
        return finalUrl;
      }
      throw new Error((res && res.errmsg) || "图片上传失败，请稍后重试");
    }

    function enhanceCommentImages(container) {
      const root = container || document.getElementById("waline");
      if (!root) return;

      const imgs = root.querySelectorAll(
        ".wl-content img:not(.wl-emoji):not(.vemoji):not([data-emoji]):not(.wl-bmoji)"
      );

      imgs.forEach((img) => {
        if (img.__enhancedLayout) return;
        img.__enhancedLayout = true;

        const src = img.getAttribute("src") || "";
        const match =
          src.match(/[#&]v?w=(\d+)&v?h=(\d+)/i) || src.match(/#(\d+)x(\d+)/i);

        if (match) {
          const w = parseInt(match[1], 10);
          const h = parseInt(match[2], 10);
          if (w > 0 && h > 0) {
            img.style.aspectRatio = `${w} / ${h}`;
            img.style.maxWidth = `${Math.min(w, 600)}px`;
            img.style.width = "100%";
          }
        }

        const applyNaturalDimensions = () => {
          if (img.naturalWidth && img.naturalHeight) {
            img.style.aspectRatio = `${img.naturalWidth} / ${img.naturalHeight}`;
            img.style.maxWidth = `${Math.min(img.naturalWidth, 600)}px`;
          }
        };

        if (!img.complete) {
          img.classList.add("wl-img-loading");
          img.addEventListener(
            "load",
            () => {
              img.classList.remove("wl-img-loading");
              img.classList.add("wl-img-loaded");
              applyNaturalDimensions();
            },
            { once: true }
          );
          img.addEventListener(
            "error",
            () => {
              img.classList.remove("wl-img-loading");
              img.classList.add("wl-img-error");
              // 错误兜底：严格保留 16:9 比例与外框骨架尺寸，绝不发生高度塌陷
            },
            { once: true }
          );
        } else {
          img.classList.add("wl-img-loaded");
          applyNaturalDimensions();
        }
      });
    }

    function renderCustomStickers(container) {
      const root = container || document.getElementById("waline");
      if (!root) return;

      const contents = root.querySelectorAll(".wl-content");
      contents.forEach((content) => {
        let html = content.innerHTML;
        let modified = false;

        // 1. 将评论正文或实时预览中的 :miku_01.png: 替换为实际贴纸图片
        if (html.includes(":miku_")) {
          html = html.replace(
            /:miku_(\d+)\.(png|gif):/gi,
            '<img class="wl-emoji" src="/assets/stickers/miku/miku_$1.$2" alt="miku_$1" loading="lazy" />'
          );
          modified = true;
        }

        // 2. 兼容历史转义的贴纸代码（如 <img class="wl-emoji" src="/assets/stickers/..." />）
        if (html.includes("&lt;img") && html.includes("stickers/")) {
          html = html.replace(
            /&lt;img\s+class=&quot;wl-emoji&quot;\s+src=&quot;([^&]+)&quot;\s+alt=&quot;([^&]+)&quot;&gt;/gi,
            '<img class="wl-emoji" src="$1" alt="$2" loading="lazy" />'
          );
          modified = true;
        }

        if (modified) {
          content.innerHTML = html;
        }
      });
    }

    function setupKaomoji(container) {
      const root = container || document.getElementById("waline");
      if (!root) return;

      // 全局点击监听（仅绑定一次）：点击外部时自动收起所有外置颜文字面板
      if (!window.__walineKaomojiGlobalInstalled) {
        window.__walineKaomojiGlobalInstalled = true;
        document.addEventListener("click", (e) => {
          if (
            e.target.closest(".wl-kaomoji-popup") ||
            e.target.closest(".wl-action-kaomoji")
          ) {
            return;
          }
          document
            .querySelectorAll(".wl-kaomoji-popup.display")
            .forEach((popup) => {
              popup.classList.remove("display");
            });
          document
            .querySelectorAll(".wl-action-kaomoji.active")
            .forEach((btn) => {
              btn.classList.remove("active");
            });
        });
      }

      const panels = root.querySelectorAll(".wl-panel");
      panels.forEach((panel) => {
        const actions = panel.querySelector(".wl-actions");
        if (!actions) return;

        // 1. 确保在 .wl-actions 工具栏中插入独立 [OωO] 按钮
        let kaomojiBtn = actions.querySelector(".wl-action-kaomoji");
        if (!kaomojiBtn) {
          kaomojiBtn = document.createElement("button");
          kaomojiBtn.type = "button";
          kaomojiBtn.className = "wl-action wl-action-kaomoji";
          kaomojiBtn.title = "颜文字 (OωO)";
          kaomojiBtn.setAttribute("aria-label", "颜文字");
          kaomojiBtn.innerHTML = '<span class="wl-action-kaomoji-text">OωO</span>';
          actions.appendChild(kaomojiBtn);
        }

        // 2. 确保在 .wl-panel 下挂载独立的 .wl-kaomoji-popup 面板（无分类菜单、无推荐条、一页平铺）
        let popup = panel.querySelector(".wl-kaomoji-popup");
        if (!popup) {
          popup = document.createElement("div");
          popup.className = "wl-kaomoji-popup";

          let contentHtml = '<div class="wl-kaomoji-content">';
          (KAOMOJI_LIST || []).forEach((item) => {
            contentHtml += `<button type="button" class="wl-kaomoji-item" data-kaomoji="${encodeURIComponent(item)}" title="${item}">${item}</button>`;
          });
          contentHtml += "</div>";

          popup.innerHTML = contentHtml;
          panel.appendChild(popup);

          // 颜文字点击：纯字符光标就地插入
          popup.addEventListener("click", (e) => {
            const itemBtn = e.target.closest(".wl-kaomoji-item");
            if (!itemBtn) return;
            e.stopPropagation();

            const encoded = itemBtn.getAttribute("data-kaomoji");
            const rawText = encoded
              ? decodeURIComponent(encoded)
              : itemBtn.textContent.trim();
            if (!rawText) return;

            const textarea =
              panel.querySelector(".wl-editor") ||
              panel.querySelector("textarea") ||
              document.getElementById("wl-edit");
            if (!textarea) return;

            textarea.focus();
            let success = false;
            try {
              success = document.execCommand("insertText", false, rawText);
            } catch (_) {
              success = false;
            }

            if (!success) {
              const start = textarea.selectionStart || 0;
              const end = textarea.selectionEnd || 0;
              const val = textarea.value || "";
              textarea.value = val.slice(0, start) + rawText + val.slice(end);
              textarea.selectionStart = textarea.selectionEnd =
                start + rawText.length;
            }

            textarea.dispatchEvent(new Event("input", { bubbles: true }));
            textarea.dispatchEvent(new Event("change", { bubbles: true }));

            itemBtn.classList.add("wl-kaomoji-picked");
            setTimeout(() => itemBtn.classList.remove("wl-kaomoji-picked"), 260);
          });
        }

        // 3. 点击独立按钮展开/收起颜文字面板，并与原生表情互斥
        if (!kaomojiBtn.__kaomojiListenerInstalled) {
          kaomojiBtn.__kaomojiListenerInstalled = true;
          kaomojiBtn.addEventListener("click", (e) => {
            e.stopPropagation();
            const isOpen = popup.classList.contains("display");
            if (isOpen) {
              popup.classList.remove("display");
              kaomojiBtn.classList.remove("active");
            } else {
              // 关闭当前面板或其他面板上的原生表情弹窗（联动 Vue 点击事件以同步其内部状态）
              const nativeEmojiBtn = actions.querySelector(
                'button[title*="Emoji"], button[title*="表情"]'
              );
              if (
                nativeEmojiBtn &&
                nativeEmojiBtn.classList.contains("active")
              ) {
                nativeEmojiBtn.click();
              }
              const nativeEmojiPopup = panel.querySelector(".wl-emoji-popup");
              if (nativeEmojiPopup) {
                nativeEmojiPopup.classList.remove("display");
              }

              // 关闭其他可能打开的颜文字弹窗
              document
                .querySelectorAll(".wl-kaomoji-popup.display")
                .forEach((p) => {
                  if (p !== popup) p.classList.remove("display");
                });
              document
                .querySelectorAll(".wl-action-kaomoji.active")
                .forEach((b) => {
                  if (b !== kaomojiBtn) b.classList.remove("active");
                });

              popup.classList.add("display");
              kaomojiBtn.classList.add("active");
            }
          });
        }

        // 4. 监听原生表情按钮点击时，自动关闭外置颜文字面板
        const nativeEmojiBtn = actions.querySelector(
          'button[title*="Emoji"], button[title*="表情"]'
        );
        if (nativeEmojiBtn && !nativeEmojiBtn.__kaomojiWatcherInstalled) {
          nativeEmojiBtn.__kaomojiWatcherInstalled = true;
          nativeEmojiBtn.addEventListener("click", () => {
            popup.classList.remove("display");
            kaomojiBtn.classList.remove("active");
            setTimeout(updateEmojiPopupStickerState, 30);
          });
        }
      });
    }

    function updateEmojiPopupStickerState(container) {
      const root = container || document.getElementById("waline");
      if (!root) return;
      const popups = root.querySelectorAll(".wl-emoji-popup");
      popups.forEach((popup) => {
        const hasSticker = !!popup.querySelector(
          '.wl-tab-wrapper img[src*="/assets/stickers/"]'
        );
        popup.classList.toggle("wl-tab-is-sticker", hasSticker);
      });
    }

    // 全局监听：当点击表情面板标签页切换（如 Bmoji 与 Miku 贴纸之间切换）时，实时标记状态
    if (!window.__walineTabWatcherInstalled) {
      window.__walineTabWatcherInstalled = true;
      document.addEventListener("click", (e) => {
        if (
          e.target.closest(".wl-tabs") ||
          e.target.closest('button[title*="Emoji"], button[title*="表情"]')
        ) {
          setTimeout(updateEmojiPopupStickerState, 30);
        }
      });
    }

    function initWaline() {
      const el = document.getElementById("waline");
      if (!el) {
        if (window.__walineInstance && typeof window.__walineInstance.destroy === "function") {
          try {
            window.__walineInstance.destroy();
          } catch (_) {}
          window.__walineInstance = null;
        }
        return;
      }

      const walineLib = window.Waline;
      if (!walineLib || typeof walineLib.init !== "function") {
        setTimeout(initWaline, 100);
        return;
      }

      const currentPath = getCurrentPath();
      if (el.getAttribute("data-initialized-path") === currentPath) {
        // 当前页面已在初始化或已初始化完成，直接执行目标定位与高亮，避免重复销毁重建
        scrollToHashTarget();
        return;
      }

      if (window.__walineInstance && typeof window.__walineInstance.destroy === "function") {
        try {
          window.__walineInstance.destroy();
        } catch (_) {}
        window.__walineInstance = null;
      }

      el.innerHTML = "";
      el.setAttribute("data-initialized-path", currentPath);

      const dynamicConfig = {
        ...config,
        el: "#waline",
        path: currentPath,
        imageUploader: config.imageUploader === false ? false : uploadCommentImage,
      };

      try {
        window.__walineInstance = walineLib.init(dynamicConfig);
        enhanceCommentImages(el);
        renderCustomStickers(el);
        setupKaomoji(el);
        scrollToHashTarget();

        // 异步初次渲染 CommentBox 兜底扫描
        let kaomojiAttempts = 0;
        const ensureKaomoji = () => {
          setupKaomoji(el);
          renderCustomStickers(el);
          if (kaomojiAttempts < 10) {
            kaomojiAttempts++;
            setTimeout(ensureKaomoji, 150);
          }
        };
        ensureKaomoji();

        // 监听评论区 DOM 变动（如拉取评论、分页、发表回复），及时唤醒 Fancybox 灯箱绑定与图片预留排版
        if (el && !el.__fancyboxObserverInstalled && window.MutationObserver) {
          el.__fancyboxObserverInstalled = true;
          let debounceTimer = null;
          const walineObserver = new MutationObserver((mutations) => {
            let hasAddedNode = false;
            for (const m of mutations) {
              if (m.addedNodes.length > 0) {
                hasAddedNode = true;
                break;
              }
            }
            if (hasAddedNode) {
              enhanceCommentImages(el);
              renderCustomStickers(el);
              setupKaomoji(el);
              updateEmojiPopupStickerState(el);
              if (debounceTimer) clearTimeout(debounceTimer);
              debounceTimer = setTimeout(() => {
                enhanceCommentImages(el);
                renderCustomStickers(el);
                setupKaomoji(el);
                updateEmojiPopupStickerState(el);
                document.dispatchEvent(new CustomEvent("waline:rendered"));
              }, 80);
            }
          });
          walineObserver.observe(el, { childList: true, subtree: true });
        }
      } catch (error) {
        console.error("[Waline] Init error:", error);
      }
    }

    let activeScrollController = null;

    function highlightAndScroll(el) {
      if (!el) return;

      // 如果已有正在执行的滚动高亮任务，先终止前一个
      if (activeScrollController) {
        activeScrollController.abort();
        activeScrollController = null;
      }

      const controller = {
        aborted: false,
        abort() {
          this.aborted = true;
          cleanup();
        },
      };
      activeScrollController = controller;

      let isGlowTriggered = false;
      let hasScrolled = false;
      let scrollDebounceTimer = null;
      let fallbackTimer = null;
      let realignAttempts = 0;
      let lastTargetTop = 0;

      const cleanup = () => {
        window.removeEventListener("scroll", onScroll);
        window.removeEventListener("scrollend", onScrollEnd);
        if (scrollDebounceTimer) clearTimeout(scrollDebounceTimer);
        if (fallbackTimer) clearTimeout(fallbackTimer);
      };

      const triggerGlow = () => {
        if (controller.aborted || isGlowTriggered) return;

        // 校验当前目标元素在视口中的垂直位置，确保其处于适宜的视口可视区域内
        const rect = el.getBoundingClientRect();
        const viewportHeight =
          window.innerHeight || document.documentElement.clientHeight;
        // 允许顶部避让导航栏（50px），底部不严重溢出视口
        const isWellPositioned =
          rect.top >= 50 && rect.top <= viewportHeight - 80;

        // 如果上方图片刚刚加载导致元素位移且尚未正对视口，允许最多平滑校准 2 次
        if (!isWellPositioned && realignAttempts < 2) {
          realignAttempts++;
          el.scrollIntoView({ behavior: "smooth", block: "center" });
          return;
        }

        isGlowTriggered = true;
        cleanup();

        try {
          sessionStorage.removeItem("waline-target-comment");
        } catch (_) {}

        if (!el || !el.isConnected) return;

        // 若评论存在子回复区域，精确计算底部避让距离，确保仅高亮本条评论自身
        const quoteEl = el.querySelector(":scope > .wl-card > .wl-quote");
        if (quoteEl) {
          el.style.setProperty(
            "--waline-highlight-bottom",
            `${quoteEl.offsetHeight + 14}px`,
          );
        } else {
          el.style.setProperty(
            "--waline-highlight-bottom",
            "calc(0.5em + 4px)",
          );
        }

        el.classList.remove("waline-highlight-target");
        void el.offsetWidth; // 触发 reflow 重置动画
        el.classList.add("waline-highlight-target");
        setTimeout(() => {
          el.classList.remove("waline-highlight-target");
        }, 3200);
      };

      // 滚动停止判定：现代浏览器首选原生 scrollend，同时兼容 80ms 滚动防抖兜底
      const onScrollEnd = () => {
        if (controller.aborted || isGlowTriggered) return;
        triggerGlow();
      };

      const onScroll = () => {
        hasScrolled = true;
        if (controller.aborted || isGlowTriggered) return;
        if (scrollDebounceTimer) clearTimeout(scrollDebounceTimer);
        scrollDebounceTimer = setTimeout(() => {
          triggerGlow();
        }, 80);
      };

      const start = async () => {
        if (controller.aborted) return;

        // 确保评论区内所有图片均已加上 16:9 骨架与尺寸元数据
        enhanceCommentImages();

        // 检索排在目标评论 el 之前的所有评论图片
        const walineRoot =
          document.getElementById("waline") || el.closest("#waline");
        let precedingImgs = [];
        if (walineRoot) {
          const allWalineImgs = Array.from(
            walineRoot.querySelectorAll(
              ".wl-content img:not(.wl-emoji):not(.vemoji):not([data-emoji]):not(.wl-bmoji)"
            )
          );
          precedingImgs = allWalineImgs.filter(
            (img) =>
              (img.compareDocumentPosition(el) &
                Node.DOCUMENT_POSITION_FOLLOWING) !== 0
          );
        }

        const pendingImgs = precedingImgs.filter((img) => !img.complete);

        // 如果上方有未加载完成的图片，极速等待其加载（上限 350ms，缓存图通常数十毫秒即可就绪）
        if (pendingImgs.length > 0) {
          const waitPromises = pendingImgs.map(
            (img) =>
              new Promise((resolve) => {
                if (img.complete) return resolve();
                img.addEventListener("load", resolve, { once: true });
                img.addEventListener("error", resolve, { once: true });
              })
          );
          await Promise.race([
            Promise.all(waitPromises),
            new Promise((resolve) => setTimeout(resolve, 350)),
          ]);
        }

        if (controller.aborted) return;

        // 注册对上方图片的后续加载监听，一旦慢速图片延迟加载导致高度位移，立即平滑校准一次位置
        const realignIfNeeded = () => {
          if (controller.aborted || isGlowTriggered) return;
          const currentTargetTop =
            el.getBoundingClientRect().top + window.scrollY;
          if (Math.abs(currentTargetTop - lastTargetTop) > 10) {
            lastTargetTop = currentTargetTop;
            el.scrollIntoView({ behavior: "smooth", block: "center" });
          }
        };

        precedingImgs.forEach((img) => {
          if (!img.complete) {
            img.addEventListener("load", realignIfNeeded, { once: true });
            img.addEventListener("error", realignIfNeeded, { once: true });
          }
        });

        window.addEventListener("scroll", onScroll, { passive: true });
        if ("onscrollend" in window) {
          window.addEventListener("scrollend", onScrollEnd, { passive: true });
        }

        // 记录起始绝对 Y 坐标并执行平滑滚动定位到评论卡片中央
        lastTargetTop = el.getBoundingClientRect().top + window.scrollY;
        el.scrollIntoView({ behavior: "smooth", block: "center" });

        // 兜底：若目标本来就在视口中央无需滚动（未触发 scroll 事件），150ms 后直接判定高亮
        fallbackTimer = setTimeout(() => {
          if (!hasScrolled && !isGlowTriggered) {
            triggerGlow();
          }
        }, 150);
      };

      // 检查 Swup 页面过渡状态：若切页过渡中，等待过渡彻底完成并回流提交后再滚动
      if (document.documentElement.classList.contains("is-page-transitioning")) {
        const transObserver = new MutationObserver(() => {
          if (!document.documentElement.classList.contains("is-page-transitioning")) {
            transObserver.disconnect();
            setTimeout(start, 50);
          }
        });
        transObserver.observe(document.documentElement, {
          attributes: true,
          attributeFilter: ["class"],
        });
        setTimeout(() => {
          transObserver.disconnect();
          start();
        }, 400);
      } else {
        start();
      }
    }

    function scrollToHashTarget(explicitTargetId) {
      let targetId = explicitTargetId;
      if (!targetId) {
        try {
          targetId = sessionStorage.getItem("waline-target-comment");
        } catch (_) {}
      }
      if (!targetId) {
        const hash = window.location.hash;
        if (hash) {
          targetId = decodeURIComponent(hash.slice(1));
        }
      }
      if (!targetId) return;
      targetId = String(targetId).replace(/^#/, "").trim();
      if (!targetId) return;

      const commentCard =
        document.getElementById("post-comments") ||
        document.getElementById("waline");

      if (targetId === "post-comments" || targetId === "waline") {
        if (commentCard) {
          setTimeout(() => {
            commentCard.scrollIntoView({ behavior: "smooth", block: "start" });
          }, 150);
        }
        return;
      }

      const findTargetEl = (id) => {
        if (!id) return null;
        const cleanId = String(id).replace(/^#/, "").trim();
        if (!cleanId) return null;
        return (
          document.getElementById(cleanId) ||
          document.getElementById(`wl-${cleanId}`) ||
          document.getElementById(`waline-${cleanId}`) ||
          document.getElementById(`comment-${cleanId}`) ||
          document.querySelector(`.wl-card-item[id="${cleanId}"]`) ||
          document.querySelector(`.wl-card-item[data-id="${cleanId}"]`) ||
          document.querySelector(`[data-waline-id="${cleanId}"]`)
        );
      };

      enhanceCommentImages();
      const existingEl = findTargetEl(targetId);
      if (existingEl) {
        highlightAndScroll(existingEl);
        return;
      }

      // Waline 评论卡片为异步加载渲染，使用 MutationObserver + 轮询兜底
      let timer = null;
      let observer = null;

      const cleanupPolling = () => {
        if (timer) {
          clearInterval(timer);
          timer = null;
        }
        if (observer) {
          observer.disconnect();
          observer = null;
        }
      };

      const checkTarget = () => {
        enhanceCommentImages(walineEl);
        const el = findTargetEl(targetId);
        if (el) {
          cleanupPolling();
          highlightAndScroll(el);
          return true;
        }
        return false;
      };

      const walineEl = document.getElementById("waline");
      if (walineEl && window.MutationObserver) {
        observer = new MutationObserver(() => {
          checkTarget();
        });
        observer.observe(walineEl, { childList: true, subtree: true });
      }

      let attempts = 0;
      timer = setInterval(() => {
        attempts++;
        if (checkTarget() || attempts > 100) {
          cleanupPolling();
        }
      }, 100);
    }

    window.__initWaline = initWaline;
    window.__scrollToWalineComment = scrollToHashTarget;

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initWaline);
    } else {
      initWaline();
    }

    if (!window.__walineListenersInstalled) {
      window.__walineListenersInstalled = true;

      const triggerRefresh = () => {
        if (typeof window.__initWaline === "function") {
          window.__initWaline();
        }
      };

      if (window.swup && window.swup.hooks) {
        window.swup.hooks.on("page:view", triggerRefresh);
        window.swup.hooks.on("visit:end", triggerRefresh);
        window.swup.hooks.on("content:replace", triggerRefresh);
      } else {
        document.addEventListener("swup:enable", () => {
          if (window.swup && window.swup.hooks) {
            window.swup.hooks.on("page:view", triggerRefresh);
            window.swup.hooks.on("visit:end", triggerRefresh);
            window.swup.hooks.on("content:replace", triggerRefresh);
          }
        });
      }

      document.addEventListener("firefly:page:loaded", triggerRefresh);
      document.addEventListener("astro:page-load", triggerRefresh);
      window.addEventListener("hashchange", () => scrollToHashTarget());
      window.addEventListener("waline:scroll-to-comment", (e) => {
        if (e && e.detail && e.detail.id) {
          scrollToHashTarget(e.detail.id);
        }
      });
    }
  </script>
</div>

