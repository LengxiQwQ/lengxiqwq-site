---
import { commentConfig } from "@/config/commentConfig";
import { url } from "@/utils/url-utils";

interface Props {
	path: string;
}

const twikooConfig = commentConfig.twikoo ?? { envId: "" };
const jsUrl =
	twikooConfig.jsUrl ||
	"https://registry.npmmirror.com/twikoo/1.7.13/files/dist/twikoo.min.js";
const cssUrl = twikooConfig.cssUrl;
const config = {
	...twikooConfig,
	el: "#tcomment",
	path: Astro.props.path,
};
---

<form id="twikoo-form" class="twikoo-form" onsubmit="return false;" autocomplete="on" method="post" action="javascript:void(0);">
  <div id="tcomment"></div>
</form>
<script is:inline src={jsUrl} defer></script>
{cssUrl && <link rel="stylesheet" href={cssUrl.startsWith("http") ? cssUrl : url(cssUrl)} />}
<script is:inline define:vars={{ config }}>
  // 1. 拦截 Twikoo 子回复输入框挂载时的 scrollIntoView 调用，防止视口被强行滚动到页面顶部
  if (!window.__twikooScrollHookInstalled) {
    window.__twikooScrollHookInstalled = true;
    const originalScrollIntoView = Element.prototype.scrollIntoView;
    Element.prototype.scrollIntoView = function (...args) {
      if (
        this instanceof Element &&
        (this.classList?.contains("tk-submit") || this.closest?.(".tk-submit")) &&
        this.closest?.(".tk-comment")
      ) {
        // 子回复框挂载在具体评论下，此时评论本身已在视口，坚决不执行任何跳转滚动
        return;
      }
      return originalScrollIntoView.apply(this, args);
    };

    // 全局捕获阶段拦截回复按钮点击，锁定当前滚动高度，双重保险杜绝页面跳动
    document.addEventListener(
      "click",
      function (e) {
        const target = e.target;
        if (!target || !(target instanceof Element)) return;
        const actionBtn = target.closest(".twikoo .tk-action-link, .twikoo-form .tk-action-link, #twikoo .tk-action-link");
        if (actionBtn) {
          const savedY = window.scrollY;
          const pinScroll = function () {
            if (Math.abs(window.scrollY - savedY) > 5) {
              window.scrollTo({ top: savedY, behavior: "instant" });
            }
          };
          requestAnimationFrame(pinScroll);
          setTimeout(pinScroll, 20);
          setTimeout(pinScroll, 60);
          setTimeout(pinScroll, 150);
          setTimeout(pinScroll, 300);
        }
      },
      true
    );
  }

  // 2. 增强 Twikoo 输入框支持系统 / 浏览器原生自动填充（Autofill & Autocomplete）
  // 必须将 prepend 元素转换为标准 <label for="...">，Chrome / Edge 才能将其识别为有效联系人表单并弹出建议
  function enhanceInputGroup(inputGroup) {
    if (inputGroup.dataset.autofillReady) return; // 严格单次执行，杜绝重复替换与循环 Mutation
    inputGroup.dataset.autofillReady = "1";

    const input = inputGroup.querySelector("input");
    const prepend = inputGroup.querySelector(".el-input-group__prepend");
    if (!input) return;

    const labelText = (prepend ? prepend.textContent : "") || "";
    const name = input.getAttribute("name") || "";
    const placeholder = input.getAttribute("placeholder") || "";
    const isSubReply = !!inputGroup.closest(".tk-comment");
    const idPrefix = isSubReply ? "tk-sub-" + Date.now().toString(36) + "-" : "twikoo-";

    let fieldType = "";
    if (
      name === "mail" ||
      name === "email" ||
      input.type === "email" ||
      labelText.includes("邮箱") ||
      placeholder.includes("邮箱")
    ) {
      fieldType = "email";
    } else if (
      name === "nick" ||
      name === "nickname" ||
      labelText.includes("昵称") ||
      placeholder.includes("昵称")
    ) {
      fieldType = "nickname";
    } else if (
      name === "link" ||
      name === "url" ||
      labelText.includes("网址") ||
      placeholder.includes("网址")
    ) {
      fieldType = "url";
    }

    if (!fieldType) return;

    const inputId = idPrefix + fieldType;
    input.id = inputId;

    if (fieldType === "email") {
      input.setAttribute("autocomplete", "email");
      input.setAttribute("name", "email");
      input.setAttribute("type", "email");
      input.setAttribute("inputmode", "email");
      input.setAttribute("autocapitalize", "off");
      input.setAttribute("spellcheck", "false");
    } else if (fieldType === "nickname") {
      input.setAttribute("autocomplete", "nickname");
      input.setAttribute("name", "nickname");
    } else if (fieldType === "url") {
      input.setAttribute("autocomplete", "url");
      input.setAttribute("name", "url");
      input.setAttribute("type", "url");
      input.setAttribute("inputmode", "url");
    }

    // 将非标准的 div.prepend 转为标准 HTML5 <label for="inputId">
    if (prepend && prepend.tagName !== "LABEL") {
      const label = document.createElement("label");
      label.className = prepend.className;
      label.innerHTML = prepend.innerHTML;
      label.htmlFor = inputId;
      prepend.parentNode.replaceChild(label, prepend);
    }

    // 自动填充联动：当用户从浏览器下拉选中项时，驱动 Vue 数据模型双向同步
    if (!input.__twikooEnhanced) {
      input.__twikooEnhanced = true;
      const syncModel = function () {
        input.dispatchEvent(new Event("input", { bubbles: true }));
        input.dispatchEvent(new Event("change", { bubbles: true }));
      };
      input.addEventListener("change", syncModel);
      input.addEventListener("blur", syncModel);
      input.addEventListener("animationstart", function (e) {
        if (e.animationName && e.animationName.toLowerCase().includes("autofill")) {
          syncModel();
        }
      });
    }
  }

  function enhanceAllTwikooInputs() {
    const root = document.getElementById("tcomment") || document.getElementById("twikoo-form");
    if (!root) return;
    const groups = root.querySelectorAll(".el-input-group:not([data-autofill-ready])");
    groups.forEach(enhanceInputGroup);
  }

  // 3. 动态监听 Twikoo DOM 节点变动（只在评论容器内精准监听子树添加，已增强项会直接跳过）
  let twikooObserver = null;
  function cleanupTwikooObserver() {
    if (twikooObserver) {
      twikooObserver.disconnect();
      twikooObserver = null;
    }
  }

  function setupTwikooObserver() {
    cleanupTwikooObserver();
    const commentEl = document.getElementById("tcomment");
    if (!commentEl) return;

    twikooObserver = new MutationObserver(function () {
      enhanceAllTwikooInputs();
    });
    twikooObserver.observe(commentEl, {
      childList: true,
      subtree: true,
    });
    enhanceAllTwikooInputs();
  }

  // 点击评论区时进行就绪保障（仅限 #tcomment 容器内部委托，绝不监听全局 document）
  function setupTwikooPointerHook() {
    const container = document.getElementById("tcomment") || document.getElementById("twikoo-form");
    if (!container || container.__twikooHookInstalled) return;
    container.__twikooHookInstalled = true;
    container.addEventListener(
      "pointerdown",
      function (e) {
        const target = e.target;
        if (target && target instanceof Element && target.closest(".tk-meta-input")) {
          enhanceAllTwikooInputs();
        }
      },
      true
    );
  }

  // 获取当前页面路径
  function getCurrentPath() {
    const requestedPath = new URLSearchParams(window.location.search).get("path");
    if (requestedPath) return requestedPath;
    const pathname = window.location.pathname;
    return pathname.endsWith("/") && pathname.length > 1
      ? pathname.slice(0, -1)
      : pathname;
  }

  // 动态创建配置对象
  function createTwikooConfig() {
    return {
      ...config,
      path: getCurrentPath(),
      el: "#tcomment",
    };
  }

  // 初始化 Twikoo
  function initTwikoo() {
    const container = document.getElementById("tcomment");
    if (!container) {
      cleanupTwikooObserver();
      return;
    }

    setupTwikooPointerHook();

    if (typeof twikoo !== "undefined") {
      const dynamicConfig = createTwikooConfig();
      console.log("[Twikoo] Init config:", dynamicConfig);

      twikoo
        .init(dynamicConfig)
        .then(() => {
          console.log("[Twikoo] Init complete");
          setupTwikooObserver();
        })
        .catch((error) => {
          console.error("[Twikoo] Init failed:", error);
        });
    } else {
      // 如果 Twikoo 脚本未加载完成，延迟重试一次
      setTimeout(initTwikoo, 300);
    }
  }

  // 页面加载时初始化
  document.addEventListener("DOMContentLoaded", initTwikoo);

  // Swup 页面切换适配：离开时清理 observer，切入后重新初始化
  const onSwupContentReplace = function () {
    cleanupTwikooObserver();
    if (document.getElementById("tcomment")) {
      setTimeout(initTwikoo, 150);
    }
  };

  if (window.swup && window.swup.hooks) {
    window.swup.hooks.on("content:replace", onSwupContentReplace);
  } else {
    document.addEventListener("swup:enable", function () {
      if (window.swup && window.swup.hooks) {
        window.swup.hooks.on("content:replace", onSwupContentReplace);
      }
    });
  }

  // 自定义事件监听
  document.addEventListener("firefly:page:loaded", function () {
    const container = document.getElementById("twikoo-form") || document.getElementById("tcomment");
    if (container) {
      console.log("[Twikoo] Re-initializing via custom event");
      initTwikoo();
    }
  });
</script>
