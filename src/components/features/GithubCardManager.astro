---
// GitHub 卡片与 Star 徽章客户端管理器
//
// 构建期只在 github-card-data.json 里缓存「静态兜底信息」（description / language /
// avatarUrl / license / stars / forks），forks / stars 由浏览器运行时向 api.github.com 请求一次，
// 写入 localStorage 缓存（24h 过期后重新请求）；请求失败则回退到构建期的静态信息。
// 复用 markdown-extend.styl 里已存在的 .fetch-waiting / .fetch-error / pulsate 状态样式。
---
<script>
  import { formatCount } from "@/utils/github-card-utils";

  const CACHE_KEY_PREFIX = "github-card:";
  const CACHE_TTL = 24 * 60 * 60 * 1000; // 24h

  interface GithubApiRepo {
    description: string | null;
    language: string | null;
    forks: number;
    stargazers_count: number;
    owner?: { avatar_url?: string };
    license?: { spdx_id?: string } | null;
  }

  // 一次会话内每个 repo 只做一次请求：inflight 去重并发，done 防止 Swup 切页重复请求
  const inflight = new Map<string, Promise<GithubApiRepo | null>>();
  const done = new Set<string>();

  function cacheKey(repo: string): string {
    return CACHE_KEY_PREFIX + repo.toLowerCase();
  }

  function readCache(repo: string): GithubApiRepo | null {
    try {
      const raw = localStorage.getItem(cacheKey(repo));
      if (!raw) return null;
      const entry = JSON.parse(raw) as {
        data?: GithubApiRepo;
        fetchedAt?: number;
      };
      const data = entry.data;
      if (!data || typeof entry.fetchedAt !== "number") return null;
      if (typeof data.stargazers_count !== "number" || typeof data.forks !== "number")
        return null;
      if (Date.now() - entry.fetchedAt >= CACHE_TTL) return null;
      return data;
    } catch {
      return null;
    }
  }

  function writeCache(repo: string, data: GithubApiRepo): void {
    try {
      localStorage.setItem(
        cacheKey(repo),
        JSON.stringify({ data, fetchedAt: Date.now() }),
      );
    } catch {
      // 隐私模式 / 配额失败时静默跳过，不影响卡片渲染
    }
  }

  async function fetchRepo(repo: string): Promise<GithubApiRepo> {
    const [owner, name] = repo.split("/");
    const url = `https://api.github.com/repos/${encodeURIComponent(owner)}/${encodeURIComponent(name)}`;
    const response = await fetch(url, {
      referrerPolicy: "no-referrer",
      signal: AbortSignal.timeout(5000),
    });
    if (!response.ok) {
      throw new Error(`GitHub API returned ${response.status}`);
    }
    return (await response.json()) as GithubApiRepo;
  }

  function applyDataToCard(card: Element, data: GithubApiRepo): void {
    const setText = (selector: string, value: string) => {
      const el = card.querySelector(selector);
      if (el) el.textContent = value;
    };

    setText(".gc-stars", formatCount(data.stargazers_count));
    setText(".gc-forks", formatCount(data.forks));
    setText(
      ".gc-description",
      data.description?.replace(/:[a-zA-Z0-9_]+:/g, "") || "Description not set",
    );
    setText(".gc-language", data.language ?? "Unavailable");
    setText(".gc-license", data.license?.spdx_id || "no-license");

    const avatar = card.querySelector<HTMLElement>(".gc-avatar");
    if (avatar && data.owner?.avatar_url) {
      const avatarUrl = data.owner.avatar_url;
      avatar.style.backgroundImage = `url("${avatarUrl}${avatarUrl.includes("?") ? "&" : "?"}s=32")`;
      avatar.style.backgroundColor = "transparent";
    }

    card.classList.remove("fetch-waiting", "fetch-error");
  }

  function applyDataToStarButton(btn: Element, data: GithubApiRepo): void {
    const countEl = btn.querySelector(".github-star-count");
    if (countEl) {
      countEl.textContent = formatCount(data.stargazers_count);
    }
  }

  function applyData(repoKey: string, data: GithubApiRepo): void {
    document
      .querySelectorAll<HTMLElement>(".card-github[repo]")
      .forEach((card) => {
        if (card.getAttribute("repo")?.toLowerCase() === repoKey) {
          applyDataToCard(card, data);
        }
      });
    document
      .querySelectorAll<HTMLElement>(`[data-github-star-repo="${repoKey}"]`)
      .forEach((btn) => {
        applyDataToStarButton(btn, data);
      });
  }

  function getBuildStars(repoKey: string): number | null {
    const btn = document.querySelector<HTMLElement>(
      `[data-github-star-repo="${repoKey}"][data-build-stars]`,
    );
    if (!btn) return null;
    const raw = btn.getAttribute("data-build-stars");
    if (raw === null || raw === "") return null;
    const parsed = Number(raw);
    return Number.isFinite(parsed) ? parsed : null;
  }

  function enhanceRepo(repo: string): void {
    const key = repo.toLowerCase();
    const cached = readCache(key);
    const buildStars = getBuildStars(key);

    if (cached) {
      // 若构建期获取到的 Star 数量比浏览器本地缓存还要大（说明站点重新构建且数据更新了），
      // 则优先使用构建期的最新值更新展示和缓存；
      // 反之，若超过 24h 缓存自然过期，或未来向 API 重新请求后，数据无论增减都会精准以 API 结果为准。
      if (buildStars !== null && buildStars > cached.stargazers_count) {
        cached.stargazers_count = buildStars;
        writeCache(key, cached);
      }
      applyData(key, cached);
      return;
    }

    if (done.has(key)) return; // 本会话已尝试过且失败，保留构建兜底
    let promise = inflight.get(key);
    if (!promise) {
      promise = fetchRepo(repo)
        .then((data) => {
          writeCache(key, data);
          return data;
        })
        .catch((error) => {
          console.warn("[GITHUB-CARD] Failed to load", repo, error);
          return null;
        })
        .finally(() => {
          inflight.delete(key);
          done.add(key);
        });
      inflight.set(key, promise);
    }

    promise.then((data) => {
      if (data) {
        applyData(key, data);
      } else {
        document
          .querySelectorAll<HTMLElement>(".card-github[repo]")
          .forEach((card) => {
            if (card.getAttribute("repo")?.toLowerCase() === key) {
              card.classList.add("fetch-error");
            }
          });
      }
    });
  }

  function enhanceElements(): void {
    const repos = new Set<string>();

    document
      .querySelectorAll<HTMLElement>(".card-github[repo]")
      .forEach((card) => {
        const repo = card.getAttribute("repo");
        if (repo) repos.add(repo);
      });

    document
      .querySelectorAll<HTMLElement>("[data-github-star-repo]")
      .forEach((btn) => {
        const repo = btn.getAttribute("data-github-star-repo");
        if (repo) repos.add(repo);
      });

    repos.forEach((repo) => enhanceRepo(repo));
  }

  function init(): void {
    enhanceElements();
    document.addEventListener("swup:content:replace", () => {
      requestAnimationFrame(enhanceElements);
    });
    document.addEventListener("password:decrypted", () => {
      requestAnimationFrame(enhanceElements);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>
