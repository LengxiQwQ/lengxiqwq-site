---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import Comment from "@/components/comment/index.astro";
import DynamicItem from "@/components/pages/dynamic/DynamicItem.astro";
import { commentConfig, dynamicConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import "@/styles/markdown.css";
import "@/styles/markdown-extend.styl";
import "@/styles/pages/common.css";
import "@/styles/pages/dynamic.css";
import "@fancyapps/ui/dist/fancybox/fancybox.css";
import "@/styles/fancybox-custom.css";
import { formatDynamicDate } from "@/utils/date-utils";
import { dynamicPlainText, dynamicSlug } from "@/utils/dynamic-utils";
import { url } from "@/utils/url-utils";

if (!siteConfig.pages.dynamic) {
	return Astro.redirect("/404/");
}

export async function getStaticPaths() {
	const dynamics = await getCollection("dynamic");
	return dynamics
		.filter((entry) => dynamicSlug(entry.id) !== "comments")
		.map((entry) => ({
			params: { slug: dynamicSlug(entry.id) },
			props: { entry },
		}));
}

const { entry } = Astro.props;
const slug = dynamicSlug(entry.id);
const plainText = dynamicPlainText(entry);
const published = formatDynamicDate(entry.data.published);
const pageTitle = plainText
	? `${plainText.slice(0, 30)}${plainText.length > 30 ? "..." : ""} - ${i18n(I18nKey.dynamic)}`
	: `${i18n(I18nKey.dynamic)} - ${published}`;
const pageDescription =
	plainText.slice(0, 150) ||
	dynamicConfig.description ||
	i18n(I18nKey.dynamicDescription);

const showComments = Boolean(
	dynamicConfig.showComment !== false &&
		commentConfig.type &&
		commentConfig.type !== "none",
);
const currentUrl = url(`/dynamic/${slug}/`);
---

<MainGridLayout title={pageTitle} description={pageDescription}>
	<section class="page-shell" aria-labelledby="dynamic-detail-title">
		<header class="page-header card-base">
			<div class="page-heading">
				<a
					href={url(`/dynamic/#dynamic-${slug.replace(/[^a-zA-Z0-9_-]/g, "-")}`)}
					class="btn-plain flex items-center gap-1.5 text-sm text-(--primary) hover:underline font-medium transition-colors"
					aria-label={i18n(I18nKey.dynamicBackToList)}
					data-dynamic-back-btn
				>
					<Icon name="material-symbols:arrow-back-rounded" class="text-base" />
					<span>{i18n(I18nKey.dynamicBackToList)}</span>
				</a>
			</div>
			<div class="page-count" aria-label={i18n(I18nKey.dynamic)}>
				<Icon name="material-symbols:dynamic-feed-rounded" />
				<span>{published}</span>
			</div>
		</header>

		<div class="page-feed mb-4">
			<DynamicItem
				entry={entry}
				detailUrl={currentUrl}
				showInlineComments={false}
			/>
		</div>

		{showComments && (
			<div class="mt-4">
				<Comment customPath={`/dynamic/${slug}`} title={pageTitle} />
			</div>
		)}
	</section>
</MainGridLayout>

<script>
	import { registerDynamicGallery } from "@/components/pages/dynamic/dynamic-gallery";
	registerDynamicGallery();

	// 记录返回锚点
	const backBtn = document.querySelector<HTMLAnchorElement>("[data-dynamic-back-btn]");
	backBtn?.addEventListener("click", () => {
		const targetSlug = backBtn.getAttribute("href")?.split("#")[1];
		if (targetSlug) {
			try {
				sessionStorage.setItem("last-dynamic-anchor", targetSlug);
			} catch {}
		}
	});

	// 平滑滚动至评论区（消除跨页跳转与滚动抽搐）
	function initScrollToComment() {
		const shouldScroll =
			window.location.search.includes("to=comment") ||
			window.location.hash === "#post-comments" ||
			sessionStorage.getItem("dynamic-scroll-to-comment") === "true";

		if (!shouldScroll) return;
		try {
			sessionStorage.removeItem("dynamic-scroll-to-comment");
		} catch {}

		// 等待进场过渡完全稳定（约 280ms），再触发平滑滚动
		setTimeout(() => {
			const commentSection = document.getElementById("post-comments");
			if (commentSection) {
				commentSection.scrollIntoView({ behavior: "smooth", block: "start" });
				if (window.location.hash !== "#post-comments") {
					history.replaceState(history.state, "", "#post-comments");
				}
				setTimeout(() => {
					const input = commentSection.querySelector<HTMLTextAreaElement | HTMLInputElement>(
						"textarea, input[type='text'], .wl-editor",
					);
					input?.focus();
				}, 350);
			}
		}, 280);
	}

	initScrollToComment();
	document.addEventListener("swup:page:view", initScrollToComment);
</script>
