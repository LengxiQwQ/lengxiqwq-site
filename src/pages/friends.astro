---
import { getEntry, render } from "astro:content";
import Comment from "@components/comment/index.astro";
import Markdown from "@components/common/Markdown.astro";
import { Icon } from "astro-icon/components";
import {
	commentConfig,
	friendsPageConfig,
	getHealthyFriends,
	getQuarantinedFriends,
	siteConfig,
} from "@/config";
import { friendsConfig } from "@/config/friendsConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import "@/styles/pages/common.css";
import "@/styles/pages/friends.css";

// 检查页面是否启用
if (!siteConfig.pages.friends) {
	return Astro.redirect("/404/");
}

const friendsPost = await getEntry("spec", "friends");

if (!friendsPost) {
	throw new Error("friends page content not found");
}

const { Content } = await render(friendsPost);

// 检查评论系统是否启用
const isCommentEnabled =
	commentConfig?.type &&
	commentConfig.type !== "none" &&
	friendsPageConfig.showComment !== false;

// 使用健康检测后的友链数据，按权重排序
const items = getHealthyFriends();
const quarantinedItems = getQuarantinedFriends();
const allTags = [...new Set(items.flatMap((item) => item.tags || []))].sort();

// 记录配置文件中每个友链的原始添加次序，确保时间排序时 100% 忠实还原配置文件的添加顺序
const configOrderMap = new Map(
	(friendsConfig || []).map((item, idx) => [item.siteurl, idx]),
);

// 页面标题和描述
const title = friendsPageConfig.title || i18n(I18nKey.friends);
const description =
	friendsPageConfig.description || i18n(I18nKey.friendsDescription);

// 分区逻辑：定义分区顺序与元信息（博客在最前，导航在下，并可平滑支持未来新增分类）
const defaultSectionOrder = ["博客", "导航"];

const sectionMeta: Record<
	string,
	{ title: string; icon: string; desc?: string }
> = {
	博客: {
		title: "博客",
		icon: "material-symbols:book-2-outline",
		desc: "博主小伙伴们的自留地",
	},
	导航: {
		title: "导航",
		icon: "material-symbols:explore-outline",
		desc: "实用在线工具与推荐站点",
	},
};

// 提取并划分各分区
const sectionsMap = new Map<string, typeof items>();
for (const sec of defaultSectionOrder) {
	sectionsMap.set(sec, []);
}

for (const item of items) {
	// 优先匹配 tags 中的已知分类（如 博客、导航 等），否则取第一个 tag 或 博客
	const primaryTag =
		item.tags?.find((t) => defaultSectionOrder.includes(t)) ||
		item.tags?.[0] ||
		"博客";
	if (!sectionsMap.has(primaryTag)) {
		sectionsMap.set(primaryTag, []);
	}
	sectionsMap.get(primaryTag)?.push(item);
}

// 过滤出有卡片的分区并保持预设顺序
const sections = Array.from(sectionsMap.entries())
	.filter(([_, list]) => list.length > 0)
	.map(([name, list]) => ({
		name,
		meta: sectionMeta[name] || {
			title: name,
			icon: "material-symbols:folder-outline",
			desc: "",
		},
		items: list,
	}));
---

<MainGridLayout title={title} description={description}>
  <div
    class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32"
  >
    <div class="card-base z-10 px-9 py-6 relative w-full">
      <!-- 页面标题和描述 -->
      <div class="mb-4">
        <div class="page-heading">
          <div class="page-icon" aria-hidden="true">
            <Icon name="material-symbols:group" />
          </div>
          <div>
            <h2>{title}</h2>
            {description && <p>{description}</p>}
          </div>
        </div>
      </div>

      <!-- 搜索框 -->
      {
        items.length > 0 && (
          <friend-filter class="mb-6">
            <div class="relative mb-3">
              <Icon
                name="material-symbols:search"
                class="absolute left-3 top-1/2 -translate-y-1/2 text-neutral-400 dark:text-neutral-500 text-lg pointer-events-none"
              />
              <input
                type="text"
                data-search
                placeholder={i18n(I18nKey.searchFriends) || "搜索友链..."}
                class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-(--line-divider) bg-transparent text-neutral-900 dark:text-neutral-100 placeholder-neutral-400 dark:placeholder-neutral-500 focus:border-(--primary) focus:ring-1 focus:ring-(--primary) outline-none transition-all duration-200 text-sm"
              />
            </div>
            <div class="flex flex-wrap gap-2">
              <button
                data-tag="all"
                class="category-pill px-3 py-1.5 rounded-full text-sm font-medium transition-colors duration-200"
                data-active
              >
                {i18n(I18nKey.all)}
              </button>
              {allTags.map((tag) => (
                <button
                  data-tag={tag}
                  class="category-pill px-3 py-1.5 rounded-full text-sm font-medium transition-colors duration-200"
                >
                  {tag}
                </button>
              ))}
            </div>
          </friend-filter>
        )
      }

      <div class="friends-empty hidden flex-col items-center justify-center py-12 text-neutral-400 dark:text-neutral-500">
        <Icon name="material-symbols:search-off-rounded" class="text-4xl mb-3" />
        <div class="text-sm">{i18n(I18nKey.searchNoResults)}</div>
      </div>

      {
        items.length === 0 ? (
          <div class="flex flex-col items-center justify-center py-12 text-neutral-400 dark:text-neutral-500">
            <Icon name="material-symbols:group-off-outline" class="text-4xl mb-3" />
            <div class="text-sm">{i18n(I18nKey.friendsEmpty)}</div>
          </div>
        ) : (
          <div class="friends-sections space-y-8 my-4">
            {sections.map((section) => (
              <div class="friend-section" data-section={section.name}>
                {/* 分区标题栏 */}
                <div class="flex items-center justify-between gap-2 mb-3.5 pb-2 border-b border-(--line-divider)">
                  <div class="flex items-center gap-2 min-w-0">
                    <Icon
                      name={section.meta.icon}
                      class="text-(--primary) text-xl shrink-0"
                    />
                    <div class="flex items-baseline gap-2 min-w-0">
                      <h3 class="text-base sm:text-lg font-bold text-neutral-900 dark:text-neutral-100 shrink-0">
                        {section.meta.title}
                      </h3>
                      {section.meta.desc && (
                        <span class="text-xs text-neutral-400 dark:text-neutral-500 truncate hidden sm:inline">
                          {section.meta.desc}
                        </span>
                      )}
                    </div>
                    <span class="text-xs px-2 py-0.5 rounded-full bg-black/5 dark:bg-white/10 text-neutral-500 dark:text-neutral-400 font-medium shrink-0">
                      {section.items.length}
                    </span>
                  </div>

                  {/* 博客分区专属：排序切换按钮（默认随机排序，点击切换时间排序/随机排序） */}
                  {section.name === "博客" && section.items.length > 2 && (
                    <button
                      type="button"
                      id="blog-sort-toggle-btn"
                      data-sort-mode="random"
                      class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs rounded-lg border border-(--line-divider) hover:border-(--primary) hover:text-(--primary) bg-black/5 dark:bg-white/5 text-neutral-600 dark:text-neutral-300 transition-all duration-200 cursor-pointer select-none active:scale-95"
                      title="点击切换排序方式（随机 / 时间）"
                    >
                      <span class="sort-icon-random inline-flex items-center gap-1">
                        <Icon name="material-symbols:shuffle" class="text-sm text-(--primary)" />
                        <span>随机排序</span>
                      </span>
                      <span class="sort-icon-time hidden items-center gap-1">
                        <Icon name="material-symbols:schedule" class="text-sm text-(--primary)" />
                        <span>按时间排序</span>
                      </span>
                    </button>
                  )}
                </div>

                {/* 对应分区的卡片网格 */}
                <div class="friends-grid my-3">
                  {section.items.map((item, index) => (
                    <a
                      href={item.siteurl}
                      target="_blank"
                      rel="noopener noreferrer"
                      data-tags={item.tags?.join(",")}
                      data-pinned={item.pinned || item.weight >= 99 ? "true" : "false"}
                      data-order={configOrderMap.get(item.siteurl) ?? index}
                      class="friend-card group flex items-center gap-3 p-2.5 rounded-xl border border-(--line-divider) hover:border-(--primary) hover:bg-(--card-bg) transition-all duration-300 hover:shadow-lg relative overflow-hidden"
                    >
                      {/* 背景装饰 - 仅悬停显示 */}
                      <div class="absolute inset-0 bg-(--primary) opacity-0 group-hover:opacity-5 transition-opacity duration-300 pointer-events-none" />

                      {/* 外部链接图标 - 固定在卡片右上角 */}
                      <Icon
                        name="material-symbols:arrow-outward-rounded"
                        class="absolute top-3 right-3 text-(--primary) text-lg opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300"
                      />

                      {/* 头像 */}
                      <div class="relative w-16 h-16 shrink-0 rounded-xl overflow-hidden bg-zinc-100 dark:bg-zinc-800 border border-black/5 dark:border-white/5 group-hover:scale-105 transition-transform duration-300">
                        <img
                          src={item.imgurl}
                          alt={item.title}
                          width="64"
                          height="64"
                          loading="lazy"
                          decoding="async"
                          class="w-full h-full object-cover"
                        />
                      </div>

                      {/* 内容 */}
                      <div class="grow min-w-0 flex flex-col justify-center gap-0.5">
                        <div class="font-bold text-base text-neutral-900 dark:text-neutral-100 group-hover:text-(--primary) transition-colors truncate pr-4 flex items-center gap-1.5">
                          <span class="truncate">{item.title}</span>
                          {(item.pinned || item.weight >= 99) && (
                            <span class="shrink-0 inline-flex items-center h-5 px-2 rounded-md bg-(--primary)/15 text-(--primary) text-[0.65rem] font-bold tracking-wider select-none leading-none">
                              站长
                            </span>
                          )}
                        </div>

                        <div
                          class="text-sm text-neutral-500 dark:text-neutral-400 line-clamp-1"
                          title={item.desc}
                        >
                          {item.desc}
                        </div>

                        {/* 标签 */}
                        <div class="flex flex-wrap gap-1 mt-1">
                          {item.tags && item.tags.length > 0
                            ? item.tags
                                .slice(0, 3)
                                .map((tag) => (
                                  <span class="text-[0.65rem] px-1.5 py-0.5 rounded bg-neutral-100 dark:bg-neutral-800 text-neutral-500 dark:text-neutral-400 transition-colors duration-300">
                                    {tag}
                                  </span>
                                ))
                            : null}
                        </div>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </div>
        )
      }

      {/* 搜索无结果提示 */}
      <div class="friends-empty hidden flex-col items-center justify-center py-12 text-neutral-400 dark:text-neutral-500">
        <Icon name="material-symbols:search-off-rounded" class="text-4xl mb-3" />
        <div class="text-sm">{i18n(I18nKey.searchNoResults)}</div>
      </div>
    </div>
  </div>

  {/* 异常链接隔离区 */}
  {quarantinedItems.length > 0 && (
    <div class="mt-4 card-base z-10 px-9 py-6 relative w-full">
      <details>
        <summary class="cursor-pointer select-none flex items-center gap-2 text-neutral-500 dark:text-neutral-400 text-sm font-medium">
          <Icon name="material-symbols:link-off" class="text-lg" />
          <span>以下 {quarantinedItems.length} 个友链暂时无法访问</span>
        </summary>
        <div class="friends-grid my-4 opacity-50 grayscale">
          {quarantinedItems.map((item) => (
            <a
              href={item.siteurl}
              target="_blank"
              rel="noopener noreferrer"
              class="friend-card group flex items-center gap-3 p-2.5 rounded-xl border border-(--line-divider) transition-all duration-300 relative overflow-hidden"
              title={`连续 ${item.failCount} 次构建无法访问${item.lastError ? `（${item.lastError}）` : ""}`}
            >
              {/* 头像 */}
              <div class="relative w-16 h-16 shrink-0 rounded-xl overflow-hidden bg-zinc-100 dark:bg-zinc-800 border border-black/5 dark:border-white/5">
                <img
                  src={item.imgurl}
                  alt={item.title}
                  width="64"
                  height="64"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover"
                />
              </div>
              {/* 内容 */}
              <div class="grow min-w-0 flex flex-col justify-center gap-0.5">
                <div class="font-bold text-base text-neutral-900 dark:text-neutral-100 truncate pr-4">
                  {item.title}
                </div>
                <div class="text-sm text-neutral-500 dark:text-neutral-400 line-clamp-1" title={item.desc}>
                  {item.desc}
                </div>
                <div class="text-xs text-red-400 dark:text-red-500 mt-0.5">
                  连续 {item.failCount} 次无法访问
                </div>
              </div>
            </a>
          ))}
        </div>
      </details>
    </div>
  )}

  {friendsPageConfig.showCustomContent !== false && (
    <div class="mt-4 card-base z-10 px-9 py-6 relative w-full">
      <Markdown class="">
        <Content />
      </Markdown>
    </div>
  )}

  <!-- 评论区 -->
  {isCommentEnabled && (
    <div class="mt-4">
      <Comment post={friendsPost} customPath="/friends/" />
    </div>
  )}

  <script is:inline>
    // 友链分类与搜索过滤组件
    if (!customElements.get("friend-filter")) {
      class FriendFilter extends HTMLElement {
        selectedTag = "all";

        connectedCallback() {
          this.addEventListener("click", this.handleClick);
          const input = this.querySelector("[data-search]");
          if (input) {
            input.addEventListener("input", () => this.applyFilters());
          }
        }

        disconnectedCallback() {
          this.removeEventListener("click", this.handleClick);
        }

        handleClick(e) {
          const target = e.target;
          const button = target.closest("button");
          if (!button) return;

          this.selectedTag = button.dataset.tag;
          const filters = this.querySelectorAll("button");

          filters.forEach((f) => {
            f.removeAttribute("data-active");
          });
          button.setAttribute("data-active", "");

          this.applyFilters();
        }

        applyFilters() {
          const container = this.closest(".card-base");
          if (!container) return;

          const input = this.querySelector("[data-search]");
          const query = (input?.value || "").toLowerCase().trim();
          const sections = container.querySelectorAll(".friend-section");

          let totalVisible = 0;

          sections.forEach((sectionEl) => {
            const sectionName = sectionEl.dataset.section;
            const cards = sectionEl.querySelectorAll(".friend-card");
            let sectionVisible = 0;

            const tagMatchSection =
              this.selectedTag === "all" ||
              this.selectedTag === sectionName;

            cards.forEach((cardEl) => {
              const tags = (cardEl.dataset.tags || "").split(",");
              const name = (cardEl.querySelector(".font-bold")?.textContent || "").toLowerCase();
              const desc = (cardEl.querySelector(".line-clamp-1")?.textContent || "").toLowerCase();

              const tagMatch =
                tagMatchSection ||
                (this.selectedTag && tags.includes(this.selectedTag));

              const searchMatch =
                !query ||
                name.includes(query) ||
                desc.includes(query) ||
                tags.some((t) => t.toLowerCase().includes(query));

              if (tagMatch && searchMatch) {
                cardEl.style.display = "";
                sectionVisible++;
                totalVisible++;
              } else {
                cardEl.style.display = "none";
              }
            });

            // 若整个分区无匹配结果，则隐藏该分区及标题
            sectionEl.style.display = sectionVisible > 0 ? "" : "none";
          });

          const emptyEl = container.querySelector(".friends-empty");
          if (emptyEl) {
            emptyEl.classList.toggle("hidden", totalVisible > 0);
            emptyEl.classList.toggle("flex", totalVisible === 0);
          }
        }
      }
      customElements.define("friend-filter", FriendFilter);
    }

    // 博客排序控制（支持随机排序与按时间排序单按钮无缝切换）
    function initBlogSorting() {
      const blogSection = document.querySelector('.friend-section[data-section="博客"]');
      if (!blogSection) return;
      const grid = blogSection.querySelector(".friends-grid");
      if (!grid) return;

      const sortBtn = document.getElementById("blog-sort-toggle-btn");

      function applySort(mode, withAnimation = false) {
        const cards = Array.from(grid.querySelectorAll(".friend-card"));
        const pinned = cards.filter((c) => c.dataset.pinned === "true");
        const normal = cards.filter((c) => c.dataset.pinned !== "true");

        if (mode === "time") {
          // 按初始时间/添加顺序排序（data-order）
          normal.sort((a, b) => {
            const orderA = parseInt(a.dataset.order || "0", 10);
            const orderB = parseInt(b.dataset.order || "0", 10);
            return orderA - orderB;
          });
        } else {
          // 随机排序（Fisher-Yates 随机打乱普通卡片）
          for (let i = normal.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [normal[i], normal[j]] = [normal[j], normal[i]];
          }
        }

        // 站长卡片始终固定在最前，其余卡片排在其后
        [...pinned, ...normal].forEach((card) => {
          grid.appendChild(card);
          if (withAnimation) {
            card.classList.remove("friend-card-reorder");
            void card.offsetWidth;
            card.classList.add("friend-card-reorder");
          }
        });

        // 同步按钮状态与图标显示
        if (sortBtn) {
          sortBtn.setAttribute("data-sort-mode", mode);
          const randomIcon = sortBtn.querySelector(".sort-icon-random");
          const timeIcon = sortBtn.querySelector(".sort-icon-time");
          if (mode === "time") {
            if (randomIcon) {
              randomIcon.classList.remove("inline-flex");
              randomIcon.classList.add("hidden");
            }
            if (timeIcon) {
              timeIcon.classList.remove("hidden");
              timeIcon.classList.add("inline-flex");
            }
          } else {
            if (timeIcon) {
              timeIcon.classList.remove("inline-flex");
              timeIcon.classList.add("hidden");
            }
            if (randomIcon) {
              randomIcon.classList.remove("hidden");
              randomIcon.classList.add("inline-flex");
            }
          }
        }
      }

      // 绑定按钮切换事件
      if (sortBtn && !sortBtn._sortInitBound) {
        sortBtn._sortInitBound = true;
        sortBtn.addEventListener("click", () => {
          const currentMode = sortBtn.getAttribute("data-sort-mode") || "random";
          const nextMode = currentMode === "random" ? "time" : "random";
          applySort(nextMode, true);
        });
      }

      // 默认执行一次随机排序（保证刷新/重新进入即为随机模式）
      applySort("random", false);
    }

    // 页面初次加载、Astro 页面切换、Swup 路由切换时均可靠初始化
    function setupBlogSorting() {
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initBlogSorting, { once: true });
      } else {
        initBlogSorting();
      }
    }

    setupBlogSorting();
    document.addEventListener("astro:page-load", initBlogSorting);
    document.addEventListener("swup:content:replace", initBlogSorting);
  </script>

</MainGridLayout>
