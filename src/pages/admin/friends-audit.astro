---
import fs from "node:fs";
import path from "node:path";
import { Icon } from "astro-icon/components";
import { friendsConfig } from "@/config/friendsConfig";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import type {
	FriendAuditRecord,
	FriendsAuditData,
} from "@/types/friendsConfig";
import "@/styles/pages/common.css";

// 生产构建时为了安全性，若不是本地开发环境则重定向或限制访问
if (import.meta.env.PROD) {
	return Astro.redirect("/404/");
}

// 读取当前最新的审计数据
const AUDIT_FILE = path.resolve("src/constants/friends-audit.json");
let auditData: FriendsAuditData = {};
if (fs.existsSync(AUDIT_FILE)) {
	try {
		auditData = JSON.parse(fs.readFileSync(AUDIT_FILE, "utf-8"));
	} catch {
		auditData = {};
	}
}

// 仅提取真正的友情链接（排除站长自建站点与导航工具类站点）
const blogFriends = friendsConfig.filter(
	(f) => !f.siteurl.includes("lengxiqwq.com") && !f.tags?.includes("导航"),
);

// 组合友链数据与审计状态
const allItems = blogFriends.map((friend) => {
	const record: FriendAuditRecord = auditData[friend.siteurl] || {
		missingCount: 0,
		failCount: 0,
		lastChecked: "",
		lastStatus: "found",
		decision: friend.whitelist ? "whitelisted" : "normal",
	};

	return {
		...friend,
		audit: record,
		targetUrl:
			friend.friendPageUrl?.trim() || record.targetUrl || friend.siteurl,
	};
});

// 统计数据
const totalCount = allItems.length;
const whitelistedCount = allItems.filter(
	(i) => i.audit.decision === "whitelisted" || i.whitelist,
).length;
const quarantinedCount = allItems.filter(
	(i) =>
		!i.whitelist &&
		i.audit.decision !== "whitelisted" &&
		(i.audit.decision === "quarantined" || (i.audit.failCount || 0) >= 3),
).length;
const singleCount = allItems.filter(
	(i) =>
		!i.whitelist &&
		i.audit.decision !== "whitelisted" &&
		(i.audit.decision === "single" || (i.audit.missingCount || 0) >= 3) &&
		!(i.audit.decision === "quarantined" || (i.audit.failCount || 0) >= 3),
).length;
const normalCount =
	totalCount - singleCount - quarantinedCount - whitelistedCount;
---

<MainGridLayout title="友链巡检与审查工作台 (站长专区)">
  <div class="w-full max-w-6xl mx-auto space-y-6">
    {/* 页面顶栏 */}
    <div class="card-base p-6 rounded-2xl border border-black/5 dark:border-white/5 flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <div class="flex items-center gap-2">
          <Icon name="material-symbols:shield-person-outline" class="text-2xl text-[var(--primary)]" />
          <h1 class="text-2xl font-bold text-neutral-900 dark:text-neutral-100">友链双向性与健康度审查台</h1>
          <span class="text-xs px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-medium">全自动模式</span>
        </div>
        <p class="text-sm text-neutral-500 dark:text-neutral-400 mt-1">
          系统已开启<strong>全自动巡检与自愈模式</strong>（每日 12:00 自动巡检、连续 ≥3 次异常自动隔离、恢复后自动加回）。在此查看大盘健康度并管理白名单例外。
        </p>
      </div>

      <div class="flex items-center gap-3">
        <button
          type="button"
          id="run-full-audit-btn"
          class="flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-semibold bg-[var(--primary)] text-white hover:opacity-90 active:scale-95 transition-all shadow-sm cursor-pointer"
          title="立即向所有博客友链发起一次综合自检与双向匹配"
        >
          <Icon name="material-symbols:bolt" class="text-lg" />
          <span class="btn-text">立即全站自检</span>
        </button>

        <a
          href="/friends/"
          target="_blank"
          class="flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-sm bg-neutral-100 dark:bg-neutral-800 hover:bg-neutral-200 dark:hover:bg-neutral-700 text-neutral-700 dark:text-neutral-300 transition-colors"
        >
          <Icon name="material-symbols:open-in-new" class="text-base" />
          <span>查看前台友链</span>
        </a>
      </div>
    </div>

    {/* 统计大盘面板 */}
    <div class="grid grid-cols-2 md:grid-cols-5 gap-3">
      <div class="card-base p-4 rounded-xl border border-black/5 dark:border-white/5 text-center">
        <div class="text-xs text-neutral-500 dark:text-neutral-400">全部站点</div>
        <div class="text-xl font-bold text-neutral-800 dark:text-neutral-200 mt-1">{totalCount}</div>
      </div>
      <div class="card-base p-4 rounded-xl border border-emerald-500/20 bg-emerald-500/5 text-center">
        <div class="text-xs text-emerald-600 dark:text-emerald-400 font-bold">双向正常</div>
        <div class="text-xl font-bold text-emerald-600 dark:text-emerald-400 mt-1">{normalCount}</div>
      </div>
      <div class="card-base p-4 rounded-xl border border-orange-500/20 bg-orange-500/5 text-center">
        <div class="text-xs text-orange-600 dark:text-orange-400 font-bold">自动隔离·单向</div>
        <div class="text-xl font-bold text-orange-600 dark:text-orange-400 mt-1">{singleCount}</div>
      </div>
      <div class="card-base p-4 rounded-xl border border-rose-500/20 bg-rose-500/5 text-center">
        <div class="text-xs text-rose-600 dark:text-rose-400 font-bold">自动隔离·失联</div>
        <div class="text-xl font-bold text-rose-600 dark:text-rose-400 mt-1">{quarantinedCount}</div>
      </div>
      <div class="card-base p-4 rounded-xl border border-blue-500/20 bg-blue-500/5 text-center">
        <div class="text-xs text-blue-600 dark:text-blue-400 font-bold">免检白名单</div>
        <div class="text-xl font-bold text-blue-600 dark:text-blue-400 mt-1">{whitelistedCount}</div>
      </div>
    </div>

    {/* 审查操作区 */}
    <div id="audit-app" class="card-base p-6 rounded-2xl border border-black/5 dark:border-white/5 space-y-4">
      {/* 过滤 Tab 与搜索 */}
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 pb-3 border-b border-black/5 dark:border-white/5">
        <div class="flex flex-wrap items-center gap-1.5" id="tab-group">
          <button
            class="tab-btn px-3 py-1 rounded-lg text-xs font-medium transition-all active bg-[var(--primary)] text-white"
            data-tab="all"
          >
            全部 ({totalCount})
          </button>
          <button
            class="tab-btn px-3 py-1 rounded-lg text-xs font-medium transition-all bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400 hover:bg-neutral-200"
            data-tab="normal"
          >
            双向正常 ({normalCount})
          </button>
          <button
            class="tab-btn px-3 py-1 rounded-lg text-xs font-medium transition-all bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400 hover:bg-neutral-200"
            data-tab="single"
          >
            单向友链 ({singleCount})
          </button>
          <button
            class="tab-btn px-3 py-1 rounded-lg text-xs font-medium transition-all bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400 hover:bg-neutral-200"
            data-tab="quarantined"
          >
            失联隔离 ({quarantinedCount})
          </button>
          <button
            class="tab-btn px-3 py-1 rounded-lg text-xs font-medium transition-all bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400 hover:bg-neutral-200"
            data-tab="whitelisted"
          >
            免检白名单 ({whitelistedCount})
          </button>
        </div>

        <div class="relative w-full md:w-64">
          <input
            type="text"
            id="search-input"
            placeholder="搜索友链名称、URL..."
            class="w-full px-3 py-1.5 pl-8 rounded-lg text-xs bg-neutral-100 dark:bg-neutral-800 text-neutral-900 dark:text-neutral-100 border border-transparent focus:border-[var(--primary)] outline-none"
          />
          <Icon name="material-symbols:search" class="absolute left-2.5 top-2 text-neutral-400 text-sm" />
        </div>
      </div>

      {/* 自动隔离提醒 Banner */}
      {(singleCount > 0 || quarantinedCount > 0) && (
        <div class="p-3.5 rounded-xl bg-orange-500/10 border border-orange-500/20 flex items-center justify-between gap-3 text-orange-700 dark:text-orange-400 text-xs">
          <div class="flex items-center gap-2">
            <Icon name="material-symbols:info-outline" class="text-lg shrink-0" />
            <span>系统已自动隔离 <strong>{singleCount}</strong> 个单向友链与 <strong>{quarantinedCount}</strong> 个失联友链至前台底部。若某位好友需要豁免，直接点击【设为白名单】即可。</span>
          </div>
        </div>
      )}

      {/* 友链列表 */}
      <div class="space-y-3" id="friend-list">
        {allItems.map((item) => {
          const decision = item.audit.decision;
          const isWhitelisted = decision === "whitelisted" || item.whitelist;
          const isQuarantined = !isWhitelisted && (decision === "quarantined" || (item.audit.failCount || 0) >= 3);
          const isSingle = !isWhitelisted && !isQuarantined && (decision === "single" || (item.audit.missingCount || 0) >= 3);
          const isNormal = !isWhitelisted && !isQuarantined && !isSingle;
          const statusCategory = isWhitelisted ? "whitelisted" : isQuarantined ? "quarantined" : isSingle ? "single" : "normal";

          return (
            <div
              class={`friend-row p-4 rounded-xl border transition-all flex flex-col md:flex-row md:items-center justify-between gap-4 ${
                isWhitelisted
                  ? "border-blue-500/30 bg-blue-500/5"
                  : isSingle
                  ? "border-orange-500/30 bg-orange-500/5"
                  : isQuarantined
                  ? "border-rose-500/30 bg-rose-500/5 opacity-80"
                  : "border-black/5 dark:border-white/5 hover:border-black/10 dark:hover:border-white/10"
              }`}
              data-siteurl={item.siteurl}
              data-title={item.title.toLowerCase()}
              data-decision={decision}
              data-category={statusCategory}
            >
              {/* 左侧基本信息 */}
              <div class="flex items-start gap-3.5 min-w-0">
                <img
                  src={item.imgurl}
                  alt={item.title}
                  class="w-11 h-11 rounded-lg object-cover shrink-0 bg-neutral-100 dark:bg-neutral-800 border border-black/5"
                  loading="lazy"
                />
                <div class="min-w-0 space-y-1">
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class="font-bold text-sm text-neutral-900 dark:text-neutral-100 truncate">
                      {item.title}
                    </span>
                    {/* 状态徽章 */}
                    {isWhitelisted && (
                      <span class="text-[10px] px-2 py-0.5 rounded-full bg-blue-500/10 text-blue-600 dark:text-blue-400 font-semibold flex items-center gap-1">
                        <Icon name="material-symbols:shield" />
                        免检白名单
                      </span>
                    )}
                    {isQuarantined && (
                      <span class="text-[10px] px-2 py-0.5 rounded-full bg-rose-600 text-white font-semibold flex items-center gap-1" title="连续 3 次无法访问或 404，已自动移入前台底部隔离区">
                        <Icon name="material-symbols:warning-rounded" />
                        自动失联 (已隔离)
                      </span>
                    )}
                    {isSingle && (
                      <span class="text-[10px] px-2 py-0.5 rounded-full bg-orange-500 text-white font-semibold flex items-center gap-1" title="连续 3 次未检索到反向链接，已自动移入前台底部待回链区">
                        <Icon name="material-symbols:sync-alt" />
                        自动单向 (已下沉)
                      </span>
                    )}
                    {isNormal && (
                      <span class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-medium">
                        双向正常
                      </span>
                    )}
                  </div>

                  {/* 检测目标与上次信息 */}
                  <div class="text-xs text-neutral-500 dark:text-neutral-400 flex flex-wrap items-center gap-x-3 gap-y-1">
                    <a
                      href={item.siteurl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="hover:underline text-[var(--primary)] flex items-center gap-1 truncate max-w-xs"
                    >
                      <Icon name="material-symbols:home-outline" />
                      <span>{item.siteurl}</span>
                    </a>
                    {item.targetUrl && item.targetUrl !== item.siteurl ? (
                      <div class="flex items-center gap-1.5">
                        <a
                          href={item.targetUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="hover:underline text-emerald-600 dark:text-emerald-400 flex items-center gap-1 truncate max-w-xs"
                          title="已智能定位到的友链专属页面"
                        >
                          <Icon name="material-symbols:link" />
                          <span>友链页: {item.targetUrl}</span>
                        </a>
                        <button
                          type="button"
                          class="edit-target-btn text-[11px] text-neutral-400 hover:text-[var(--primary)] hover:underline flex items-center gap-0.5 cursor-pointer"
                          data-siteurl={item.siteurl}
                          data-current={item.targetUrl}
                          title="修改自定义友链探测地址"
                        >
                          <Icon name="material-symbols:edit-outline" />
                          <span>修改</span>
                        </button>
                      </div>
                    ) : (
                      <button
                        type="button"
                        class="edit-target-btn text-xs text-neutral-400 hover:text-[var(--primary)] hover:underline flex items-center gap-1 cursor-pointer"
                        data-siteurl={item.siteurl}
                        data-current={item.siteurl}
                        title="设置该站点专属友链页面地址"
                      >
                        <Icon name="material-symbols:add-link" />
                        <span>指定友链页</span>
                      </button>
                    )}
                  </div>

                  {/* 详细诊断信息 */}
                  <div class="text-[11px] text-neutral-400 dark:text-neutral-500">
                    {item.audit.lastMessage ? (
                      <span>最近记录: {item.audit.lastMessage}</span>
                    ) : (
                      <span>尚未执行巡检记录</span>
                    )}
                    {item.audit.missingCount > 0 && (
                      <span class="ml-2 text-orange-500">· 连续未搜到: {item.audit.missingCount}/3 次</span>
                    )}
                    {item.audit.failCount > 0 && (
                      <span class="ml-2 text-rose-500">· 连续 404: {item.audit.failCount}/3 次</span>
                    )}
                    {(item.audit.protectedCount || 0) > 0 && (
                      <span class="ml-2 text-blue-500">· 连续反爬阻断: {item.audit.protectedCount}/3 次</span>
                    )}
                    {item.audit.lastChecked && (
                      <span class="ml-2">· 检测于: {new Date(item.audit.lastChecked).toLocaleString()}</span>
                    )}
                  </div>

                  {/* 防爬拦截待人工核实引导提示 */}
                  {!isWhitelisted && (item.audit.lastStatus === "protected" || (item.audit.protectedCount || 0) >= 3) && (
                    <div class="text-[11px] text-blue-600 dark:text-blue-400 bg-blue-500/10 px-2.5 py-1.5 rounded-lg mt-1 flex items-center gap-1.5">
                      <Icon name="material-symbols:shield" class="text-sm shrink-0" />
                      <span>该站点启用了防爬验证或请求超时，机器人无法穿透。请点击右侧<strong>【核实】</strong>在浏览器中人工确认。若友链仍在，请点击<strong>【免检加白】</strong>免除告警；若对方已删链可点击<strong>【设为单向】</strong>。</span>
                    </div>
                  )}
                </div>
              </div>

              {/* 右侧裁决操作按钮组 */}
              <div class="flex items-center gap-1.5 shrink-0 flex-wrap">
                <a
                  href={item.targetUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="px-2.5 py-1 text-xs rounded-lg bg-neutral-100 dark:bg-neutral-800 hover:bg-neutral-200 dark:hover:bg-neutral-700 text-neutral-700 dark:text-neutral-300 transition-colors flex items-center gap-1"
                  title="新标签页打开对方页面人工核实"
                >
                  <Icon name="material-symbols:open-in-new" />
                  <span>核实</span>
                </a>

                <button
                  type="button"
                  class="recheck-btn px-2.5 py-1 text-xs rounded-lg bg-neutral-100 dark:bg-neutral-800 hover:bg-neutral-200 dark:hover:bg-neutral-700 text-neutral-700 dark:text-neutral-300 transition-colors flex items-center gap-1 cursor-pointer"
                  title="单独重新探测该站点的连通性与反向链接"
                >
                  <Icon name="material-symbols:refresh" />
                  <span>重测</span>
                </button>

                {/* 裁决按钮组 */}
                {isWhitelisted ? (
                  <button
                    type="button"
                    class="action-btn px-2.5 py-1 text-xs rounded-lg transition-colors font-medium bg-blue-500 text-white hover:bg-blue-600 cursor-pointer"
                    data-action="normal"
                    title="移出免检白名单，恢复每日自动巡检"
                  >
                    移出白名单
                  </button>
                ) : (
                  <button
                    type="button"
                    class="action-btn px-2.5 py-1 text-xs rounded-lg transition-colors font-medium bg-blue-500/10 text-blue-600 dark:text-blue-400 hover:bg-blue-500/20 cursor-pointer"
                    data-action="whitelisted"
                    title="设为免检白名单（豁免检测，永不隔离）"
                  >
                    设为白名单
                  </button>
                )}

                <button
                  type="button"
                  class={`action-btn px-2.5 py-1 text-xs rounded-lg transition-colors font-medium cursor-pointer ${
                    isSingle && decision === "single"
                      ? "bg-orange-500 text-white"
                      : "bg-orange-500/10 text-orange-600 dark:text-orange-400 hover:bg-orange-500/20"
                  }`}
                  data-action="single"
                  title="手动强制锁定为单向友链"
                >
                  强制单向
                </button>

                <button
                  type="button"
                  class={`action-btn px-2.5 py-1 text-xs rounded-lg transition-colors font-medium cursor-pointer ${
                    isQuarantined && decision === "quarantined"
                      ? "bg-rose-500 text-white"
                      : "bg-rose-500/10 text-rose-600 dark:text-rose-400 hover:bg-rose-500/20"
                  }`}
                  data-action="quarantined"
                  title="手动强制锁定为失联隔离"
                >
                  强制失联
                </button>

                <button
                  type="button"
                  class="action-btn px-2.5 py-1 text-xs rounded-lg bg-neutral-100 dark:bg-neutral-800 hover:bg-neutral-200 dark:hover:bg-neutral-700 text-neutral-500 dark:text-neutral-400 transition-colors cursor-pointer"
                  data-action="normal"
                  title="清空强制锁定，重置为跟随自动巡检"
                >
                  自动模式
                </button>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>

  {/* 客户端交互控制脚本 */}
  <script is:inline>
    (function () {
      let currentTab = "all";
      const searchInput = document.getElementById("search-input");
      const tabBtns = document.querySelectorAll(".tab-btn");
      const rows = document.querySelectorAll(".friend-row");
      const focusPendingBtn = document.getElementById("focus-pending-btn");

      function filterRows() {
        const query = (searchInput?.value || "").toLowerCase().trim();

        rows.forEach((row) => {
          const title = row.dataset.title || "";
          const siteurl = (row.dataset.siteurl || "").toLowerCase();
          const category = row.dataset.category || "normal";

          const matchesQuery = !query || title.includes(query) || siteurl.includes(query);
          let matchesTab = true;

          if (currentTab !== "all") {
            matchesTab = category === currentTab;
          }

          if (matchesQuery && matchesTab) {
            row.style.display = "";
          } else {
            row.style.display = "none";
          }
        });
      }

      // Tab 点击切换
      tabBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          tabBtns.forEach((b) => {
            b.classList.remove("bg-[var(--primary)]", "text-white");
            b.classList.add("bg-neutral-100", "dark:bg-neutral-800", "text-neutral-600", "dark:text-neutral-400");
          });
          btn.classList.add("bg-[var(--primary)]", "text-white");
          btn.classList.remove("bg-neutral-100", "dark:bg-neutral-800", "text-neutral-600", "dark:text-neutral-400");
          currentTab = btn.dataset.tab;
          filterRows();
        });
      });

      // 搜索框输入
      searchInput?.addEventListener("input", filterRows);



      // 全站自检按钮点击
      const runFullBtn = document.getElementById("run-full-audit-btn");
      runFullBtn?.addEventListener("click", async () => {
        if (runFullBtn.disabled) return;
        runFullBtn.disabled = true;
        const originalHtml = runFullBtn.innerHTML;
        runFullBtn.innerHTML = `<span>⏳ 正在全站自检巡检中 (可能需要10-20秒)...</span>`;
        runFullBtn.classList.add("opacity-75");

        try {
          const res = await fetch("/api/friends-audit/", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ action: "run-full-check" }),
          });
          const data = await res.json();
          if (res.ok) {
            alert(`🎉 全站自检完成！\n总检测博客: ${data.summary.total}\n正常双向: ${data.summary.normal}\n待审告警: ${data.summary.pending}`);
            window.location.reload();
          } else {
            alert("自检失败: " + (data.error || "未知异常"));
            runFullBtn.disabled = false;
            runFullBtn.innerHTML = originalHtml;
            runFullBtn.classList.remove("opacity-75");
          }
        } catch (e) {
          alert("请求异常: " + e.message);
          runFullBtn.disabled = false;
          runFullBtn.innerHTML = originalHtml;
          runFullBtn.classList.remove("opacity-75");
        }
      });

      // 按钮操作请求提交
      rows.forEach((row) => {
        const siteurl = row.dataset.siteurl;
        const actionBtns = row.querySelectorAll(".action-btn");
        const recheckBtn = row.querySelector(".recheck-btn");

        // 单站重测
        recheckBtn?.addEventListener("click", async () => {
          recheckBtn.disabled = true;
          recheckBtn.classList.add("opacity-50");
          const originalText = recheckBtn.textContent;
          recheckBtn.textContent = "探测中...";

          try {
            const res = await fetch("/api/friends-audit/", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ action: "probe-single", siteurl }),
            });
            const data = await res.json();
            if (res.ok) {
              window.location.reload();
            } else {
              alert("重测失败: " + (data.error || "未知错误"));
              recheckBtn.disabled = false;
              recheckBtn.classList.remove("opacity-50");
              recheckBtn.textContent = originalText;
            }
          } catch (e) {
            alert("请求异常: " + e.message);
            recheckBtn.disabled = false;
            recheckBtn.classList.remove("opacity-50");
            recheckBtn.textContent = originalText;
          }
        });

        // 修改/指定该站点的专属友链地址
        const editTargetBtn = row.querySelector(".edit-target-btn");
        editTargetBtn?.addEventListener("click", async () => {
          const current = editTargetBtn.dataset.current || siteurl;
          const input = prompt("请输入该站点的友链页面完整网址 (URL):", current);
          if (input === null) return;
          const targetUrl = input.trim();
          if (!targetUrl) return;

          try {
            const res = await fetch("/api/friends-audit/", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ action: "save-target-url", siteurl, targetUrl }),
            });
            if (res.ok) {
              // 自动发起一次重测
              await fetch("/api/friends-audit/", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ action: "probe-single", siteurl, targetUrl }),
              });
              window.location.reload();
            } else {
              alert("保存友链地址失败");
            }
          } catch (e) {
            alert("请求异常: " + e.message);
          }
        });

        // 裁决操作
        actionBtns.forEach((btn) => {
          btn.addEventListener("click", async () => {
            const decision = btn.dataset.action;
            btn.disabled = true;
            btn.style.opacity = "0.5";

            try {
              const res = await fetch("/api/friends-audit/", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ siteurl, decision }),
              });

              if (res.ok) {
                row.dataset.decision = decision;
                // 更新页面提示
                btn.style.opacity = "1";
                btn.disabled = false;
                // 刷新页面状态或者重新过滤
                filterRows();
                window.location.reload();
              } else {
                const err = await res.json();
                alert("裁决更新失败: " + (err.error || "未知错误"));
                btn.disabled = false;
                btn.style.opacity = "1";
              }
            } catch (e) {
              alert("请求异常: " + e.message);
              btn.disabled = false;
              btn.style.opacity = "1";
            }
          });
        });
      });
    })();
  </script>
</MainGridLayout>
