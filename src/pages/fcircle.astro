---
import FcircleFeed from "@/components/pages/fcircle/FcircleFeed.svelte";
import { siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getWorkerApiUrl } from "@/utils/api-config";
import "@/styles/pages/common.css";
import "@/styles/pages/fcircle.css";

// 检查页面是否启用
if (!siteConfig.pages.fcircle) {
	return Astro.redirect("/404/");
}

// 遵循站点配置时区与语言
const fcircleTimeZone = siteConfig.timezone || "UTC";
const lang = siteConfig.lang || "zh_CN";

// 页面标题和描述
const title = i18n(I18nKey.fcircle);
const description = i18n(I18nKey.fcircleDescription);

// Cloudflare Worker API 统一基础地址
const workerApiUrl = getWorkerApiUrl();
---

<MainGridLayout title={title} description={description}>
  <div
    id="fcircle-root"
    data-time-zone={fcircleTimeZone}
    class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32"
  >
    <div class="card-base z-10 px-5 sm:px-9 py-6 relative w-full">
      <FcircleFeed
        client:load
        {workerApiUrl}
        timeZone={fcircleTimeZone}
        lang={lang}
        title={title}
        description={description}
        emptyText={i18n(I18nKey.fcircleEmpty)}
        authorText={i18n(I18nKey.fcircleAuthor)}
        subscriptionText={i18n(I18nKey.fcircleSubscription)}
        todayText={i18n(I18nKey.fcircleToday)}
        weekText={i18n(I18nKey.fcircleWeek)}
        totalText={i18n(I18nKey.fcircleTotal)}
        sitesText={i18n(I18nKey.fcircleSites)}
        postUnitText={i18n(I18nKey.fcirclePostUnit)}
        siteUnitText={i18n(I18nKey.fcircleSiteUnit)}
        postsUpdatedText={i18n(I18nKey.fcirclePostsUpdated)}
        timelineText={i18n(I18nKey.fcircleTimeline)}
        gridText={i18n(I18nKey.fcircleGrid)}
        buildHintText={i18n(I18nKey.fcircleBuildHint)}
      />
    </div>
  </div>
</MainGridLayout>
