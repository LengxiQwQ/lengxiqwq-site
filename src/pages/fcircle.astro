---
import { Icon } from "astro-icon/components";
import FcircleStatsBar from "@/components/pages/fcircle/FcircleStatsBar.astro";
import FcircleTimelineItem from "@/components/pages/fcircle/FcircleTimelineItem.astro";
import { siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import {
	getFcircleItems,
	getFcircleStats,
	groupFcircleByDate,
} from "@/utils/fcircle-utils";
import "@/styles/pages/common.css";

// 检查页面是否启用
if (!siteConfig.pages.fcircle) {
	return Astro.redirect("/404/");
}

// 获取友链与订阅文章
const items = await getFcircleItems();

// 所有自然日判断都以站点配置时区为唯一真源，不依赖 GitHub Actions 构建机时区
const fcircleTimeZone = siteConfig.timezone || "UTC";
const buildNow = new Date();
const dateGroups = groupFcircleByDate(items, buildNow, fcircleTimeZone);
const stats = getFcircleStats(items, buildNow, fcircleTimeZone);

// 页面标题和描述
const title = i18n(I18nKey.fcircle);
const description = i18n(I18nKey.fcircleDescription);
---

<MainGridLayout title={title} description={description}>
  <div
    id="fcircle-root"
    data-time-zone={fcircleTimeZone}
    class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32"
  >
    <div class="card-base z-10 px-5 sm:px-9 py-6 relative w-full">
      <!-- 页面标题、描述与视图切换开关 -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-2 pb-4 border-b border-(--line-divider)">
        <div class="page-heading mb-0">
          <div class="page-icon" aria-hidden="true">
            <Icon is:inline name="mingcute:moment-line" />
          </div>
          <div>
            <h2>{title}</h2>
            {description && <p>{description}</p>}
          </div>
        </div>

        <!-- 视图切换 Segmented Switcher -->
        {items.length > 0 && (
          <div
            id="fcircle-view-switcher"
            class="inline-flex items-center p-1 rounded-xl bg-(--btn-regular-bg) border border-(--line-divider) text-xs font-medium self-start sm:self-auto shrink-0 shadow-2xs"
            role="tablist"
            aria-label="视图切换"
          >
            <button
              type="button"
              class="fcircle-view-btn"
              data-view="timeline"
              role="tab"
              aria-selected="true"
            >
              <Icon name="mingcute:time-line" class="text-sm shrink-0" />
              <span>时间线</span>
            </button>
            <button
              type="button"
              class="fcircle-view-btn"
              data-view="list"
              role="tab"
              aria-selected="false"
            >
              <Icon name="mingcute:list-check-3-line" class="text-sm shrink-0" />
              <span>平铺</span>
            </button>
          </div>
        )}
      </div>

      <!-- 顶部数据概览栏 -->
      {items.length > 0 && <FcircleStatsBar stats={stats} />}

      <!-- 空状态提示 -->
      {items.length === 0 && (
        <div class="flex flex-col items-center justify-center py-16 text-neutral-400 dark:text-neutral-500">
          <Icon is:inline name="mingcute:moment-line" class="text-5xl mb-3 opacity-50" />
          <div class="text-sm">暂无最新动态，可能是友链没有配置 feedUrl，或文章尚未更新。</div>
        </div>
      )}

      <!-- 视图 1：按天聚合的时间线视图（默认视图） -->
      {items.length > 0 && (
        <div id="fcircle-timeline-view" class="mt-8 transition-opacity duration-300">
          <div class="relative flex flex-col">
            <!-- 纵向贯穿细轨道 -->
            <div
              class="fcircle-track absolute left-4 sm:left-5 top-4 bottom-4 w-0.5 bg-gradient-to-b from-(--line-divider) via-(--line-divider) to-transparent -translate-x-1/2 pointer-events-none"
              aria-hidden="true"
            />

            <!-- 日期分组列表 -->
            {dateGroups.map((group) => {
              const isToday = group.relativeDays === 0;
              const isYesterday = group.relativeDays === 1;

              return (
                <div
                  class="fcircle-date-group relative mb-8 last:mb-2"
                  data-date-iso={group.items[0]?.pubDate.toISOString()}
                >
                  <!-- 日期节点 Header -->
                  <div class="flex items-center gap-3 sm:gap-4 mb-4 select-none">
                    <!-- 节点圆环 Marker -->
                    <div
                      class:list={[
                        "relative z-10 w-8 h-8 sm:w-10 sm:h-10 rounded-full flex items-center justify-center border-2 transition-all duration-300 shrink-0",
                        isToday
                          ? "border-(--primary) bg-(--primary) text-white shadow-md shadow-(--primary)/20 ring-4 ring-(--primary)/15"
                          : isYesterday
                            ? "border-(--primary) bg-(--card-bg) text-(--primary) shadow-sm ring-2 ring-(--primary)/10"
                            : "border-(--line-divider) bg-(--card-bg) text-neutral-500 dark:text-neutral-400 md:hover:border-(--primary)",
                      ]}
                      aria-hidden="true"
                    >
                      <span class:list={["fcircle-date-today-icon", !isToday && "hidden"]}>
                        <Icon name="mingcute:flash-line" class="text-sm sm:text-base" />
                      </span>
                      <span class:list={["fcircle-date-calendar-icon", isToday && "hidden"]}>
                        <Icon name="mingcute:calendar-line" class="text-sm sm:text-base" />
                      </span>
                    </div>

                    <!-- 日期文本与条数徽标 -->
                    <div class="flex items-center gap-2.5 flex-wrap">
                      <span class="fcircle-date-label text-base sm:text-lg font-bold tracking-tight text-neutral-800 dark:text-neutral-100">
                        {group.displayDate}
                      </span>

                      {group.subLabel && (
                        <span class="fcircle-date-sublabel text-xs text-neutral-400 font-medium">
                          {group.subLabel}
                        </span>
                      )}

                      <span class="text-xs px-2 py-0.5 rounded-full bg-(--btn-regular-bg) text-neutral-600 dark:text-neutral-400 font-medium tabular-nums border border-(--line-divider)">
                        {group.items.length} 篇更新
                      </span>
                    </div>
                  </div>

                  <!-- 当天文章卡片容器（右移缩进挂靠在轨道内） -->
                  <div class="pl-8 sm:pl-12 flex flex-col gap-3">
                    {group.items.map((item) => (
                      <FcircleTimelineItem item={item} timeZone={fcircleTimeZone} />
                    ))}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      )}

      <!-- 视图 2：经典平铺列表视图（可选切换） -->
      {items.length > 0 && (
        <div id="fcircle-list-view" class="fcircle-grid mt-6 flex flex-col gap-4 hidden transition-opacity duration-300">
          {items.map((item) => {
            const dateStr = item.pubDate.toLocaleDateString("zh-CN", {
              timeZone: fcircleTimeZone,
              year: "numeric",
              month: "2-digit",
              day: "2-digit",
            });

            return (
              <a
                href={item.link}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-start gap-4 p-4 rounded-xl border border-(--line-divider) md:hover:border-(--primary) md:hover:bg-(--card-bg) transition-all duration-300 md:hover:shadow-md relative overflow-hidden"
              >
                <div class="absolute inset-0 bg-(--primary) opacity-0 group-md:hover:opacity-5 transition-opacity duration-300 pointer-events-none" />
                <Icon
                  name="material-symbols:arrow-outward-rounded"
                  class="absolute top-4 right-4 text-(--primary) text-lg opacity-0 -translate-x-2 group-md:hover:opacity-100 group-md:hover:translate-x-0 transition-all duration-300"
                />

                <div class="relative w-12 h-12 shrink-0 rounded-full overflow-hidden bg-zinc-100 dark:bg-zinc-800 border border-black/5 dark:border-white/5 group-md:hover:scale-105 transition-transform duration-300 mt-1">
                  <img
                    src={item.friendAvatar}
                    alt={item.friendName}
                    width="48"
                    height="48"
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover"
                  />
                </div>

                <div class="grow min-w-0 flex flex-col gap-1">
                  <div class="text-xs text-neutral-500 dark:text-neutral-400 font-medium flex items-center gap-2 flex-wrap">
                    <span class="text-neutral-700 dark:text-neutral-300 group-md:hover:text-(--primary) transition-colors">{item.friendName}</span>
                    {item.sourceType === "subscription" && (
                      <span class="text-[10px] px-1.5 py-0.5 rounded-md bg-(--primary)/10 text-(--primary) font-normal border border-(--primary)/20">
                        {item.tags?.[0] || "订阅"}
                      </span>
                    )}
                    <span class="w-1 h-1 rounded-full bg-neutral-300 dark:bg-neutral-600"></span>
                    <span>{dateStr}</span>
                  </div>

                  <div class="font-bold text-lg text-neutral-900 dark:text-neutral-100 group-md:hover:text-(--primary) transition-colors line-clamp-2 pr-6 mb-1">
                    {item.title}
                  </div>
                  {item.excerpt && (
                    <div class="text-sm text-neutral-500 dark:text-neutral-400 line-clamp-2 pr-4">
                      {item.excerpt}
                    </div>
                  )}
                </div>
              </a>
            );
          })}
        </div>
      )}
    </div>
  </div>
</MainGridLayout>

<style>
  .fcircle-view-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    border-radius: 0.5rem;
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
    line-height: 1;
    transition: background-color 0.15s ease, color 0.15s ease, box-shadow 0.15s ease, opacity 0.15s ease;
  }

  .fcircle-view-btn[aria-selected="false"] {
    color: var(--btn-content);
    background: transparent;
  }
  .fcircle-view-btn[aria-selected="false"]:hover {
    color: var(--primary);
    background: var(--btn-plain-bg-hover);
  }

  .fcircle-view-btn[aria-selected="true"] {
    background: var(--primary);
    color: #ffffff;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
  }
  .fcircle-view-btn[aria-selected="true"]:hover {
    background: var(--primary);
    color: #ffffff;
    opacity: 0.92;
  }
</style>

<script>
  import {
    getFcircleDatePresentation,
    getFcircleRelativeDays,
  } from "@/utils/fcircle-date-utils";

  const TODAY_MARKER_CLASSES = [
    "border-(--primary)",
    "bg-(--primary)",
    "text-white",
    "shadow-md",
    "shadow-(--primary)/20",
    "ring-4",
    "ring-(--primary)/15",
  ];
  const YESTERDAY_MARKER_CLASSES = [
    "border-(--primary)",
    "bg-(--card-bg)",
    "text-(--primary)",
    "shadow-sm",
    "ring-2",
    "ring-(--primary)/10",
  ];
  const DEFAULT_MARKER_CLASSES = [
    "border-(--line-divider)",
    "bg-(--card-bg)",
    "text-neutral-500",
    "dark:text-neutral-400",
    "md:hover:border-(--primary)",
  ];
  const ALL_MARKER_CLASSES = [
    ...TODAY_MARKER_CLASSES,
    ...YESTERDAY_MARKER_CLASSES,
    ...DEFAULT_MARKER_CLASSES,
  ];

  function setupFcircleViewSwitcher() {
    const switcher = document.getElementById("fcircle-view-switcher");
    const timelineView = document.getElementById("fcircle-timeline-view");
    const listView = document.getElementById("fcircle-list-view");

    if (!switcher || !timelineView || !listView) return;

    const STORAGE_KEY = "fcircle_preferred_view";
    const buttons = switcher.querySelectorAll<HTMLButtonElement>(".fcircle-view-btn");

    function applyView(mode: "timeline" | "list") {
      if (!timelineView || !listView) return;

      buttons.forEach((btn) => {
        const isCurrent = btn.dataset.view === mode;
        btn.setAttribute("aria-selected", isCurrent ? "true" : "false");
      });

      if (mode === "timeline") {
        timelineView.classList.remove("hidden");
        listView.classList.add("hidden");
      } else {
        timelineView.classList.add("hidden");
        listView.classList.remove("hidden");
      }
    }

    const savedMode = (localStorage.getItem(STORAGE_KEY) as "timeline" | "list") || "timeline";
    applyView(savedMode);

    if (switcher.dataset.bound !== "true") {
      switcher.dataset.bound = "true";
      buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const mode = btn.dataset.view as "timeline" | "list";
          if (mode) {
            localStorage.setItem(STORAGE_KEY, mode);
            applyView(mode);
          }
        });
      });
    }
  }

  function applyMarkerState(marker: HTMLElement, relativeDays: number) {
    marker.classList.remove(...ALL_MARKER_CLASSES);
    const classes =
      relativeDays === 0
        ? TODAY_MARKER_CLASSES
        : relativeDays === 1
          ? YESTERDAY_MARKER_CLASSES
          : DEFAULT_MARKER_CLASSES;
    marker.classList.add(...classes);

    marker
      .querySelector(".fcircle-date-today-icon")
      ?.classList.toggle("hidden", relativeDays !== 0);
    marker
      .querySelector(".fcircle-date-calendar-icon")
      ?.classList.toggle("hidden", relativeDays === 0);
  }

  function updateTodayStatStyle(todayCount: number) {
    const card = document.getElementById("fcircle-today-stat-card");
    const icon = document.getElementById("fcircle-today-stat-icon");
    const count = document.getElementById("fcircle-today-count");
    if (!card || !icon || !count) return;

    const active = todayCount > 0;

    card.classList.toggle("border-(--primary)/30", active);
    card.classList.toggle("bg-(--primary)/5", active);
    card.classList.toggle("md:hover:border-(--primary)", active);
    card.classList.toggle("border-(--line-divider)", !active);
    card.classList.toggle("md:hover:border-(--primary)/40", !active);

    icon.classList.toggle("bg-(--primary)", active);
    icon.classList.toggle("text-white", active);
    icon.classList.toggle("shadow-xs", active);
    icon.classList.toggle("bg-(--primary)/10", !active);
    icon.classList.toggle("text-(--primary)", !active);

    count.classList.toggle("text-(--primary)", active);
    count.classList.toggle("text-neutral-800", !active);
    count.classList.toggle("dark:text-neutral-200", !active);
  }

  function refreshFcircleRelativeDates() {
    const root = document.getElementById("fcircle-root");
    if (!root) return;

    const timeZone = root.dataset.timeZone || "UTC";
    const now = new Date();

    root.querySelectorAll<HTMLElement>(".fcircle-date-group[data-date-iso]").forEach((group) => {
      const dateIso = group.dataset.dateIso;
      if (!dateIso) return;

      const presentation = getFcircleDatePresentation(dateIso, now, timeZone);
      const label = group.querySelector<HTMLElement>(".fcircle-date-label");
      const subLabel = group.querySelector<HTMLElement>(".fcircle-date-sublabel");
      const marker = group.querySelector<HTMLElement>(".fcircle-date-group > div > div");

      if (label) label.textContent = presentation.displayDate;
      if (subLabel) subLabel.textContent = presentation.subLabel;
      if (marker) applyMarkerState(marker, presentation.relativeDays);
    });

    let todayCount = 0;
    let weekCount = 0;

    root
      .querySelectorAll<HTMLElement>(
        "#fcircle-timeline-view .fcircle-timeline-card[data-pub-date]",
      )
      .forEach((card) => {
        const dateIso = card.dataset.pubDate;
        if (!dateIso) return;

        const relativeDays = getFcircleRelativeDays(dateIso, now, timeZone);
        if (relativeDays === 0) todayCount++;
        if (relativeDays >= 0 && relativeDays <= 6) weekCount++;
      });

    const todayCountElement = document.getElementById("fcircle-today-count");
    const weekCountElement = document.getElementById("fcircle-week-count");
    if (todayCountElement) todayCountElement.textContent = String(todayCount);
    if (weekCountElement) weekCountElement.textContent = String(weekCount);
    updateTodayStatStyle(todayCount);
  }

  function initFcirclePage() {
    setupFcircleViewSwitcher();
    refreshFcircleRelativeDates();
  }

  initFcirclePage();
  document.addEventListener("swup:page:view", initFcirclePage);

  const fcircleWindow = window as Window & {
    __fcircleRelativeDateBound?: boolean;
    __fcircleRelativeDateTimer?: number;
  };

  if (!fcircleWindow.__fcircleRelativeDateBound) {
    fcircleWindow.__fcircleRelativeDateBound = true;
    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) refreshFcircleRelativeDates();
    });
    fcircleWindow.__fcircleRelativeDateTimer = window.setInterval(
      refreshFcircleRelativeDates,
      60_000,
    );
  }
</script>
