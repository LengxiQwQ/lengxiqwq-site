---
import Comment from "@components/comment/index.astro";
import SteamGrid from "@/components/pages/steam/SteamGrid.svelte";
import { commentConfig, siteConfig } from "@/config";
import { steamConfig } from "@/config/steamConfig";
import steamDataRaw from "@/constants/steam-data.json";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import "@/styles/pages/common.css";
import "@/styles/pages/media-grid.css";
import type { SteamData } from "@/types/steamConfig";

// 检查页面是否启用（若明确设为 false 则 404）
if (siteConfig.pages.steam === false) {
	return Astro.redirect("/404/");
}

const title = i18n(I18nKey.steam);
const description = i18n(I18nKey.steamDescription);

const steamData = steamDataRaw as SteamData;
const isCommentEnabled = commentConfig?.type && commentConfig.type !== "none";
---

<MainGridLayout title={title} description={description}>
	<section class="page-shell">
		<!-- 整合控制面板与游戏交互网格（标题、玩家数据看板与筛选搜索排序整合成单一大面板） -->
		<SteamGrid
			client:load
			title={title}
			description={description}
			games={steamData.games}
			recentGames={steamData.recentGames}
			pageSize={steamConfig?.pageSize || 60}
			profile={steamData.profile}
			stats={steamData.stats}
			levelInfo={steamData.levelInfo}
			showStats={steamConfig?.showStats !== false}
		/>

		<!-- 评论区 -->
		{
			isCommentEnabled && (
				<div class="mt-8">
					<Comment customPath="/steam/" title={title} />
				</div>
			)
		}
	</section>
</MainGridLayout>
