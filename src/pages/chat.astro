---
import ChatApp from "@/components/pages/chat/ChatApp.svelte";
import type { ChatMusicTrack } from "@/components/pages/chat/musicTypes";
import { chatConfig, commentConfig, profileConfig, siteConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

import "@/styles/pages/chat.css";

// 页面开关检查
if (!siteConfig.pages.chat) {
	return Astro.redirect("/404/");
}

// 暂不注入站点默认曲库，待后续导入歌单后再配置默认电台列表
const musicTracks: ChatMusicTrack[] = [];
const initialVolume = 0.8;
const walineServerUrl = commentConfig.waline?.serverURL ?? "";
const chatServerOrigin = (() => {
	try {
		return chatConfig.serverURL ? new URL(chatConfig.serverURL).origin : "";
	} catch {
		return "";
	}
})();
const stickerPackUrls = (commentConfig.waline?.emoji ?? []).filter(
	(entry): entry is string =>
		typeof entry === "string" && !entry.includes("bmoji"),
);
---

<MainGridLayout title="聊天室" description="实时聊天室">
    {chatServerOrigin && <link slot="head" rel="dns-prefetch" href={chatServerOrigin} />}
    {chatServerOrigin && <link slot="head" rel="preconnect" href={chatServerOrigin} crossorigin />}
    {/* 首帧前（body 解析前）同步激活聊天页隔离标记与外观缓存，彻底避免刷新时闪现旧模板；Swup 软切换由 swup-transitions.ts 原子接管 */}
    <script is:inline slot="head" data-swup-ignore-script define:vars={{ chatWallpapers: chatConfig.wallpapers ?? null, isChatDevEnv: import.meta.env.DEV }}>
        (function () {
            if (window.swup) return;
            var root = document.documentElement;
            root.setAttribute("data-chat-page", "true");
            var isIPhone = /iPhone|iPod/.test(navigator.userAgent);
            if (isIPhone) {
                root.setAttribute("data-is-iphone", "true");
            }
            try {
                var wpCfg = chatWallpapers && typeof chatWallpapers === "object" ? chatWallpapers : { defaultOpacity: 0.42, defaults: {}, items: [] };
                var wpItems = Array.isArray(wpCfg.items) ? wpCfg.items : [];
                var chatHue = 175;
                var chatBg = "wallpaper";
                var chatDensity = "comfortable";
                var chatFontSize = "md";
                var selectedMap = Object.assign({ left: "", center: "", right: "", input: "" }, wpCfg.defaults || {});
                var devOverrides = null;
                var raw = localStorage.getItem("fireflyChatAppearance");
                if (raw) {
                    var prefs = JSON.parse(raw);
                    if (typeof prefs.chatHue === "number" && isFinite(prefs.chatHue)) {
                        chatHue = Math.min(360, Math.max(0, Math.round(prefs.chatHue)));
                    }
                    if (
                        prefs.chatBgStyle === "wallpaper" ||
                        prefs.chatBgStyle === "solid" ||
                        prefs.chatBgStyle === "dots" ||
                        prefs.chatBgStyle === "glow"
                    ) {
                        chatBg = prefs.chatBgStyle;
                    } else if (prefs.chatWallpaperEnabled === false) {
                        chatBg = "solid";
                    }
                    if (prefs.chatDensity === "compact") {
                        chatDensity = "compact";
                    }
                    if (prefs.chatFontSize === "sm" || prefs.chatFontSize === "lg") {
                        chatFontSize = prefs.chatFontSize;
                    }
                    if (prefs.selectedWallpapers && typeof prefs.selectedWallpapers === "object") {
                        ["left", "center", "right", "input"].forEach(function (slot) {
                            var candidate = prefs.selectedWallpapers[slot];
                            if (candidate === "") {
                                selectedMap[slot] = "";
                            } else if (typeof candidate === "string" && wpItems.some(function (i) { return i.id === candidate && i.slot === slot; })) {
                                selectedMap[slot] = candidate;
                            }
                        });
                    }
                    if (isChatDevEnv && prefs.devItemTransforms && typeof prefs.devItemTransforms === "object") {
                        devOverrides = prefs.devItemTransforms;
                    }
                }
                root.removeAttribute("data-chat-scheme");
                root.removeAttribute("data-chat-wallpaper");
                root.style.removeProperty("--chat-bg-dim");
                root.style.removeProperty("--chat-bg-blur");
                root.style.removeProperty("--chat-bg-opacity");
                root.setAttribute("data-chat-bg", chatBg);
                root.setAttribute("data-chat-density", chatDensity);
                root.setAttribute("data-chat-font-size", chatFontSize);
                root.setAttribute("data-chat-custom-hue", "true");
                ["left", "center", "right", "input"].forEach(function (slot) {
                    var itemId = selectedMap[slot] || "";
                    var baseItem = wpItems.find(function (i) { return i.id === itemId && i.slot === slot; }) || null;
                    var override = isChatDevEnv && devOverrides ? (devOverrides[itemId] || null) : null;
                    var src = override || baseItem;
                    var mode = src && (src.mode === "sticker" || src.fit === "contain") ? "sticker" : "wallpaper";
                    var fit = src && (src.fit === "contain" || src.fit === "cover") ? src.fit : (mode === "sticker" ? "contain" : "cover");
                    var opacity = src && typeof src.opacity === "number" && isFinite(src.opacity)
                        ? Math.min(1, Math.max(0.05, src.opacity))
                        : 0.2;
                    var scale = src && typeof src.scale === "number" && isFinite(src.scale)
                        ? Math.min(3.5, Math.max(0.15, src.scale))
                        : 1;
                    var offsetX = src && typeof src.offsetX === "number" && isFinite(src.offsetX)
                        ? Math.min(200, Math.max(-200, Math.round(src.offsetX)))
                        : 0;
                    var offsetY = src && typeof src.offsetY === "number" && isFinite(src.offsetY)
                        ? Math.min(200, Math.max(-200, Math.round(src.offsetY)))
                        : 0;
                    var blurEnabled = src && typeof src.blurEnabled === "boolean" ? src.blurEnabled : false;
                    var blur = src && typeof src.blur === "number" && isFinite(src.blur)
                        ? Math.min(30, Math.max(0, src.blur))
                        : 0;
                    root.setAttribute("data-chat-bg-" + slot + "-mode", mode);
                    root.setAttribute("data-chat-bg-" + slot + "-fit", fit);
                    root.style.setProperty("--chat-bg-" + slot + "-fit", fit);
                    root.style.setProperty("--chat-bg-" + slot + "-opacity", String(opacity));
                    root.style.setProperty("--chat-bg-" + slot + "-scale", String(scale));
                    root.style.setProperty("--chat-bg-" + slot + "-x", offsetX + "%");
                    root.style.setProperty("--chat-bg-" + slot + "-y", offsetY + "%");
                    root.style.setProperty("--chat-bg-" + slot + "-blur", (blurEnabled ? blur : 0) + "px");
                });
                root.style.setProperty("--chat-hue", String(chatHue));
                root.style.setProperty("--hue", String(chatHue));
            } catch (_) {}
        })();
    </script>

    <div id="chat-page" class="chat-page-container">
        <ChatApp
            client:load
            chatServerUrl={chatConfig.serverURL}
            walineServerUrl={walineServerUrl}
            playlistOutApiUrl={chatConfig.playlistOutApiURL || "https://playlistout-api.lengxiqwq.com"}
            rooms={chatConfig.rooms}
            enableImageUpload={chatConfig.enableImageUpload}
            stickerPackUrls={stickerPackUrls}
            musicTracks={musicTracks}
            initialMusicVolume={initialVolume}
            interconnectSites={chatConfig.interconnectSites ?? []}
            siteAvatar={profileConfig.avatar}
        />
    </div>
</MainGridLayout>
