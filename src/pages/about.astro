---

import { getEntry, render } from "astro:content";
import Markdown from "@components/common/Markdown.astro";
import { Icon } from "astro-icon/components";
import { profileConfig } from "@/config/profileConfig";
import { siteConfig } from "@/config/siteConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getAuthorAvatarUrl } from "@/utils/schema-image";
import { buildProfilePage } from "@/utils/schema-utils";

const aboutPost = await getEntry("spec", "about");

if (!aboutPost) {
	throw new Error("About page content not found");
}

const { Content } = await render(aboutPost);

const avatarUrl = await getAuthorAvatarUrl();
const jsonLd = buildProfilePage({
	site: siteConfig.site_url,
	profileConfig,
	authorUrl: Astro.url.toString(),
	avatarUrl,
	description: profileConfig.bio,
});
---
<MainGridLayout title={i18n(I18nKey.about)} description={i18n(I18nKey.about)}>
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full ">
            <Markdown class="mt-2">
                <Content />
            </Markdown>

            <!-- 站点衍生信息快速通道：统计与日志 -->
            <div class="mt-8 pt-6 border-t border-(--line-divider) space-y-3">
                <!-- 站点统计大屏快速通道 -->
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 p-4 rounded-2xl bg-black/2 dark:bg-white/2 border border-(--line-divider) hover:border-(--primary)/40 transition-all">
                    <div class="flex items-center gap-3.5">
                        <div class="w-10 h-10 rounded-xl bg-(--primary)/15 text-(--primary) flex items-center justify-center text-xl shrink-0">
                            <Icon name="material-symbols:leaderboard-rounded" class="text-xl" />
                        </div>
                        <div>
                            <div class="text-sm font-bold text-neutral-800 dark:text-neutral-100 flex items-center gap-2">
                                站点统计与公开遥测
                                <span class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 font-medium">实时公开</span>
                            </div>
                            <p class="text-xs text-(--content-meta) mt-0.5">
                                探索全站 PV/UV 访问脉冲、52周创作节奏与读者互动大屏
                            </p>
                        </div>
                    </div>
                    <a
                        href="/stats/"
                        class="px-4 py-2 rounded-xl bg-(--primary) text-white text-xs font-semibold hover:opacity-90 active:scale-95 transition-all shrink-0 flex items-center gap-1.5 shadow-sm self-end sm:self-center"
                    >
                        <span>查看统计大屏</span>
                        <span>→</span>
                    </a>
                </div>

                <!-- 博客日志时间线快速通道 -->
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 p-4 rounded-2xl bg-black/2 dark:bg-white/2 border border-(--line-divider) hover:border-(--primary)/40 transition-all">
                    <div class="flex items-center gap-3.5">
                        <div class="w-10 h-10 rounded-xl bg-(--primary)/15 text-(--primary) flex items-center justify-center text-xl shrink-0">
                            <Icon name="material-symbols:history-edu-rounded" class="text-xl" />
                        </div>
                        <div>
                            <div class="text-sm font-bold text-neutral-800 dark:text-neutral-100 flex items-center gap-2">
                                博客日志与更新历程
                                <span class="text-[10px] px-2 py-0.5 rounded-full bg-(--primary)/15 text-(--primary) font-medium">持续演进</span>
                            </div>
                            <p class="text-xs text-(--content-meta) mt-0.5">
                                翻阅博客从零搭建、架构演进、功能上线与日常维护的代码提交印记
                            </p>
                        </div>
                    </div>
                    <a
                        href="/changelog/"
                        class="px-4 py-2 rounded-xl bg-(--primary) text-white text-xs font-semibold hover:opacity-90 active:scale-95 transition-all shrink-0 flex items-center gap-1.5 shadow-sm self-end sm:self-center"
                    >
                        <span>查看博客日志</span>
                        <span>→</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</MainGridLayout>